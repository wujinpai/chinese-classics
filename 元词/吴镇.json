{"dynasty": "元", "author": "吴镇", "author_desc": "", "works": [{"title": "沁园春 题画骷髅", "paragraphs": ["漏泄元阳，爷娘搬贩，至今未休。", "吐百种乡音，千般扭扮，一生人我，几许机谋。", "有限光阴，无穷活计，汲汲忙忙作马牛。", "何时了，觉来枕上，试听更筹。", "古今多少风流。", "想蝇利蜗名谁到头。", "看昨日他非，今朝我是。", "三回拜相，两度封侯。", "采菊篱边，种瓜园内，都只到邙山土一邱。", "惺惺汉，皮囊扯破，便是骷髅。"], "annotations": []}, {"title": "渔父", "paragraphs": ["舴艋为舟力几多。", "江头云雨半相和。", "殷勤好，下长波。", "半夜潮生不那何。"], "annotations": []}, {"title": "渔父", "paragraphs": ["钓得鲜鳞拽水开。", "绿萍漾漾逐钩来。", "摇赪尾，𪡋红腮。", "不羡严陵坐钓台。"], "annotations": []}, {"title": "渔父", "paragraphs": ["如何小小作丝纶。", "只向湖中养一身。", "任公子，尔何人。", "枉钓如山截海鳞。"], "annotations": []}, {"title": "渔父", "paragraphs": ["绿杨湾里夕阳微。", "万里霞光浸落晖。", "击楫去，未能归。", "惊起沙鸥扑鹿飞。"], "annotations": []}, {"title": "渔父", "paragraphs": ["残霞返照四山明。", "云起云收阴复晴。", "风脚动，浪头生。", "听取虚篷夜雨声。"], "annotations": []}, {"title": "渔父", "paragraphs": ["舴艋舟人无姓名。", "葫芦提酒乐平生。", "香稻饭，滑莼羹。", "掉月穿云任性情。"], "annotations": []}, {"title": "渔父", "paragraphs": ["重整丝纶欲掉船。", "江头新月正明圆。", "酒瓶倒，岸花悬。", "抛却渔竿和月眠。"], "annotations": []}, {"title": "渔父", "paragraphs": ["极浦遥看两岸斜。", "碧波微影弄晴霞。", "孤舟小，去无涯。", "那个汀洲不是家。"], "annotations": []}, {"title": "渔父", "paragraphs": ["目断烟波青有无。", "霜凋枫叶锦模糊。", "千尺浪，四腮鲈。", "诗筒相对酒胡芦。"], "annotations": []}, {"title": "渔父", "paragraphs": ["五岭风光绝四邻。", "满川凫雁是交亲。", "云触岸，浪摇身。", "青草烟深不见人。"], "annotations": []}, {"title": "渔父", "paragraphs": ["桃花波起五湖春。", "一叶随风万里身。", "钓丝细，香饵匀。", "元来不是取鱼人。"], "annotations": []}, {"title": "渔父", "paragraphs": ["雪色髭须一老翁。", "欲将短棹拨长空。", "微有雨，正无风。", "宜在五湖烟水中。"], "annotations": []}, {"title": "渔父", "paragraphs": ["风搅长江浪搅风。", "鱼龙混亲一川中。", "藏深浦，系长松。", "直待云收月在空。"], "annotations": []}, {"title": "渔父", "paragraphs": ["无端垂钓空潭心。", "鱼大船轻力不任。", "忧倾倒，系浮沉。", "事事从轻不要深。"], "annotations": []}, {"title": "渔父", "paragraphs": ["残阳浦里漾渔船。", "青草湖中欲暮天。", "看白鸟，下平川。", "点破潇湘万里烟。"], "annotations": []}, {"title": "渔父", "paragraphs": ["月移山影照渔船。", "船载山行月在前。", "山突兀，月婵娟。", "一曲渔歌山月边。"], "annotations": []}, {"title": "渔父 临荆浩渔父图十六首", "paragraphs": ["洞庭湖上晚风生。", "风触湖心一叶横。", "兰棹稳，草衣轻。", "只钓鲈鱼不钓名。"], "annotations": []}]}