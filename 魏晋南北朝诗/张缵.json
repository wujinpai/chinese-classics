{"dynasty": "南北朝", "author": "张缵", "author_desc": "", "works": [{"title": "大言应令诗", "paragraphs": ["河流既竭，日月俱腾。", "罝罗微物，动落云鹏。"], "annotations": []}, {"title": "细言应令诗", "paragraphs": ["遨游蚁目辨轻尘。", "蚊睫成宇虱如轮。"], "annotations": []}, {"title": "侍宴饯东阳太守萧子云应令诗", "paragraphs": ["仲月发初阳，轻寒带春序。", "渌池解馀冻，丹霞霁新雨。", "良守谒承明，徂舟戒兰渚。", "皇储惜将迈，金樽留宴醑。"], "annotations": []}]}