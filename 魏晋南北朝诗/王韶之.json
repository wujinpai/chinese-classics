{"dynasty": "南北朝", "author": "王韶之", "author_desc": "", "works": [{"title": "赠潘综吴逵举孝廉诗", "paragraphs": ["东宝惟金，南木有乔。", "发辉曾崖，竦干重霄。", "美哉兹土，世载英髦。", "育翮幽林，养音九皋。", "唐后明扬，汉宗蒲轮。", "我皇降鉴，思乐怀人。", "群臣竞荐，旧章惟新。", "余亦奚贡，曰义与仁。", "仁义伊在，惟吴惟潘。", "心积纯孝，事著艰难。", "投死如归，淑问若兰。", "吴实履仁，心力偕单。", "固此苦节，易彼岁寒。", "霜寻虽厚，松柏丸丸。", "人亦有言，无善不彰。", "二子徽猷，弥久弥芳。", "拔丛出类，景行朝阳。", "谁谓道遐，弘之则光。", "咨尔庶士，无然怠荒。", "江革奉挚，庆禄是荷。", "姜诗入贡，汉朝咨嗟。", "勖哉行人，敬尔休嘉。", "俾是下国，炤辉京华。", "伊余朽骀，窃服惧盗。", "无能礼乐，岂暇声教。", "顺彼康夷，懿德是好。", "聊缀所怀，以赠二孝。"], "annotations": []}, {"title": "咏雪离合诗", "paragraphs": ["霰先集兮雪乃零，散辉素兮被檐庭。", "曲室寒兮朔风厉，州陆涸兮群籁鸣。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其一 肆夏乐歌", "paragraphs": ["于铄我皇，体仁包元。", "齐明日月，比量乾坤。", "陶甄百王，稽则黄轩。", "吁谟定命，辰告四蕃。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其二", "paragraphs": ["将将蕃后，翼翼群僚。", "盛服待晨，明发来朝。", "飨以八珍，乐发九韶。", "仰祗天颜，厥猷孔昭。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其三", "paragraphs": ["法章既设，初筵长舒。", "济济列辟，端委皇除。", "饮和无盈，威仪有馀。", "温恭在位，敬终如初。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其四", "paragraphs": ["九功既歌，六代惟时。", "被德在乐，宣道以诗。", "穆矣大和，品物咸熙。", "庆积自远，告成在兹。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其五 大会行礼歌", "paragraphs": ["大哉皇宋，长发其祥。", "纂系在汉，统源伊唐。", "德之克明，休有烈光。", "配天作极，辰居四方。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其六", "paragraphs": ["皇矣我后，圣德通灵。", "有命自天，诞受休祯。", "龙飞紫极，造我宋京。", "光宅宇宙，赫赫明明。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其七 王公上寿歌", "paragraphs": ["献寿爵。", "庆圣皇。", "灵祚穷二仪。", "休明等三光。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其八 殿前登歌", "paragraphs": ["明明大宋，缉熙皇道。", "则天垂化，光定天保。", "天保既定，肆觐万方。", "礼繁乐富，穆穆皇皇。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其九", "paragraphs": ["沔彼流水，朝宗天池。", "洋洋贡职，抑抑威仪。", "既习威仪，亦闲礼容。", "一人有则，作孚万邦。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十", "paragraphs": ["烝哉我皇，固天诞圣。", "履端惟始，对越休庆。", "如天斯久，如日斯盛。", "介兹景福，永固骏命。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十一 食举歌", "paragraphs": ["晨羲载曜。", "万物咸睹。", "嘉庆三朝。", "礼乐备举。", "元正肇始。", "典章晖明。", "万方毕来贺。", "华裔充皇庭。", "多士盈九位。", "俯仰观玉声。", "恂恂俯仰。", "载烂其辉。", "鼓钟震天区。", "礼容塞皇闱。", "思乐穷休庆。", "福履同所归。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十二", "paragraphs": ["五玉既献。", "三帛是荐。", "尔公尔侯。", "鸣玉华殿。", "皇皇圣后。", "降礼南面。", "元首纳嘉礼。", "万邦同欢愿。", "休哉。", "君臣嘉燕。", "建五旗。", "列四县。", "乐有文。", "礼无倦。", "融皇风。", "穷一变。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十三", "paragraphs": ["体至和。", "感阴阳。", "德无不柔。", "繁休祥。", "瑞徽璧。", "应嘉钟。", "舞灵凤。", "跃潜龙。", "景星见。", "甘露坠。", "木连理。", "禾同穗。", "玄化洽。", "仁泽敷。", "极祯瑞。", "穷灵符。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十四", "paragraphs": ["怀荒裔。", "绥齐民。", "荷天佑。", "靡不宾。", "靡不宾。", "长世弘盛。", "昭明有融。", "繁嘉庆。", "繁嘉庆。", "熙帝载。", "合气咸和。", "苍生欣戴。", "三灵协瑞。", "惟新皇代。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十五", "paragraphs": ["王道四达。", "流仁布德。", "穷理咏乾元。", "垂训顺帝则。", "灵化侔四时。", "幽诚通玄默。", "德泽被八弦。", "干宁轨万国。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十六", "paragraphs": ["皇猷缉。", "咸熙泰。", "礼仪焕帝庭。", "要荒服遐外。", "被发袭缨冕。", "左衽回衿带。", "天覆地载。", "流泽汪濊。", "声教布护。", "德光大。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十七", "paragraphs": ["开元辰，毕来王。", "奉贡职，朝后皇。", "鸣珩佩，观典章。", "乐王度，悦徽芳。", "陶盛化，游太康。", "丕照明，永克昌。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十八", "paragraphs": ["惟永初，德丕显。", "齐七政，敷五典。", "彝伦序，洪化阐。", "王泽流，太平始。", "树声教，明皇纪。", "和灵只，恭明祀。", "衍景祚，膺嘉祉。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其十九", "paragraphs": ["礼有容，乐有仪。", "金石陈，干羽施。", "迈武护，均咸池。", "歌南风，舞德称。", "文武焕，颂声兴。"], "annotations": []}, {"title": "宋四厢乐歌廿首 其二十", "paragraphs": ["王道纯，德弥淑。", "宁八表，康九服。", "道礼让，移风俗。", "移风俗，永克融。", "歌盛美，造成功。", "咏徽烈，邈无穷。"], "annotations": []}, {"title": "宋前后舞歌二首 其一 前舞歌", "paragraphs": ["于赫景明，天监是临。", "乐来伊阳，礼作惟阴。", "歌自德富，舞由功深。", "庭列宫县，陛罗瑟琴。", "翿龠繁会，笙磬谐音。", "箫韶虽古，九成在今。", "导志和声，德音孔宣。", "光我帝基，协灵配干。", "仪刑六合，化穆自然。", "如彼云汉，为章于天。", "熙熙万类，陶和当年。", "击辕中韶，永世弗骞。"], "annotations": []}, {"title": "宋前后舞歌二首 其二 后舞歌", "paragraphs": ["假乐圣后，寔天诞德。", "积美自中，玉猷四塞。", "龙飞在天，仪刑万国。", "钦明惟神，临朝渊默。", "不言之化，品物咸德。", "告成于天，铭勋是勒。", "翼翼厥猷，亹亹其仁。", "顺命创制，因定和神。", "海外有截，九围无尘。", "冕旒司契，垂拱临民。", "乃舞大豫，钦若天人。", "纯嘏孔休，万载弥新。"], "annotations": []}]}