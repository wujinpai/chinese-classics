{"dynasty": "魏晋", "author": "牵秀", "author_desc": "", "works": [{"title": "宴曜武堂诗", "paragraphs": ["沐浴洪流，饮服清芳。", "将结微根，永晞朝阳。", "恭承渥惠，庶无怠荒。"], "annotations": []}, {"title": "祖孙楚诗", "paragraphs": ["受兹明命，作守西疆。"], "annotations": []}, {"title": "四言诗", "paragraphs": ["乾道辅仁，坤德尚冲。"], "annotations": []}, {"title": "诗", "paragraphs": ["高宗梦岩穴，姬文兆渭滨。", "群分邈十里，感应用形神。"], "annotations": []}]}