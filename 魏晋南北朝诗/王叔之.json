{"dynasty": "南北朝", "author": "王叔之", "author_desc": "", "works": [{"title": "游罗浮山诗", "paragraphs": ["庵霭灵岳，开景神封。", "绵界盘趾，中天举峰。", "孤楼侧挺，层岫回重。", "风云秀体，卉木媚容。"], "annotations": []}, {"title": "拟古诗", "paragraphs": ["客从北方来，言欲到交趾。", "远行无他货，惟有凤皇子。", "百金我不欲，千金难为市。", "谁知岩穴中，箫笙终夜起。"], "annotations": []}, {"title": "舟赞", "paragraphs": ["涂则骋车，水惟用舟。", "弱楫轻棹，利涉济求。", "缅彼渔人，鼓枻清讴。"], "annotations": []}, {"title": "兰菊铭", "paragraphs": ["兰既春敷，菊又秋荣。", "芳薰百草，色艳群英。", "孰是芳质，在幽愈馨。", "朝斯夕斯，愿言永贞。"], "annotations": []}, {"title": "甘橘赞", "paragraphs": ["节重履险，操贵有恒。", "一树保荣，四运齐能。", "在质惟美，于味斯弘。", "异分南域，北则枳橙。"], "annotations": []}]}