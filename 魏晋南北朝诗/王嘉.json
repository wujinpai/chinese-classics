{"dynasty": "魏晋", "author": "王嘉", "author_desc": "", "works": [{"title": "歌三首 其一", "paragraphs": ["金刀治世后遂苦。", "帝王昏乱天神怒。", "灾异屡见戒人主。", "三分二叛失州土。", "三王九江一在吴。", "馀悉稚小早少孤。", "一国二主天所驱。"], "annotations": []}, {"title": "歌三首 其二", "paragraphs": ["三禾椮椮林茂孳。", "金刀利刃齐刈之。"], "annotations": []}, {"title": "歌三首 其三", "paragraphs": ["欲知其姓草肃肃。", "谷中最累低头熟。", "鳞身甲体永兴福。"], "annotations": []}, {"title": "歌", "paragraphs": ["凤皇凤皇。", "何不高飞还故乡。", "无故在此取灭亡。"], "annotations": []}, {"title": "皇娥歌", "paragraphs": ["天清地旷浩茫茫。", "万象回薄化无方。", "浛天荡荡望沧沧。", "乘桴摇漾著日傍。", "当期何所至穷桑。", "心知和乐悦未央。"], "annotations": []}, {"title": "白帝子歌", "paragraphs": ["四维八埏?难极。", "驱光逐影穷水域。", "璇宫夜静当轩织。", "桐峰文梓千寻直。", "伐梓作器成琴瑟。", "清歌流畅乐难极。", "沧湄海浦来栖息。"], "annotations": []}, {"title": "采药诗", "paragraphs": ["暗河之桂，实大如枣。", "得而食之，后天而老。"], "annotations": []}, {"title": "时俗四言诗", "paragraphs": ["力勤十顷。", "能致嘉颖。"], "annotations": []}]}