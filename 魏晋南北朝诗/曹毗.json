{"dynasty": "魏晋", "author": "曹毗", "author_desc": "", "works": [{"title": "黄帝赞诗", "paragraphs": ["轩辕应玄期，幼能总百神。", "体练五灵妙，气含云露津。", "掺石曾城岫，铸鼎荆山滨。", "豁焉天扉开，飘然跨腾鳞。", "仪辔洒长风，褰裳蹑紫宸。"], "annotations": []}, {"title": "咏冬诗", "paragraphs": ["绵邈冬夕永，凛厉寒气升。", "离叶向晨落，长风振条兴。", "夜静轻响起，天清月晖澄。", "寒冰盈渠结，素霜竟栏凝。", "今载忽已暮，来纪奄复仍。"], "annotations": []}, {"title": "夜听捣衣诗", "paragraphs": ["寒兴御纨素，佳人理衣襟。", "冬夜清且永，皎月照堂阴。", "纤手叠轻素，朗桁叩鸣砧。", "清风流繁节，回飙洒微吟。", "嗟此往运速，悼彼幽滞心。", "二物感余怀，岂但声与音。"], "annotations": []}, {"title": "正朝诗", "paragraphs": ["灵春散初泽，棼煴青阳舒。", "佳袍忽已故，今载奄复初。", "软节畅宇宙，和风被八区。"], "annotations": []}, {"title": "霖雨诗", "paragraphs": ["洪霖弥旬日，翳翳四区昏。", "紫电光牖飞，迅雷终天奔。"], "annotations": []}, {"title": "郗公墓诗", "paragraphs": ["青松罗前隧，翠碑表高坟。", "玉颜无馀映，蕙风有馀薰。"], "annotations": []}, {"title": "箜篌诗", "paragraphs": ["东士君子，雅善箜篌。"], "annotations": []}, {"title": "诗", "paragraphs": ["分风为二，擘流为两。"], "annotations": []}, {"title": "军中诗", "paragraphs": ["挥戈辉白刃，??若寒霜。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其一 歌高祖宣皇帝", "paragraphs": ["于赫高祖，德协灵符。", "应运扰乱，厘整天衢。", "勋格宇宙，化动八区。", "肃以典刑，陶以玄珠。", "神石吐瑞，灵芝自敷。", "肇基天命，道均唐虞。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其二 歌世宗景皇帝", "paragraphs": ["景皇承运，纂隆洪绪。", "皇维重抗，天晖再举。", "蠢矣二寇，扰我扬楚。", "乃整元戎，以膏齐斧。", "亹亹神算，赫赫王旅。", "鲸鲵既平，功冠帝宇。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其三 歌太祖文皇帝", "paragraphs": ["太祖齐圣，王猷诞融。", "仁教四塞，天基累崇。", "皇室多难，严清紫宫。", "威厉秋霜，惠过春风。", "平蜀夷楚，以文以戎。", "奄有参墟，声流无穷。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其四 歌世祖武皇帝", "paragraphs": ["于穆武皇，允龚钦明。", "应期登禅，龙飞紫庭。", "百揆时序，听断以情。", "殊域既宾，伪吴亦平。", "晨流甘露，宵映朗星。", "野有击壤，路垂颂声。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其五 歌中宗元皇帝", "paragraphs": ["运屯百六，天罗解贯。", "元皇勃兴，网罗江汉。", "仰齐七政，俯平祸乱。", "化若风行，泽犹雨散。", "沦光更耀，金辉复焕。", "德冠千载，蔚有馀粲。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其六 歌肃宗明皇帝", "paragraphs": ["明明肃祖，阐弘帝祚。", "英风夙发，清晖载路。", "奸逆纵忒，罔式皇度。", "躬振朱旗，遂豁天步。", "宏猷渊塞，高罗云布。", "品物咸宁，洪基永固。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其七 歌显宗成皇帝", "paragraphs": ["于休显宗，道泽玄播。", "式宣德音，畅物以和。", "迈德蹈仁，匪礼弗过。", "敷以纯风，濯以清波。", "连理映阜，鸣凤栖柯。", "同规放勋，义盖山河。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其八 歌康皇帝", "paragraphs": ["康皇穆穆，仰嗣洪德。", "为而不宰，雅音四塞。", "闲邪以诚，镇物以默。", "威静区宇，道宣邦国。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其九 歌孝宗穆皇帝", "paragraphs": ["孝宗夙哲，休音允臧。", "如彼晨离，曜景扶桑。", "垂训华幄，流润八荒。", "幽赞玄妙，爰该典章。", "西平僣蜀，北静旧疆。", "高猷远畅，朝有遗芳。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其十 歌哀皇帝", "paragraphs": ["于穆哀皇，圣心虚远。", "雅好玄古，大庭是践。", "道尚无为，治存易简。", "化若风行，民犹草偃。", "虽曰登遐，徽音弥阐。", "愔愔云韶，尽美尽善。"], "annotations": []}, {"title": "晋江左宗庙歌十一首 其十一 四时祠祀歌", "paragraphs": ["肃肃清庙。", "巍巍圣功。", "万国来宾。", "礼仪有容。", "钟鼓振。", "金石熙。", "宣兆祚。", "武开基。", "神斯乐兮。", "理管弦。", "有来斯和。", "说功德。", "神斯乐兮。", "洋洋玄化。", "润被九壤。", "民无不悦。", "道无不往。", "礼有仪。", "乐有式。", "咏九功。", "永无极。", "神斯乐兮。"], "annotations": []}, {"title": "杜兰香作诗", "paragraphs": ["阿母处灵岳，时游云霄际。", "众女侍羽仪，不出墉宫外。", "飙轮送我来，岂复耻尘秽。", "从我与福俱，嫌我与祸会。"], "annotations": []}, {"title": "复作诗", "paragraphs": ["逍遥云雾间，呼吸发九嶷。", "游女不稽路，弱水何不之。"], "annotations": []}]}