{"dynasty": "魏晋", "author": "袁峤之", "author_desc": "", "works": [{"title": "兰亭诗二首 其一", "paragraphs": ["人亦有言，得意则欢。", "佳宾既臻，相与游盘。", "微音迭咏，馥焉若兰。", "苟齐一致，遐想揭竿。"], "annotations": []}, {"title": "兰亭诗二首 其二", "paragraphs": ["四眺华林茂，俯仰晴川涣。", "激水流芳醪，豁尔累心散。", "遐想逸民轨，遗音良可玩。", "古人咏舞雩，今也同斯叹。"], "annotations": []}]}