{"dynasty": "魏晋", "author": "桓玄", "author_desc": "", "works": [{"title": "登荆山诗", "paragraphs": ["理不孤湛，影比有津。", "曾是名岳，明秀超邻。", "器栖荒外，命契飨神。", "我之怀矣，巾驾悄轮。"], "annotations": []}, {"title": "南林弹诗", "paragraphs": ["散带蹑良驷，挥弹出长林。", "归翮赴旧栖，乔木转翔禽。", "轻丸承条源，纤缴截云寻。", "落羽寻绝响，屡中转应心。"], "annotations": []}, {"title": "诗", "paragraphs": ["鸣鹤响长阜。"], "annotations": []}]}