{"dynasty": "南北朝", "author": "颜峻", "author_desc": "", "works": [{"title": "皇后庙登歌", "paragraphs": ["载我圣文，奄有四海。", "外刑家邦，内贻女则。"], "annotations": []}, {"title": "七庙迎神辞", "paragraphs": ["敬恭明祀，孝道感通。", "合乐维和，展礼有容。", "六舞肃列，九变成终。", "神之来思，享兹洁衷。", "灵之往矣，绥我家邦。"], "annotations": []}, {"title": "淫思古意诗", "paragraphs": ["春风飞远方，纪转流思堂。", "贞节寄君子，穷闺妾所藏。", "裁书露微疑，千里问新知。", "君行过三稔，故心久当移。"], "annotations": []}, {"title": "捣衣诗", "paragraphs": ["逶迤失荣荄。", "旅燕又穴飞。"], "annotations": []}]}