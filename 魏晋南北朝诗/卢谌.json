{"dynasty": "魏晋", "author": "卢谌", "author_desc": "", "works": [{"title": "时兴诗", "paragraphs": ["亹亹圆象运，悠悠方仪廓。", "忽忽岁云暮，游原采萧藿。", "北逾芒与河，南临伊与洛。", "凝霜沾蔓草，悲风振林薄。", "摵摵芳叶零，橤橤苍华落。", "下泉激冽清，旷野增辽索。", "登高眺遐荒，极望无崖崿。", "形变随时化，神感因物作。", "澹乎至人心，恬然存玄漠。"], "annotations": []}, {"title": "诗", "paragraphs": ["遐举游名山，松乔共相追。", "层崖成崇馆，岩阿结重围。"], "annotations": []}, {"title": "诗", "paragraphs": ["凛凛素秋，日促宵长。"], "annotations": []}, {"title": "览古诗", "paragraphs": ["赵氏有和璧，天下无不传。", "秦人来求市，厥价徒空言。", "与之将见卖，不与恐致患。", "简才备行李，图令国命全。", "蔺生在下位，缪子称其贤。", "奉辞驰出境，伏轼径入关。", "秦王御殿坐，赵使拥节前。", "挥袂睨金柱，身玉要俱捐。", "连城既伪往，荆玉亦真还。", "爰在渑池会，二主克交欢。", "昭襄欲负力，相如折其端。", "眦血下沾襟，怒发上冲冠。", "西缶终双击，东瑟不只弹。", "舍生岂不易，处死诚独难。", "棱威章台颠，强御亦不干。", "屈节邯郸中，俯首忍回轩。", "廉公何为者，负荆谢厥愆。", "智勇盖当世，弛张使我叹。"], "annotations": []}, {"title": "重赠刘琨诗", "paragraphs": ["璧由识者显，龙因庆云翔。", "茨棘非所憩，翰飞游高冈。", "余音非九韶，何以仪凤凰。", "新城非芝圃，曷由殖兰芳。"], "annotations": []}, {"title": "答刘琨诗 其一", "paragraphs": ["随宝产汉滨，摛此夜光真。", "不待卞和显，自为命世珍。"], "annotations": []}, {"title": "答刘琨诗 其二", "paragraphs": ["谁言日向暮，桑榆犹启晨。", "谁言繁菜实，振藻耀芳春。", "百炼或致屈，绕指所以伸。"], "annotations": []}, {"title": "答魏子悌诗", "paragraphs": ["崇台非一?，珍裘非一腋。", "多士成大业，群贤济弘绩。", "遇蒙时来会，聊齐朝彦迹。", "顾此腹背羽，愧彼排虚翮。", "寄身荫四岳，托好凭三益。", "倾盖虽终朝，大分迈畴昔。", "在危每同险，处安不异易。", "俱涉晋昌艰，共更飞狐厄。", "恩由契阔生，义随周旋积。", "岂谓乡曲誉，谬充本州役。", "乖离令我感，悲欣使情惕。", "理以精神通，匪曰形骸隔。", "妙诗申笃好，清义贯幽赜。", "恨无随侯珠，以酬荆文璧。"], "annotations": []}, {"title": "赠刘琨诗 其一", "paragraphs": ["浚哲惟皇，绍熙有晋。", "振厥弛维，光阐远韵。", "有来斯雍，至止伊顺。", "三台摛朗，四岳增峻。"], "annotations": []}, {"title": "赠刘琨诗二十首 其二", "paragraphs": ["伊陟佐商，山甫翼周。", "弘济艰难，对扬王休。", "苟非异德，旷世同流。", "加其忠贞，宣其徽猷。"], "annotations": []}, {"title": "赠刘琨诗 其二", "paragraphs": ["伊谌陋宗，昔遘嘉惠。", "申以婚姻，著以累世。", "义等休戚，好同兴废。", "孰云匪谐，如乐之契。"], "annotations": []}, {"title": "赠刘琨诗 其三", "paragraphs": ["王室丧师，私门播迁。", "望公归之，视险忽艰。", "兹愿不遂，中路阻颠。", "仰悲先意，俯思身愆。"], "annotations": []}, {"title": "赠刘琨诗 其四", "paragraphs": ["大钧载运，良辰遂往。", "譬彼日月，迅过俯仰。", "感今惟昔，口存心想。", "借曰如昨，忽为畴曩。"], "annotations": []}, {"title": "赠刘琨诗 其五", "paragraphs": ["畴曩伊何，逝者弥疏。", "温温恭人，慎终如初。", "览彼遗音，恤此穷孤。", "譬彼樛木，蔓葛以敷。"], "annotations": []}, {"title": "赠刘琨诗 其六", "paragraphs": ["妙哉蔓葛，得托樛木。", "叶不云布，华不星烛。", "承侔卞和，质非荆璞。", "眷同尤良，用乏骥𫘧。"], "annotations": []}, {"title": "赠刘琨诗 其七", "paragraphs": ["承亦既笃，眷亦既亲。", "饰奖驽猥，方驾骏珍。", "弼谐靡成，良谟莫陈。", "无觊狐赵，有与五臣。"], "annotations": []}, {"title": "赠刘琨诗 其八", "paragraphs": ["五臣奚与，契阔百罹。", "身经险阻，足蹈幽遐。", "义由恩深，分随昵加。", "绸缪委心，自同匪他。"], "annotations": []}, {"title": "赠刘琨诗 其九", "paragraphs": ["昔在暇日，妙寻通理。", "尤彼意气，狭是节士。", "情以体生，感以情起。", "趣舍同要，穷达斯已。"], "annotations": []}, {"title": "赠刘琨诗 其十", "paragraphs": ["由余片言，秦人是惮。", "日䃅效忠，飞声有汉。", "桓桓抚军，古贤作冠。", "来牧幽都，济厥涂炭。"], "annotations": []}, {"title": "赠刘琨诗 其十一", "paragraphs": ["涂炭既济，寇挫民阜。", "谬其疲隶，授之朝右。", "上惧任大，下欣施厚。", "实祗高明，敢忘所守。"], "annotations": []}, {"title": "赠刘琨诗 其十二", "paragraphs": ["相彼反哺，尚在翔禽。", "孰是人斯，而忍斯心。", "每凭山海，庶觌高深。", "遐眺存亡，缅成飞沈。"], "annotations": []}, {"title": "赠刘琨诗 其十三", "paragraphs": ["长徽已缨，逝将徙举。", "收迹西践，衔哀东顾。", "曷云涂辽，曾不咫步。", "岂不夙夜，谓行多露。"], "annotations": []}, {"title": "赠刘琨诗 其十四", "paragraphs": ["绵绵女萝，施于松标。", "禀泽洪干，晞阳丰条。", "根浅难固，茎弱易凋。", "操彼纤质，承此冲飙。"], "annotations": []}, {"title": "赠刘琨诗 其十五", "paragraphs": ["纤质实微，冲飙斯值。", "谁谓言精，致在赏意。", "不见得鱼，亦忘厥饵。", "遗其形骸，寄之深识。"], "annotations": []}, {"title": "赠刘琨诗 其十六", "paragraphs": ["先民颐意，潜山隐几。", "仰熙丹崖，俯澡绿水。", "无求于和，自附众美。", "慷慨遐踪，有愧高旨。"], "annotations": []}, {"title": "赠刘琨诗 其十七", "paragraphs": ["爰造异论，肝胆楚越。", "惟同大观，万涂一辙。", "死生既齐，荣辱奚别。", "处其玄根，廓焉靡结。"], "annotations": []}, {"title": "赠刘琨诗 其十八", "paragraphs": ["福为祸始，祸作福阶。", "天地盈虚，寒暑周回。", "夫差不祀，衅在胜齐。", "句践作伯，祚自会稽。"], "annotations": []}, {"title": "赠刘琨诗 其十九", "paragraphs": ["邈矣达度，唯道是杖。", "形有未泰，神无不畅。", "如川之流，如渊之量。", "上弘栋隆，下塞民望。"], "annotations": []}, {"title": "赠崔温诗", "paragraphs": ["逍遥步城隅，暇日聊游豫。", "北眺沙漠垂，南望旧京路。", "平陆引长流，冈峦挺茂树。", "中原厉迅飙，山阿起云雾。", "游子恒悲怀，举目增永慕。", "良俦不获偕，舒情将焉诉。", "远念贤士风，遂存往古务。", "朔鄙多侠气，岂唯地所固。", "李牧镇边城，荒夷怀南惧。", "赵奢正疆场，秦人折北虑。", "羁旅及宽政，委质与时遇。", "恨以驽蹇姿，徒烦非子御。", "亦既弛负担，忝位宰黔庶。", "苟云免罪戾，何暇收民誉。", "倪宽以殿黜，终乃最众赋。", "何武不赫赫，遗爱常在去。", "古人非所希，短弱自有素。", "何以敷斯辞，惟以二子故。"], "annotations": []}, {"title": "诗", "paragraphs": ["山居是所乐，世路非我欲。"], "annotations": []}]}