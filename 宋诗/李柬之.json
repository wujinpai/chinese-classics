{"dynasty": "宋", "author": "李柬之", "author_desc": "", "works": [{"title": "送程给事知越州", "paragraphs": ["文行学曾颜，才名孰可攀。", "仁风清郡国，和气满江山。", "暂抑提雄漕，行当簉近班。", "须知揽辔暇，大智养闲闲。"], "annotations": []}, {"title": "句 其一", "paragraphs": ["莫教独欠赤松游。"], "annotations": []}, {"title": "句 其二", "paragraphs": ["下客抛官独自回。"], "annotations": []}, {"title": "句", "paragraphs": ["莫教独欠赤松游。", "下客抛官独自回。"], "annotations": []}]}