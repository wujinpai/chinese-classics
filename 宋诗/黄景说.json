{"dynasty": "宋", "author": "黄景说", "author_desc": "", "works": [{"title": "雪 其二", "paragraphs": ["瑶林中有翳桑儿，鼎贵生涯不救饥。", "愿缩天人散花手，放渠奔走趁晨炊。"], "annotations": []}, {"title": "雪 其一", "paragraphs": ["说道羞明却不羞，日光玉洁共飞浮。", "天人胸次明如洗，肯似人间只暗投。"], "annotations": []}, {"title": "古风贺周益公休致", "paragraphs": ["相公能辞一品官，不能辞他九转丹。", "相公能却万钟粟，不能却他长生箓。", "潭潭之居移气体，新年七十儿童似。", "朝明见客步如飞，窗下时时看细字。", "高车得似垂车荣，巍冠何如挂冠清。", "深衣独乐真天人，谁其友之聃与彭。"], "annotations": []}, {"title": "诗一首", "paragraphs": ["居乡如处子，居官如战士。", "处子常畏人，战士惟有死。", "儿曹书诸绅，勿谓平平耳。"], "annotations": []}, {"title": "梨岭遇雨", "paragraphs": ["黑风吹雨又黄昏，鸡犬数声何处村。", "身在岭云飞处湿，不关别泪溅成痕。"], "annotations": []}, {"title": "句 其四", "paragraphs": ["孤标只合在孤山。"], "annotations": []}, {"title": "句 其三", "paragraphs": ["谁与诗人管醉魂。"], "annotations": []}, {"title": "句 其二", "paragraphs": ["侬是水仙鸿雁行。"], "annotations": []}, {"title": "句 其一", "paragraphs": ["一落风尘即厚颜。"], "annotations": []}, {"title": "句 其五", "paragraphs": ["清杀玉川文字肠。"], "annotations": []}, {"title": "句 其八", "paragraphs": ["落日天寒客自愁。"], "annotations": []}, {"title": "句 其十", "paragraphs": ["万木逢霜一劫灰。"], "annotations": []}, {"title": "句 其六", "paragraphs": ["临风长作南枝想。"], "annotations": []}, {"title": "句 其七", "paragraphs": ["一身尽著雪衣裳。"], "annotations": []}, {"title": "句 其九", "paragraphs": ["政尔玉壶相俎豆。"], "annotations": []}, {"title": "句 其十一", "paragraphs": ["肯随桃李斗梳妆。"], "annotations": []}, {"title": "句", "paragraphs": ["一落风尘即厚颜。", "侬是水仙鸿雁行。", "谁与诗人管醉魂。", "孤标只合在孤山。", "清杀玉川文字肠。", "临风长作南枝想。", "一身尽著雪衣裳。", "落日天寒客自愁。", "政尔玉壶相俎豆。", "万木逢霜一劫灰。", "肯随桃李斗梳妆。"], "annotations": []}]}