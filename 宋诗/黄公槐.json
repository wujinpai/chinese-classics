{"dynasty": "宋", "author": "黄公槐", "author_desc": "", "works": [{"title": "北堂 其一", "paragraphs": ["瞻彼北堂，在彼永阳。", "白云之下，通化之乡。"], "annotations": []}, {"title": "北堂 其三", "paragraphs": ["北堂有子，其实三兮。", "仲焉此去，其心惨兮。"], "annotations": []}, {"title": "北堂 其二", "paragraphs": ["瞻彼北堂，在彼永水。", "白云之下，新丰之里。"], "annotations": []}, {"title": "北堂", "paragraphs": ["瞻彼北堂，在彼永阳。", "白云之下，通化之乡。", "瞻彼北堂，在彼永水。", "白云之下，新丰之里。", "北堂有子，其实三兮。", "仲焉此去，其心惨兮。"], "annotations": []}]}