{"dynasty": "宋", "author": "释真慈", "author_desc": "", "works": [{"title": "颂尘尘三昧", "paragraphs": ["钵里饭，桶里水，别宝昆仑坐潭底。", "一尘尘上走须弥，明眼波斯笑弹指。", "笑弹指，珊瑚枝上清风起。"], "annotations": []}, {"title": "听讲圆觉经有省作颂", "paragraphs": ["一颗明珠，在我这里。", "拨著动著，放光动地。"], "annotations": []}, {"title": "颂", "paragraphs": ["拨尘见佛，佛亦是尘。", "问了答了，直下翻身。"], "annotations": []}]}