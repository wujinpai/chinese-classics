{"dynasty": "宋", "author": "赵构", "author_desc": "", "works": [{"title": "徐熙设色花鸟", "paragraphs": ["人言道院属江西，古一真人卧水湄。", "可是瑞莲花叶大，载他书册泛涟漪。"], "annotations": []}, {"title": "崇恩显义院 其四", "paragraphs": ["海神来过隐风回，浪打天门石壁开。", "浙江八月何如此，清似连山喷雪来。"], "annotations": []}, {"title": "崇恩显义院 其三", "paragraphs": ["管妙弦清韵入神，老人合眼醉醺醺。", "成知不及当来曲，犹觉闻时胜不闻。"], "annotations": []}, {"title": "崇恩显义院 其二", "paragraphs": ["松竹幽禽尺素间，恍然真向雪中看。", "动摇已自清风足，何况丹青写岁寒。"], "annotations": []}, {"title": "崇恩显义院 其一", "paragraphs": ["春莺叶底引圆吭，临罢黄庭日更长。", "满院柳花寒食后，旋钻新火𦶟炉香。"], "annotations": []}, {"title": "梅岩", "paragraphs": ["怪石苍岩影翠霞，梅梢疏瘦正横斜。", "得因祀事来寻胜，试探春风第一花。"], "annotations": []}, {"title": "虚堂", "paragraphs": ["虚堂燕坐悄无言，欲断残香冷自烟。", "秋色满山林桂静，一轮霜月泻寒泉。"], "annotations": []}, {"title": "赐僧守璋二首 其二", "paragraphs": ["久坐方知春昼长，静中心地自清凉。", "人言圆觉何曾觉，但见尘劳尽日忙。"], "annotations": []}, {"title": "题马远画册 其四", "paragraphs": ["不祷自安缘寿骨，人间难得是清名。", "浅斟仙酒红生颊，永保长生道自成。"], "annotations": []}, {"title": "题马远画册 其一", "paragraphs": ["桃李无言春告归，落红如海乱莺啼。", "西村渡口斜阳里，渺渺烟波绿拍堤。"], "annotations": []}, {"title": "题马麟画册", "paragraphs": ["已过谷雨十六日，犹见牡丹开浅红。", "曾不争先及开早，能陪芍药倒薰风。"], "annotations": []}, {"title": "题马麟亭台图卷", "paragraphs": ["后院深沉景物幽，奇花名卉弄春柔。", "翠华经岁无游幸，多少亭台废不修。"], "annotations": []}, {"title": "题丹桂画扇赐从臣 其一", "paragraphs": ["月宫移就日宫栽，引得轻红入面来。", "好向烟霄承雨露，丹心一一为君开。"], "annotations": []}, {"title": "题丹桂画扇赐从臣 其二", "paragraphs": ["秋入幽丛桂影团，香深粟粟照林丹。", "应随王母瑶池晓，染得朝霞下广寒。"], "annotations": []}, {"title": "题刘松年画团扇", "paragraphs": ["南山晴翠入波光，一派溪声绕路长。", "最爱早春沙岸煖，东风轻浪拍鸳鸯。"], "annotations": []}, {"title": "题画册花草四首 其二 修竹芙蓉", "paragraphs": ["寒花婀娜露凝香，风叶摇秋凤尾凉。", "梦入画堂银烛下，翠屏深处隐红妆。"], "annotations": []}, {"title": "题赵伯驹团扇月宫图册", "paragraphs": ["清凉境界火云藏，但觉仙家日更长。", "千岁寿松谁宴坐，星君午夜吐光芒。"], "annotations": []}, {"title": "题阎次平小景", "paragraphs": ["西来白水满南池，走马池边日暮时。", "桥底荷花无限思，清香乞与路人知。"], "annotations": []}, {"title": "题燕文贵柳庄观荷图", "paragraphs": ["万片绿荷流水西，乱风飘雨湿人衣。", "前村竹树田家密，时见軥辀屋后飞。"], "annotations": []}, {"title": "绍兴己巳南郊礼成", "paragraphs": ["清坛祗谒礼郊丘，辅相贤劳其款留。", "初讶密云低复冒，遽看霁景上飞浮。", "气回俎豆群工泰，喜入貔貅万马秋。", "赫赫天心允昭格，协谋同德赖嘉猷。"], "annotations": []}, {"title": "赐刘能真三首 其一", "paragraphs": ["简易高人道，崇玄性自真。", "身常居太极，心已远凡尘。", "玉陛辞荣禄，瑶台役鬼神。", "辛勤三十载，羡尔道心淳。"], "annotations": []}, {"title": "赐枢密院楼炤", "paragraphs": ["朕念邦家历万几，幸卿相与久维持。", "孜孜广道诹询处，蹇蹇封章纳诲时。", "半世奇勋惟我重，一生忠节自天知。", "南归奚事将为赠，金石诗篇壮羽仪。"], "annotations": []}, {"title": "题画册花草四首 其四 雪中山茶", "paragraphs": ["名出本南山，来依琼苑间。", "陈主歌前树，杨妃醉后颜。", "为嫌脂太赤，故著粉微斑。", "共言攀折处，已获宝枝还。"], "annotations": []}, {"title": "题画册花草四首 其三 墨竹", "paragraphs": ["墨花垂兔颖，千古尚漓漓。", "翠羽风前叶，秋声雨一枝。", "诗题春粉节，绷脱玉婴儿。", "湘浦人何在，空闻凤管吹。"], "annotations": []}, {"title": "中和堂", "paragraphs": ["六龙转淮海，万骑临吴津。", "王者本无外，驾言苏远民。", "瞻彼草木秀，感此疮痍新。", "登堂望稽山，怀哉夏禹勤。", "神功既盛大，后世蒙其仁。", "愿同越句践，焦思先吾身。", "艰难务遵养，圣贤有屈伸。", "高风动君子，属意种蠡臣。"], "annotations": []}, {"title": "赐刘能真三首 其三", "paragraphs": ["忆昔辰江阻飓风，于今神马又成龙。", "炎兴指日中原复，剩是茅君翊翼功。"], "annotations": []}, {"title": "赐刘能真三首 其二", "paragraphs": ["太白巃嵷东南驰，众岭环合青分披。", "烟云厚薄皆可爱，木石疏密自相宜。", "阳春已归鸟语乐，溪水不动鱼行迟。", "生民无不得处所，与兹鱼鸟皆熙熙。"], "annotations": []}, {"title": "题马远画册 其三", "paragraphs": ["月午江空桂花落，华阳道士云衣薄。", "石坛香散步虚声，杉露清泠滴栖鹤。"], "annotations": []}, {"title": "题画册花草四首 其一 蜡梅", "paragraphs": ["香蜜裁葩分外工，疏枝几点缀雏蜂。", "娇黄染就宫妆样，香煖尤宜爱日烘。"], "annotations": []}, {"title": "文宣王及其弟子赞 其九", "paragraphs": ["升堂惟光，千乘惟权。", "陵暴知非，委质可贤。", "折狱言简，结缨礼全。", "恶言不耳，仲尼赖焉。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十三", "paragraphs": ["纪伯子鲁，圣学是务。", "厉己斯的，好问乃裕。", "周旋中规，容止可度。", "允矣昔贤，后世所慕。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十三", "paragraphs": ["惟子挺生，道德之门。", "佩服至论，鲤则弟昆。", "三得三亡，所问殊温。", "君子归宓，义不掩恩。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十一", "paragraphs": ["君子若人，单父之政。", "引肘寤君，放鱼禀令。", "傅郭勿获，遂能制命。", "百代理邑，用规观听。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十三", "paragraphs": ["兄弟之邦，士有廉庸。", "涵泳素教，表揭儒宗。", "杏坛探赜，洙泗从容。", "作兴一时，莒父其封。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十四", "paragraphs": ["瑕丘祚邑，子期是为。", "亲训有日，广业于时。", "四教允隆，五常以持。", "比肩俊杰，闻望斯垂。"], "annotations": []}, {"title": "文宣王及其弟子赞 其七", "paragraphs": ["道义正己，文学擅科。", "为宰武城，联以弦歌。", "割鸡之试，牛刀谓何。", "前言戏尔，博约则多。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十四", "paragraphs": ["仰止狄皙，抱负渊通。", "游泳德化，扬厉素风。", "伟识既异，持教乃隆。", "厥志茂焉，毖祀无穷。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十五", "paragraphs": ["子敛受封，爰居武城。", "亹亹其闻，翩翩其英。", "抠衣时习，愿学日明。", "诞敷孔教，爵里疏荣。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十四", "paragraphs": ["惟子有道，天与异容。", "状虽云恶，德则其丰。", "南止江沱，学者云从。", "取士自兹，貌或非公。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十五", "paragraphs": ["夫孝要道，周训群生。", "以纲百行，以通神明。", "因子侍师，答问成经。", "事亲之实，代为仪刑。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十四", "paragraphs": ["贤行颜叔，亲承尼父。", "志锐所期，道尊是辅。", "泥在钧陶，木就规矩。", "终縻好爵，扬名东武。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十七", "paragraphs": ["式是壤伯，昭乎圣徒。", "执经请益，载道若无。", "诗书规矩，学问楷模。", "得时而驾，领袖诸儒。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十五", "paragraphs": ["易之为书，弥合天地。", "五十乃学，师则有是。", "子能受授，洗心传世。", "知机其神，宜被厥祀。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十六", "paragraphs": ["刚毅近仁，志操莫渝。", "性匪祝𬶍，面岂子都。", "有一于此，刚名可图。", "云欲则柔，盖生之徒。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十", "paragraphs": ["仕进之道，要在究习。", "具臣而居，咎欲谁执。", "斯未能信，谦以有立。", "阙里说之，多士莫及。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十一", "paragraphs": ["惟禽之问，从容其鲤。", "求以异闻，诗礼云尔。", "请一得三，诚退而喜。", "且知将圣，不私其子。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十五", "paragraphs": ["在昔石邑，能知所尊。", "懋依有德，克述无言。", "鼓箧槐市，扬名里门。", "此道久视，彼美长存。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十七", "paragraphs": ["孰封于萧，实惟子柳。", "夙饫格言，克遵善诱。", "明德斯馨，贤业所就。", "以侑于儒，传芳逾茂。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十九", "paragraphs": ["人禀秀德，气貌或同。", "而子俨然，温温其容。", "两端发问，未答机锋。", "以礼节和，斯言可宗。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十九", "paragraphs": ["人谁无子，尔嗣标奇。", "行为世范，学为人师。", "请车诚非，顾匪其私。", "千载之下，足以示慈。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十七", "paragraphs": ["念昔颛孙，商德与邻。", "学以干禄，问以书绅。", "参前倚衡，忠信是遵。", "色取行违，作戒后人。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四", "paragraphs": ["懿德贤行，有一则尊。", "子也履之，成性存存。", "骍角有用，犁牛莫论。", "刑政之言，惠施元元。"], "annotations": []}, {"title": "文宣王及其弟子赞 其七十", "paragraphs": ["温温子里，入闻至圣。", "揽道之华，秉德之柄。", "深造阃域，不乖言行。", "全齐之封，竹素为盛。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五", "paragraphs": ["德以充性，行以澡身。", "二事在躬，日跻而新。", "并驱贤科，得颜与邻。", "不幸斯疾，命也莫伸。"], "annotations": []}, {"title": "文宣王及其弟子赞 其七十二", "paragraphs": ["彭衙高士，经籍是亲。", "赞成德艺，协于彝伦。", "厎绩圣道，斯肖素臣。", "优哉游哉，学以致身。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十", "paragraphs": ["肃肃曹伯，王室之裔。", "积习乐道，切瑳明义。", "惟善则主，尔德是类。", "史笔有焕，令名永纪。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十二", "paragraphs": ["褒锡朱虚，在器轮舆。", "儒室振领，圣门曳裾。", "贤业得蕴，美材以摅。", "百世不刊，载观成书。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十二", "paragraphs": ["师席高振，大成是集。", "至道克传，贤达斯执。", "善道云袤，儒风可立。", "渔阳之士，得跂而及。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十九", "paragraphs": ["伯兹雩娄，务学实著。", "三千之位，七十是预。", "匪善莫行，惟德乃据。", "纪干前书，式彰厥誉。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十", "paragraphs": ["秦有子南，蜚声述作。", "守道之渊，成德之博。", "范若铸金，契犹发药。", "历世明祀，少梁宠爵。"], "annotations": []}, {"title": "文宣王及其弟子赞 其一", "paragraphs": ["大哉圣宣，斯文在兹。", "帝王之式，古今之师。", "志则春秋，道由忠恕。", "贤于尧舜，日月其誉。", "维时载雍，戢此武功。", "肃昭盛仪，海㝢聿崇。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六", "paragraphs": ["循良之要，在于有政。", "可使为宰，千室百乘。", "师门育材，治心扶性。", "退则进之，琢磨之柄。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十四", "paragraphs": ["天清日明，密雨曷有。", "师命持盖，子亦善扣。", "惟夫子博，三才允究。", "学者之乐，所得遂茂。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十八", "paragraphs": ["任城建伯，其表曰选。", "淑问雅驰，才华清远。", "竞辰力行，爱日黾勉。", "孔教崇崇，令绪显显。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十七", "paragraphs": ["有卫伯玉，夫子与居。", "寡过未能，荐赞使乎。", "以尸谏君，友则史鱼。", "果得进贤，烂然简书。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十五", "paragraphs": ["孔父秦父，相尚以力。", "俱生贤嗣，相与以德。", "是父是子，致诘畴克。", "会弁儒林，令名无极。"], "annotations": []}, {"title": "文宣王及其弟子赞 其七十一", "paragraphs": ["伯彼临淄，左行称贤。", "睎踪十哲，秀颖三千。", "心悦诚服，家至户传。", "乐只君子，文声益宣。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十六", "paragraphs": ["琅邪之伯，其惟子骄。", "微言既彰，德音孔昭。", "已观雩舞，同听齐韶。", "历千百祀，跂想高标。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十六", "paragraphs": ["手足甚亲，志异出处。", "魋将为乱，子乃脱去。", "在污能絜，危而有虑。", "内省若斯，何忧何惧。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二", "paragraphs": ["德行首科，显冠学徒。", "不迁不贰，乐道以居。", "食埃甚忠，在陋自如。", "宜称贤哉，岂止不愚。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十三", "paragraphs": ["侁侁申周，四科与俦。", "逸驾文圃，鼓枻儒流。", "冠佩既燕，言动允休。", "邵陵得封，可想清修。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十九", "paragraphs": ["东平子产，性著盛时。", "奉师于塾，讲道之微。", "答问其敏，婉妙以思。", "升降陛廉，尚想英姿。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十二", "paragraphs": ["乐善哲士，伯于汧阳。", "传道克正，垂名久臧。", "执德以洪，用心必刚。", "袤广业履，式赞素王。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十二", "paragraphs": ["室家壮年，无子则逐。", "见于信史，全齐之俗。", "原本厥初，师言可复。", "以学则知，揆之宜笃。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十一", "paragraphs": ["邈矣子季，睢阳是伯。", "屏息受业，延教登席。", "未践四科，困涉六籍。", "祀典载之，好是正直。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十六", "paragraphs": ["子长宏度，高出伦辈。", "虽在缧绁，知非其罪。", "纯德备行，夫子所采。", "以子妻之，尤知英概。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十一", "paragraphs": ["先觉既位，簪履并驰。", "尚德君子，尔乃兼之。", "羿奡可惭，禹稷可师。", "三复此道，载观白圭。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三十七", "paragraphs": ["彼美邽子，先圣是承。", "墙仞已及，堂陛将升。", "良玉斯琢，寒水必冰。", "锡壤平陆，茂实骞腾。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十九", "paragraphs": ["人有贤否，道有废兴。", "子如命何，营营震惊。", "季孙虽惑，景伯莫平。", "师资一言，秩祀亦惩。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十八", "paragraphs": ["开国乘氏，有德斯彰。", "参稽百行，赞理三纲。", "自拔行闲，荣名甚光。", "在史蔼蔼，历久弥芳。"], "annotations": []}, {"title": "文宣王及其弟子赞 其三", "paragraphs": ["天经地义，孝哉闵骞。", "父母昆弟，莫间其言。", "污君不仕，志气轩轩。", "复我汶上，出处休焉。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十", "paragraphs": ["有怀子折，全鲁之彦。", "儒行既名，聊伯乃建。", "兢兢受道，奕奕峨弁。", "懿选嘉访，世享馨荐。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十一", "paragraphs": ["文学之目，名重一时。", "为君子儒，作魏侯师。", "不可后礼，始可言诗。", "假盖小嫌，圣亦不疵。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十七", "paragraphs": ["猗尔子上，鲁邦之望。", "以德则贵，惟道是唱。", "师聪师明，友直友谅。", "伯于祝阿，儒风斯畅。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十六", "paragraphs": ["勉勉子车，封邑淳于。", "亲炙避席，唯诺趋隅。", "发微既博，雅道是扶。", "抑可尚也，不亦美乎。"], "annotations": []}, {"title": "文宣王及其弟子赞 其八", "paragraphs": ["辩以饰诈，言以致文。", "苟弗执礼，宜奠释纷。", "朽木粪墙，置不足言。", "言语之科，粗然有闻。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十二", "paragraphs": ["礼之有本，子能启问。", "大哉斯言，光昭明训。", "德辉泰山，诬祭莫奋。", "崇兹祀典，盍永令闻。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十五", "paragraphs": ["周衰伪隆，政在群公。", "廉耻道微，家臣聿崇。", "不为屈节，㧑默自容。", "子于是时，凛然清风。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十八", "paragraphs": ["轼彼穷阎，达士所宾。", "邦无道谷，进退孰伦。", "敝衣非病，无财乃贫。", "赐虽不怿，清节照人。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十二", "paragraphs": ["黄伯著祀，公孙是云。", "弥缝中道，协辅斯文。", "藏修方异，渐渍其勤。", "史词不忘，播为清芬。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十三", "paragraphs": ["养才以道，圣人兼济。", "始谓不仁，问鲍良喜。", "寓志农圃，似睽仁义。", "学稼之辞，岂姑舍是。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十九", "paragraphs": ["惟彼子之，锡伯期思。", "与贤并进，得圣而师。", "彬彬雅道，翼翼令仪。", "上目至言，庙食不隳。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十六", "paragraphs": ["遐想子期，挟策圣帷。", "涉道是嗜，惟士可縻。", "在德既贤，在名乃垂。", "洋洋之风，逮今四驰。"], "annotations": []}, {"title": "文宣王及其弟子赞 其七十三", "paragraphs": ["乐氏子声，锡爵昌平。", "信道之万，见善乃明。", "引领高节，载惟思诚。", "先贤聿集，出为时英。"], "annotations": []}, {"title": "文宣王及其弟子赞 其四十一", "paragraphs": ["至圣立教，子祺安雅。", "擅誉鲁邦，启祚钜野。", "炜矣风猷，时哉用舍。", "出伦离类，后学是假。"], "annotations": []}, {"title": "文宣王及其弟子赞 其十", "paragraphs": ["谦德知二，器实瑚琏。", "动必几先，孰并其辩。", "一使存鲁，五国有变。", "终相其主，誉处悠远。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十四", "paragraphs": ["多能鄙事，圣人曲意。", "惟其知之，是以不试。", "宗鲁虽友，吊必以义。", "尚师嘉言，祀亦罔替。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十八", "paragraphs": ["婉彼子羔，受业先圣。", "宗庙之问，一出乎正。", "克笃于孝，非愚乃令。", "师知其生，有辉贤行。"], "annotations": []}, {"title": "文宣王及其弟子赞 其五十八", "paragraphs": ["学者行道，敝缊亦称。", "使齐光华，偶为肥轻。", "周急之言，君子所令。", "答问允严，理皆先经。"], "annotations": []}, {"title": "文宣王及其弟子赞 其六十八", "paragraphs": ["雍容子皙，已望堂室。", "幼则有造，成则祖述。", "文采日化，儒效力弼。", "永观厥成，德音秩秩。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十三", "paragraphs": ["惟时义方，有子诚孝。", "怡怡圣域，俱膺是道。", "暮春舞雩，咏歌至教。", "师故与之，和悦宜召。"], "annotations": []}, {"title": "文宣王及其弟子赞 其二十", "paragraphs": ["伯夫荥阳，实惟令德。", "优入圣门，过不留迹。", "道以目传，妙则心识。", "倚欤伟欤，后代之则。"], "annotations": []}, {"title": "吴郡王冷泉图赞", "paragraphs": ["富贵不骄，戚畹称贤。", "扫除膏粱，放旷林泉。", "沧浪濯足，风度萧然。", "国之元舅，人中神仙。"], "annotations": []}, {"title": "皇甫真人像赞", "paragraphs": ["皇甫高士，眉字列仙。", "以道兴世，孰计其年。", "闲云在空，孤鹤行天。", "掀髯一笑，同乎自然。"], "annotations": []}, {"title": "句 其八", "paragraphs": ["绕池曳杖携双鹤，架水浇花课小奴。"], "annotations": []}, {"title": "句 其六", "paragraphs": ["白云断处斜阳转，几曲青山献画屏。"], "annotations": []}, {"title": "句 其三", "paragraphs": ["有美三宫德，无嫌并后心。"], "annotations": []}, {"title": "句 其一", "paragraphs": ["天末归帆何处宿，钓船独在蓼花傍。"], "annotations": []}, {"title": "句 其五", "paragraphs": ["气回俎豆群工泰，喜入貔貅万马秋。"], "annotations": []}, {"title": "句 其七", "paragraphs": ["池上疏烟笼翡翠，水边迟日戏蜻蜓。"], "annotations": []}, {"title": "句 其四", "paragraphs": ["趁此一轩风月好，橘香酒熟待君来。"], "annotations": []}, {"title": "句", "paragraphs": ["秋江烟瞑泊孤舟。"], "annotations": []}, {"title": "白葛蒲联句", "paragraphs": ["惟不识泥土，堆根抱玉泉。", "虽离岩谷伴，也则翠千年。"], "annotations": []}, {"title": "题马麟画", "paragraphs": ["南望青山满禁闱，晓陪鸳鹭正差池。", "共爱朝来何处雪，蓬莱宫里拂松枝。"], "annotations": []}, {"title": "幸天长赐僧广宝", "paragraphs": ["大界宜春赏，禅门不掩关。", "宸游双阙外，僧引百花间。", "车马喧长路，烟云净远山。", "观空复观俗，皇鉴此中闲。"], "annotations": []}, {"title": "题刘松年竹楼说听图", "paragraphs": ["小书楼下千竿竹，深火炉前一盏灯。", "此处与谁相伴宿，烧丹道士坐禅僧。"], "annotations": []}, {"title": "句 其二", "paragraphs": ["秋江烟暝泊孤舟。"], "annotations": []}, {"title": "题画册花草四首 蜡梅", "paragraphs": ["香蜜裁葩分外工，疏枝几点缀雏蜂。", "娇黄染就宫妆样，香煖尤宜爱日烘。", "寒花婀娜露凝香，风叶摇秋凤尾凉。", "梦入画堂银烛下，翠屏深处隐红妆。"], "annotations": []}, {"title": "赐刘能真三首", "paragraphs": ["简易高人道，崇玄性自真。", "身常居太极，心已远凡尘。", "玉陛辞荣禄，瑶台役鬼神。", "辛勤三十载，羡尔道心淳。", "太白巃嵷东南驰，众岭环合青分披。", "烟云厚薄皆可爱，木石疏密自相宜。", "阳春已归鸟语乐，溪水不动鱼行迟。", "生民无不得处所，与兹鱼鸟皆熙熙。"], "annotations": []}, {"title": "题丹桂画扇赐从臣", "paragraphs": ["月宫移就日宫栽，引得轻红入面来。", "好向烟霄承雨露，丹心一一为君开。", "秋入幽丛桂影团，香深粟粟照林丹。", "应随王母瑶池晓，染得朝霞下广寒。"], "annotations": []}, {"title": "崇恩显义院", "paragraphs": ["春莺叶底引圆吭，临罢黄庭日更长。", "满院柳花寒食后，旋钻新火𦶟炉香。", "松竹幽禽尺素间，恍然真向雪中看。", "动摇已自清风足，何况丹青写岁寒。", "管妙弦清韵入神，老人合眼醉醺醺。", "成知不及当来曲，犹觉闻时胜不闻。", "海神来过隐风回，浪打天门石壁开。", "浙江八月何如此，清似连山喷雪来。"], "annotations": []}, {"title": "题马远画册", "paragraphs": ["桃李无言春告归，落红如海乱莺啼。", "西村渡口斜阳里，渺渺烟波绿拍堤。", "月午江空桂花落，华阳道士云衣薄。", "石坛香散步虚声，杉露清泠滴栖鹤。", "不祷自安缘寿骨，人间难得是清名。", "浅斟仙酒红生颊，永保长生道自成。"], "annotations": []}, {"title": "文宣王及其弟子赞", "paragraphs": ["大哉圣宣，斯文在兹。", "帝王之式，古今之师。", "志则春秋，道由忠恕。", "贤于尧舜，日月其誉。", "维时载雍，戢此武功。", "肃昭盛仪，海㝢聿崇。", "德行首科，显冠学徒。", "不迁不贰，乐道以居。", "食埃甚忠，在陋自如。", "宜称贤哉，岂止不愚。", "天经地义，孝哉闵骞。", "父母昆弟，莫间其言。", "污君不仕，志气轩轩。", "复我汶上，出处休焉。", "懿德贤行，有一则尊。", "子也履之，成性存存。", "骍角有用，犁牛莫论。", "刑政之言，惠施元元。", "德以充性，行以澡身。", "二事在躬，日跻而新。", "并驱贤科，得颜与邻。", "不幸斯疾，命也莫伸。", "循良之要，在于有政。", "可使为宰，千室百乘。", "师门育材，治心扶性。", "退则进之，琢磨之柄。", "道义正己，文学擅科。", "为宰武城，联以弦歌。", "割鸡之试，牛刀谓何。", "前言戏尔，博约则多。", "辩以饰诈，言以致文。", "苟弗执礼，宜奠释纷。", "朽木粪墙，置不足言。", "言语之科，粗然有闻。", "升堂惟光，千乘惟权。", "陵暴知非，委质可贤。", "折狱言简，结缨礼全。", "恶言不耳，仲尼赖焉。", "谦德知二，器实瑚琏。", "动必几先，孰并其辩。", "一使存鲁，五国有变。", "终相其主，誉处悠远。", "文学之目，名重一时。", "为君子儒，作魏侯师。", "不可后礼，始可言诗。", "假盖小嫌，圣亦不疵。", "礼之有本，子能启问。", "大哉斯言，光昭明训。", "德辉泰山，诬祭莫奋。", "崇兹祀典，盍永令闻。", "养才以道，圣人兼济。", "始谓不仁，问鲍良喜。", "寓志农圃，似睽仁义。", "学稼之辞，岂姑舍是。", "惟子有道，天与异容。", "状虽云恶，德则其丰。", "南止江沱，学者云从。", "取士自兹，貌或非公。", "夫孝要道，周训群生。", "以纲百行，以通神明。", "因子侍师，答问成经。", "事亲之实，代为仪刑。", "子长宏度，高出伦辈。", "虽在缧绁，知非其罪。", "纯德备行，夫子所采。", "以子妻之，尤知英概。", "猗尔子上，鲁邦之望。", "以德则贵，惟道是唱。", "师聪师明，友直友谅。", "伯于祝阿，儒风斯畅。", "轼彼穷阎，达士所宾。", "邦无道谷，进退孰伦。", "敝衣非病，无财乃贫。", "赐虽不怿，清节照人。", "人禀秀德，气貌或同。", "而子俨然，温温其容。", "两端发问，未答机锋。", "以礼节和，斯言可宗。", "伯夫荥阳，实惟令德。", "优入圣门，过不留迹。", "道以目传，妙则心识。", "倚欤伟欤，后代之则。", "邈矣子季，睢阳是伯。", "屏息受业，延教登席。", "未践四科，困涉六籍。", "祀典载之，好是正直。", "乐善哲士，伯于汧阳。", "传道克正，垂名久臧。", "执德以洪，用心必刚。", "袤广业履，式赞素王。", "惟时义方，有子诚孝。", "怡怡圣域，俱膺是道。", "暮春舞雩，咏歌至教。", "师故与之，和悦宜召。", "天清日明，密雨曷有。", "师命持盖，子亦善扣。", "惟夫子博，三才允究。", "学者之乐，所得遂茂。", "周衰伪隆，政在群公。", "廉耻道微，家臣聿崇。", "不为屈节，㧑默自容。", "子于是时，凛然清风。", "遐想子期，挟策圣帷。", "涉道是嗜，惟士可縻。", "在德既贤，在名乃垂。", "洋洋之风，逮今四驰。", "念昔颛孙，商德与邻。", "学以干禄，问以书绅。", "参前倚衡，忠信是遵。", "色取行违，作戒后人。", "婉彼子羔，受业先圣。", "宗庙之问，一出乎正。", "克笃于孝，非愚乃令。", "师知其生，有辉贤行。", "伯兹雩娄，务学实著。", "三千之位，七十是预。", "匪善莫行，惟德乃据。", "纪干前书，式彰厥誉。", "秦有子南，蜚声述作。", "守道之渊，成德之博。", "范若铸金，契犹发药。", "历世明祀，少梁宠爵。", "惟禽之问，从容其鲤。", "求以异闻，诗礼云尔。", "请一得三，诚退而喜。", "且知将圣，不私其子。", "室家壮年，无子则逐。", "见于信史，全齐之俗。", "原本厥初，师言可复。", "以学则知，揆之宜笃。", "纪伯子鲁，圣学是务。", "厉己斯的，好问乃裕。", "周旋中规，容止可度。", "允矣昔贤，后世所慕。", "贤行颜叔，亲承尼父。", "志锐所期，道尊是辅。", "泥在钧陶，木就规矩。", "终縻好爵，扬名东武。", "在昔石邑，能知所尊。", "懋依有德，克述无言。", "鼓箧槐市，扬名里门。", "此道久视，彼美长存。", "琅邪之伯，其惟子骄。", "微言既彰，德音孔昭。", "已观雩舞，同听齐韶。", "历千百祀，跂想高标。", "彼美邽子，先圣是承。", "墙仞已及，堂陛将升。", "良玉斯琢，寒水必冰。", "锡壤平陆，茂实骞腾。", "任城建伯，其表曰选。", "淑问雅驰，才华清远。", "竞辰力行，爱日黾勉。", "孔教崇崇，令绪显显。", "人谁无子，尔嗣标奇。", "行为世范，学为人师。", "请车诚非，顾匪其私。", "千载之下，足以示慈。", "肃肃曹伯，王室之裔。", "积习乐道，切瑳明义。", "惟善则主，尔德是类。", "史笔有焕，令名永纪。", "至圣立教，子祺安雅。", "擅誉鲁邦，启祚钜野。", "炜矣风猷，时哉用舍。", "出伦离类，后学是假。", "褒锡朱虚，在器轮舆。", "儒室振领，圣门曳裾。", "贤业得蕴，美材以摅。", "百世不刊，载观成书。", "惟子挺生，道德之门。", "佩服至论，鲤则弟昆。", "三得三亡，所问殊温。", "君子归宓，义不掩恩。", "仰止狄皙，抱负渊通。", "游泳德化，扬厉素风。", "伟识既异，持教乃隆。", "厥志茂焉，毖祀无穷。", "子敛受封，爰居武城。", "亹亹其闻，翩翩其英。", "抠衣时习，愿学日明。", "诞敷孔教，爵里疏荣。", "刚毅近仁，志操莫渝。", "性匪祝𬶍，面岂子都。", "有一于此，刚名可图。", "云欲则柔，盖生之徒。", "式是壤伯，昭乎圣徒。", "执经请益，载道若无。", "诗书规矩，学问楷模。", "得时而驾，领袖诸儒。", "开国乘氏，有德斯彰。", "参稽百行，赞理三纲。", "自拔行闲，荣名甚光。", "在史蔼蔼，历久弥芳。", "惟彼子之，锡伯期思。", "与贤并进，得圣而师。", "彬彬雅道，翼翼令仪。", "上目至言，庙食不隳。", "有怀子折，全鲁之彦。", "儒行既名，聊伯乃建。", "兢兢受道，奕奕峨弁。", "懿选嘉访，世享馨荐。", "先觉既位，簪履并驰。", "尚德君子，尔乃兼之。", "羿奡可惭，禹稷可师。", "三复此道，载观白圭。", "黄伯著祀，公孙是云。", "弥缝中道，协辅斯文。", "藏修方异，渐渍其勤。", "史词不忘，播为清芬。", "兄弟之邦，士有廉庸。", "涵泳素教，表揭儒宗。", "杏坛探赜，洙泗从容。", "作兴一时，莒父其封。", "瑕丘祚邑，子期是为。", "亲训有日，广业于时。", "四教允隆，五常以持。", "比肩俊杰，闻望斯垂。", "易之为书，弥合天地。", "五十乃学，师则有是。", "子能受授，洗心传世。", "知机其神，宜被厥祀。", "手足甚亲，志异出处。", "魋将为乱，子乃脱去。", "在污能絜，危而有虑。", "内省若斯，何忧何惧。", "有卫伯玉，夫子与居。", "寡过未能，荐赞使乎。", "以尸谏君，友则史鱼。", "果得进贤，烂然简书。", "学者行道，敝缊亦称。", "使齐光华，偶为肥轻。", "周急之言，君子所令。", "答问允严，理皆先经。", "人有贤否，道有废兴。", "子如命何，营营震惊。", "季孙虽惑，景伯莫平。", "师资一言，秩祀亦惩。", "仕进之道，要在究习。", "具臣而居，咎欲谁执。", "斯未能信，谦以有立。", "阙里说之，多士莫及。", "君子若人，单父之政。", "引肘寤君，放鱼禀令。", "傅郭勿获，遂能制命。", "百代理邑，用规观听。", "师席高振，大成是集。", "至道克传，贤达斯执。", "善道云袤，儒风可立。", "渔阳之士，得跂而及。", "侁侁申周，四科与俦。", "逸驾文圃，鼓枻儒流。", "冠佩既燕，言动允休。", "邵陵得封，可想清修。", "多能鄙事，圣人曲意。", "惟其知之，是以不试。", "宗鲁虽友，吊必以义。", "尚师嘉言，祀亦罔替。", "孔父秦父，相尚以力。", "俱生贤嗣，相与以德。", "是父是子，致诘畴克。", "会弁儒林，令名无极。", "勉勉子车，封邑淳于。", "亲炙避席，唯诺趋隅。", "发微既博，雅道是扶。", "抑可尚也，不亦美乎。", "孰封于萧，实惟子柳。", "夙饫格言，克遵善诱。", "明德斯馨，贤业所就。", "以侑于儒，传芳逾茂。", "雍容子皙，已望堂室。", "幼则有造，成则祖述。", "文采日化，儒效力弼。", "永观厥成，德音秩秩。", "东平子产，性著盛时。", "奉师于塾，讲道之微。", "答问其敏，婉妙以思。", "升降陛廉，尚想英姿。", "温温子里，入闻至圣。", "揽道之华，秉德之柄。", "深造阃域，不乖言行。", "全齐之封，竹素为盛。", "伯彼临淄，左行称贤。", "睎踪十哲，秀颖三千。", "心悦诚服，家至户传。", "乐只君子，文声益宣。", "彭衙高士，经籍是亲。", "赞成德艺，协于彝伦。", "厎绩圣道，斯肖素臣。", "优哉游哉，学以致身。", "乐氏子声，锡爵昌平。", "信道之万，见善乃明。", "引领高节，载惟思诚。", "先贤聿集，出为时英。"], "annotations": []}, {"title": "句", "paragraphs": ["天末归帆何处宿，钓船独在蓼花傍。", "秋江烟暝泊孤舟。", "有美三宫德，无嫌并后心。", "趁此一轩风月好，橘香酒熟待君来。", "气回俎豆群工泰，喜入貔貅万马秋。", "白云断处斜阳转，几曲青山献画屏。", "池上疏烟笼翡翠，水边迟日戏蜻蜓。", "绕池曳杖携双鹤，架水浇花课小奴。"], "annotations": []}]}