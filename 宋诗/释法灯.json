{"dynasty": "宋", "author": "释法灯", "author_desc": "", "works": [{"title": "偈", "paragraphs": ["耳底泉声，眼前山色。", "檐头雨滴，篱畔黄华。", "嗈嗈新雁唳南云，片片亭梧红满地。"], "annotations": []}, {"title": "句  其三", "paragraphs": ["永日翛然坐。"]}, {"title": "句  其五", "paragraphs": ["幽鸟语如簧。"]}, {"title": "句  其四", "paragraphs": ["未取负雪山。"]}, {"title": "句  其一", "paragraphs": ["云失溪月寒。"]}, {"title": "句  其二", "paragraphs": ["岸柳含烟翠。"]}]}