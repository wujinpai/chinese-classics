{"dynasty": "宋", "author": "释惟久", "author_desc": "", "works": [{"title": "赞死心禅师偈 其一", "paragraphs": ["韶阳死心，灵源甚深。", "耳中见色，眼里闻声。", "凡明圣昧，后富前贫。", "利生济物，点铁成金。", "丹青徒状，非古非今。"], "annotations": []}, {"title": "赞死心禅师偈 其二", "paragraphs": ["死心非真，真非死心。", "虚空无状，妙有无形。", "绝后再苏，亲见死心。"], "annotations": []}, {"title": "读法界观", "paragraphs": ["物我元无二，森罗镜象同。", "明明超主伴，了了彻真空。", "一体含多法，交参帝网中。", "重重无尽意，动静悉圆通。"], "annotations": []}]}