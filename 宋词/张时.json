{"dynasty": "宋", "author": "张时", "author_desc": "", "works": [{"title": "南歌子", "paragraphs": ["暖日未斜西。", "正是迷花𣨼酒时。", "红药雕阑呈冷艳，依稀。", "花重枝柔压半敧。", "相对耍猴儿。", "一捻幽芳劝酒卮。", "魏紫姚黄来觑着，方知。", "准拟今宵醉伴妻。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南乡子 和谢福娘", "paragraphs": ["暖日未斜西。", "正是迷花𣨼酒时。", "红药雕阑呈冷艳，依稀。", "花重枝柔压半敧。", "相对耍猴儿。", "一捻幽芳劝酒卮。", "魏紫姚黄来觑着，方知。", "准拟今宵醉伴妻。"], "annotations": []}]}