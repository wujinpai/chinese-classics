{"dynasty": "宋", "author": "刘铉", "author_desc": "", "works": [{"title": "少年游 戏友人与女客对棋", "paragraphs": ["石榴花下薄罗衣。", "睡起却寻棋。", "未省高低，被伊春笋，拈了白玻璃。", "钏脱钗斜浑不省，意重子声迟。", "对面痴心，只愁收局，肠断欲输时。"], "annotations": [], "rhythmic": "少年游"}, {"title": "蝶恋花 送春", "paragraphs": ["人自怜春春未去。", "萱草石榴，也解留春住。", "只道送春无送处。", "山花落得红成路。", "高处莺啼低蝶舞。", "何况日长，燕子能言语。", "付与光阴相客主。", "晴云又卷西边雨。"], "annotations": [], "rhythmic": "蝶恋花"}, {"title": "乌夜啼 石榴", "paragraphs": ["垂杨影里残红。", "甚匆匆。", "只有榴花、全不怨东风。", "暮雨急。", "晓鸦湿。", "绿玲珑。", "比似茜裙初染、一般同。"], "annotations": [], "rhythmic": "乌夜啼"}]}