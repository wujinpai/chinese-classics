{"dynasty": "宋", "author": "李彭", "author_desc": "", "works": [{"title": "渔歌子十首 颂尊宿付杲山人 其一 汾阳", "paragraphs": ["南院嫡孙唯此个。", "西河狮子当门坐。", "绢扇清凉随手簸。", "君知么。", "无端吃棒休寻过。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其二 慈明", "paragraphs": ["掌握千差都照破。", "石霜这汉难关锁。", "水出高源酬佛陀。", "哩棱逻。", "须弥作舞虚空和。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其三 云峰", "paragraphs": ["孤硬云峰无计较。", "大愚滩上曾垂钓。", "佛法何曾愁烂了。", "桶箍爆。", "通身汗出呵呵笑。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其四 老南", "paragraphs": ["万古黄龙真夭矫。", "斩新勘破台山媪。", "佛手驴蹄人不晓。", "无关窍。", "胡家一曲非凡调。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其五 晦堂", "paragraphs": ["宝觉禅河波浩浩。", "五湖衲子来求宝。", "忽坚拳头宜速道。", "茫然讨。", "难逃背触君须到。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其六 真净", "paragraphs": ["贬剥诸方真净老。", "顶门眼正形枯槁。", "一点深藏人莫造。", "由来妙。", "光明烜赫机锋峭。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其七 潜庵", "paragraphs": ["积翠十年丹风穴。", "当时亲得黄龙钵。", "掣电之机难把撮。", "真奇绝。", "分明水底天边月。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其八 死心", "paragraphs": ["骂佛骂人新孟八。", "是非窟里和身拶。", "不惜眉毛言便发。", "门庭滑。", "红炉大𫖔能生效。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其九 灵源", "paragraphs": ["绝唱灵源求和寡。", "先牛寻得西家马。", "顾陆笔端难拟画。", "千林谢。", "吟风摆雪真萧洒。"], "annotations": [], "rhythmic": "渔歌・渔父"}, {"title": "渔歌子十首 颂尊宿付杲山人 其一 湛堂", "paragraphs": ["选佛堂中川藞苴。", "衲僧卑孔头垂下。", "独秀握来无一把。", "杖头挂。", "从教四海禅徒讶。"], "annotations": [], "rhythmic": "渔歌・渔父"}]}