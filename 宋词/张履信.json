{"dynasty": "宋", "author": "张履信", "author_desc": "", "works": [{"title": "柳梢青", "paragraphs": ["雨歇桃繁，风微柳静，日淡湖湾。", "寒食清明，虽然过了，未觉春闲。", "行云掩映春山。", "真水墨、山阴道间。", "燕语侵愁，花飞撩恨，人在江南。"], "annotations": [], "rhythmic": "柳梢青"}, {"title": "谒金门", "paragraphs": ["春睡起。", "小阁明窗儿底。", "帘外雨声花积水。", "薄寒犹在里。", "欲起还慵未起。", "好是孤眠滋味。", "一曲广陵应忘记。", "起来调绿绮。"], "annotations": [], "rhythmic": "谒金门"}]}