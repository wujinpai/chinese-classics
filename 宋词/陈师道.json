{"dynasty": "宋", "author": "陈师道", "author_desc": "", "works": [{"title": "菩萨蛮", "paragraphs": ["行云过尽星河烂。", "炉烟未断蛛丝满。", "想得两眉颦。", "停针忆远人。", "河桥知有路。", "不解留郎住。", "天上隔年期。", "人间长别离。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮", "paragraphs": ["东风乌鹊西飞燕。", "盈盈一水经年见。", "急雨洗香车。", "天回河汉斜。", "离愁千载上。", "相远长相望。", "终不似人间。", "回头万里山。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮", "paragraphs": ["绮楼小小穿针女。", "秋光点点蛛丝雨。", "今夕是何宵。", "龙车乌鹊桥。", "经年谋一笑。", "岂解令人巧。", "不用问如何。", "人间巧更多。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮", "paragraphs": ["银潢清浅填乌鹊。", "画檐急雨长河落。", "初月未成圆。", "明星惜此筵。", "愁来无断绝。", "岁岁年年别。", "不用泪红滋。", "年年岁岁期。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "木兰花・玉楼春", "paragraphs": ["阴阴云日江城晚。", "小院回廊春已满。", "谁教言语似鹂黄，深闭玉笼千万怨。", "蓬莱易到人难见。", "香火无凭空有愿。", "不辞歌里断人肠，只怕有肠无处断。"], "annotations": [], "rhythmic": "木兰花・玉楼春"}, {"title": "南柯子・南歌子", "paragraphs": ["故国山河在，新堂冰雪生。", "万家和气贺初成。", "人在笙歌声里、暗生春。", "今代无双士，当年第一人。", "杯行到手莫辞频。", "明日凤池归路、隔清尘。"], "annotations": [], "rhythmic": "南柯子・南歌子"}, {"title": "西江月", "paragraphs": ["楼上风生白羽，尊前笑出青春。", "破红展翠恰如今。", "把酒如何不饮。", "绣幕灯深绿暗，画帘人语黄昏。", "晚云将雨不成阴。", "竹月风窗弄影。"], "annotations": [], "rhythmic": "西江月"}, {"title": "菩萨蛮", "paragraphs": ["喧喧车马西郊道。", "临行更觉人情好。", "住有一年情。", "去留千载名。", "离歌声欲尽。", "只作常时听。", "天上玉堂东。", "阳春是梦中。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "虞美人", "paragraphs": ["城南观阁连云起。", "形像丹青里。", "使君笳鼓渡江来。", "尽带江南春色、放春回。", "青春欲住风催去。", "流水花无数。", "尊前触目一番新。", "只有玉楼明月、记游人。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "木兰花・玉楼春", "paragraphs": ["湖平木落摇空阔。", "叶底流泉鸣复咽，酒边清漏往时同，花里朱弦纤手抹。", "风光过手春冰滑。", "十事违人常七八。", "不将白发并黄花，拟下清流揽明月。"], "annotations": [], "rhythmic": "木兰花・玉楼春"}, {"title": "南乡子", "paragraphs": ["晴野下田收。", "照影寒江落雁洲。", "禅榻茶炉深闭阁，飕飕。", "横雨旁风不到头。", "登览却轻酬。", "剩作新诗报答秋。", "人意自阑花自好，休休。", "今日看时蝶也愁。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "南乡子", "paragraphs": ["潮落去帆收。", "沙涨江回旋作洲。", "侧帽独行斜照里，飕飕。", "卷地风前更掉头。", "语妙后难酬。", "回雁峰南未得秋。", "唤取佳人听旧曲，休休。", "瘴雨无花孰与愁。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "西江月", "paragraphs": ["点点轻黄减白，垂垂重露生鲜。", "肌香骨秀月中仙。", "雪满瑶台曳练。", "绰约却宜长见，清真不假馀妍。", "殷勤与插小婵娟。", "要试尊前玉面。"], "annotations": [], "rhythmic": "西江月"}, {"title": "西江月", "paragraphs": ["叶叶枝枝绿暗，重重密密红滋。", "芳心应恨赏春迟。", "不会春工著意。", "晚照酒生娇面，新妆睡污胭脂。", "凭将双叶寄相思。", "与看钗头何似。"], "annotations": [], "rhythmic": "西江月"}, {"title": "菩萨蛮", "paragraphs": ["髻钗初上朝云卷。", "眼波翻动眉山远。", "一曲杜韦娘。", "当年枉断肠。", "佳期如好月。", "拟满还须缺。", "别易见应难。", "长须仔细看。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "减字木兰花", "paragraphs": ["清尊白发。", "曾是登临年少客。", "不似当年。", "人与黄花两并妍。", "来愁去恨。", "十载相看情不尽。", "莫更思量。", "梦破春回枉断肠。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "满庭芳", "paragraphs": ["闽岭先春，琅函联璧，帝所分落人间。", "绮窗纤手，一缕破双团。", "云里游龙舞凤，香雾起、飞月轮边。", "华堂静，松风竹雪，金鼎沸湲潺。", "门阑。", "车马动，扶黄籍白，小袖高鬟。", "渐胸里轮囷，肺腑生寒。", "唤起谪仙醉倒，翻湖海、倾泻涛澜。", "笙歌散，风帘月幕，禅榻鬓丝斑。"], "annotations": [], "rhythmic": "满庭芳"}, {"title": "南乡子", "paragraphs": ["急雨打寒窗。", "雨气侵灯暗壁缸。", "窗下有人挑锦字，行行。", "泪湿红绡减旧香。", "往事最难忘。", "更著秋声说断肠。", "曲渚圆沙风叶底，藏藏。", "谁使鸳鸯故作双。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "清平乐", "paragraphs": ["休休莫莫。", "更莫思量著。", "记著不如浑忘著。", "百种寻思枉却。", "绣囊锦帐吹香。", "雄蜂雌蝶难双。", "眉上放开春色，眼前怜取新郎。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "清平乐", "paragraphs": ["藏藏摸摸。", "好事争如莫。", "背后寻思浑是错。", "猛与将来放著。", "吹花卷絮无踪。", "晚妆知为谁红。", "梦断阳台云雨，世间不要春风。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "南乡子", "paragraphs": ["阴重雨垂垂。", "并马西郊试薄衣。", "红蕊未开花已过，迟迟。", "不见东风著意时。", "酒到更须辞。", "报答春光旧有期。", "勤苦著书妨作乐，痴痴。", "莫学衰翁万事非。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "罗敷媚・采桑子", "paragraphs": ["春风吹尽秋光照，瘦减初黄。", "改样新妆。", "特地相逢只认香。", "南台九日登临处，不共飞觞。", "镜里伊傍。", "独秀钗头殿众芳。"], "annotations": [], "rhythmic": "罗敷媚・采桑子"}, {"title": "罗敷媚・采桑子", "paragraphs": ["芙蓉不借韶华助，故著缃黄。", "宿面留妆。", "不出寒花只暂香。", "伤春不尽悲秋苦，落蕊浮觞。", "知在谁傍。", "一笑盈盈百种芳。"], "annotations": [], "rhythmic": "罗敷媚・采桑子"}, {"title": "木兰花・玉楼春", "paragraphs": ["荣光休气天为瑞。", "道祖当天传宝裔。", "千年昌运此时逢，四海欢声今日沸。", "蒙蒙香雾沾衣腻。", "漠漠轻寒梅柳细。", "封人长有祝尧心，从此年年并岁岁。"], "annotations": [], "rhythmic": "木兰花・玉楼春"}, {"title": "木兰花减字・减字木兰花", "paragraphs": ["娉婷娜袅。", "红落东风青子小。", "妙舞逶迤。", "拍误周郎却未知。", "花前月底。", "谁唤分司狂御史。", "欲语还休。", "唤不回头莫著羞。"], "annotations": [], "rhythmic": "木兰花减字・减字木兰花"}, {"title": "木兰花减字・减字木兰花", "paragraphs": ["娉娉袅袅。", "芍药枝头红玉小。", "舞袖迟迟。", "心到郎边客已知。", "当筵举酒。", "劝我尊前松柏寿。", "莫莫休休。", "白发簪花我自羞。"], "annotations": [], "rhythmic": "木兰花减字・减字木兰花"}, {"title": "临江仙", "paragraphs": ["离别寻常今白首，更须竹雨萧萧。", "不应都占世间豪。", "清风居士手，杨柳洛城腰。", "文字功名真自误，从今好月良宵。", "只消怜取董娇饶。", "修门君自到，不用我词招。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "南柯子・南歌子", "paragraphs": ["天上云为瑞，人间睡作魔，疏帘清簟汗成河。", "酒醒梦回眵眼、费摩娑。", "但有寒喧问，初无凤鸟过。", "尘生铜碾网生罗。", "一喏十年犹未、意如何。"], "annotations": [], "rhythmic": "南柯子・南歌子"}, {"title": "木兰花减字・减字木兰花", "paragraphs": ["匀红点翠。", "取次梳妆谁得似。", "风柳腰肢。", "尽日纤柔属阿谁。", "娇娇小小。", "却是寻春人较老。", "著便休痴。", "付与风流幕下儿。"], "annotations": [], "rhythmic": "木兰花减字・减字木兰花"}, {"title": "清平乐", "paragraphs": ["秋声隐地。", "叶叶无留意。", "冰簟流光团扇坠。", "惊起双栖燕子。", "夜堂帘合回廊。", "风帏吹乱凝香。", "卧看一庭名月，晓衾不耐初凉。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "清平乐", "paragraphs": ["秋光烛地。", "帘幕生秋意。", "露叶翻风惊鹊坠。", "暗落青林红子。", "微行声断长廊。", "熏炉衾换生香。", "灭烛却延明月，揽衣先怯微凉。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "卜算子", "paragraphs": ["纤软小腰身，明秀天真面。", "淡画修眉小作春，中有相思怨。", "背立向人羞，颜破因谁倩。", "不比阳台梦里逢，亲向尊前见。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "洛阳春・一落萦", "paragraphs": ["酒到横波娇满。", "和香喷面。", "攀花落雨祝东风，诮不借、周郎便。", "背立腰肢挪拈。", "更须回盼。", "多生不作好因缘，甚只向、尊前见。"], "annotations": [], "rhythmic": "洛阳春・一落萦"}, {"title": "浣溪沙", "paragraphs": ["暮叶朝花种种陈。", "三秋作意向诗人。", "安排云雨要新清。", "随意且须追去马，轻衫从使著行尘。", "晚窗谁念一愁新。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "临江仙", "paragraphs": ["官样初黄过闰九。", "鲜妍时更宜寒。", "挽回人意不成阑。", "香罗堆叶密，芳意著心单。", "过与后房歌舞手，轻盈喜色生颜。", "堕钗拥髻与垂鬟。", "欲知谁称面，遍插一枝看。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "清平乐", "paragraphs": ["重重叠叠。", "娜娜裙千𫌇。", "时样官黄香百叶。", "一岁相逢两节。", "曲阑绕遍芳丛。", "一枝作意妍秾。", "折得有谁相忆，却须还与秋风。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "南乡子", "paragraphs": ["风絮落东邻。", "点缀繁枝旋化尘。", "关锁玉楼巢燕子，冥冥。", "桃李摧残不见春。", "流转到如今。", "翡翠生儿翠作衿。", "花样腰身官样立，婷婷。", "困倚阑干一欠伸。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "南乡子", "paragraphs": ["乱蕊压枝繁。", "堆积金钱闹作团。", "晚起涂黄仍带酒，看看。", "衣剩腰肢故著单。", "薄瘦却禁寒。", "牵引人心不放阑。", "拟折一枝遮老眼，难难。", "蝶横蜂争只倚阑。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "临江仙", "paragraphs": ["曲巷斜街信马，小桥流水谁家。", "浅衫深袖倚门斜。", "只缘些子意，消得百般夸。", "粉面初生明月，酒容欲退朝霞。", "春风还解染霜华。", "肯持鸳绮被，来伴杜家花。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "蝶恋花", "paragraphs": ["九里山前千里路。", "流水无情，只送行人去。", "路转河回寒日暮。", "连峰不许重回顾。", "水解随人花却住。", "衾冷香销，但有残妆污。", "泪入长江空几许。", "双洪一抹无寻处。"], "annotations": [], "rhythmic": "蝶恋花"}, {"title": "西江月", "paragraphs": ["浅色千重柔叶，深心一点娇黄。", "只消可意更须香。", "好个风流模样。", "玉蕊今谁攀折，诗人此日凄凉。", "正须蛮素作伊凉。", "与插钗傍鬓上。"], "annotations": [], "rhythmic": "西江月"}, {"title": "洛阳春・一落萦", "paragraphs": ["素手拈花纤软。", "生香相乱。", "却须诗力与丹青，恐俗手、难成染。", "一顾教人微倩。", "那堪亲见。", "不辞紫袖拂清尘，也要识、春风面。"], "annotations": [], "rhythmic": "洛阳春・一落萦"}, {"title": "菩萨蛮", "paragraphs": ["清词丽句前朝曲。", "使君借与灯前读。", "读罢已三更。", "寒窗雨打声。", "应怜诗客老。", "要使情怀好。", "犹有解歌人。", "尊前未得听。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "木兰花减字・减字木兰花", "paragraphs": ["清愁叠积。", "更莫迟留春酒逼。", "吹面和风。", "梅信新来一线通。", "危楼晓望。", "雪满群山开画障。", "目断瑶川。", "同凭阑干意几般。"], "annotations": [], "rhythmic": "木兰花减字・减字木兰花"}, {"title": "卜算子", "paragraphs": ["梅岭数枝春，疏影斜临水。", "不借芳华只自香，娇面长如洗。", "还把最繁枝，过与偏怜底。", "拭傍鸾台仔细看，何似丹青里。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "渔家傲", "paragraphs": ["一舸姑苏风雨疾。", "吴笺满载红犹湿。", "色润朝花光触日。", "人未识。", "街南小阮应先得。", "青入柳条初著色。", "溪梅已露春消息。", "拟作新词酬帝力。", "轻落笔。", "黄秦去后无强敌。"], "annotations": [], "rhythmic": "渔家傲"}, {"title": "少年游", "paragraphs": ["御园果子压枝繁。", "看看分摘无缘。", "团沙弄雪，劳心费手，不肯暂时圆。", "赛神旧愿心儿有，终了待、几时还。", "芍药梢头，红红白白，一种几千般。"], "annotations": [], "rhythmic": "少年游"}, {"title": "南乡子", "paragraphs": ["袅娜破瓜馀。", "豆蔻梢头二月初。", "众里腰肢遥可识，应殊。", "暗里犹能摸得渠。", "醉侧不须扶。", "唤作周家行画图。", "背立欠伸花絮底，知无。", "未信丹青画得如。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "木兰花减字・减字木兰花", "paragraphs": ["今年百五。", "风日清明尘不举。", "紫袖红陈。", "三节烟花次第春。", "来舆去马。", "千念一空春事谢。", "白下门东。", "谁见初杨弄晚风。"], "annotations": [], "rhythmic": "木兰花减字・减字木兰花"}, {"title": "踏莎行", "paragraphs": ["红上花梢，风传梅信。", "青春欲动群芳竞。", "林声鸟语带馀寒，江光野色开游径。", "乍雨还晴，喧寒不定。", "重门深院帘帷静。", "又还日日唤愁生，到谁准拟风流病。"], "annotations": [], "rhythmic": "踏莎行"}, {"title": "菩萨蛮", "paragraphs": ["晓来误入桃源洞。", "恰见佳人春睡重。", "玉腕枕香腮。", "荷花藕上开。", "一扇俄惊起。", "敛黛凝秋水。", "笑倩整金衣。", "问郎来几时。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "卜算子", "paragraphs": ["摇风影似凝，带雪香如抱。", "开尽南枝到北枝，不道春将老。", "飘飖姑射仙，谁识冰肌好。", "会有青绫梦觉人，可爱池塘草。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "卜算子", "paragraphs": ["绣幕罩梅花，莫放清香透。", "鉴里朱颜岁岁移，只道花依旧。", "把酒问梅花，知我离情否。", "若使梅花知我时，料得花须瘦。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "卜算子", "paragraphs": ["雪暗岭头云，竹冷溪边树。", "还似潇湘缥缈人，玉骨笼香雾。", "月下幽香度。", "梦里香魂驻。", "回首南枝酒半醺，寂寞无寻处。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "卜算子 其二", "paragraphs": ["绣幕罩梅花，莫放清香透。", "鉴里朱颜岁岁移，只道花依旧。", "把酒问梅花，知我离情否。", "若使梅花知我时，料得花须瘦。"], "annotations": []}, {"title": "卜算子 其三", "paragraphs": ["雪暗岭头云，竹冷溪边树。", "还似潇湘缥缈人，玉骨笼香雾。", "月下幽香度。", "梦里香魂驻。", "回首南枝酒半醺，寂寞无寻处。"], "annotations": []}, {"title": "卜算子 其二 送梅花与赵使君", "paragraphs": ["梅岭数枝春，疏影斜临水。", "不借芳华只自香，娇面长如洗。", "还把最繁枝，过与偏怜底。", "试傍鸾台仔细看，何似丹青里。"], "annotations": []}, {"title": "卜算子 其一", "paragraphs": ["摇风影似凝，带雪香如抱。", "开尽南枝到北枝，不道春将老。", "飘飖姑射仙，谁识冰肌好。", "会有青绫梦觉人，可爱池塘草。"], "annotations": []}, {"title": "卜算子 其一", "paragraphs": ["纤软小腰身，明秀天真面。", "淡画修眉小作春，中有相思怨。", "背立向人羞，颜破因谁倩。", "不比阳台梦里逢，亲向尊前见。"], "annotations": []}, {"title": "木兰花减字/减字木兰花 其一 赠晃无咎舞鬟", "paragraphs": ["娉婷娜袅。", "红落东风青子小。", "妙舞逶迤。", "拍误周郎却未知。", "花前月底。", "谁唤分司狂御史。", "欲语还休。", "唤不回头莫著羞。"], "annotations": []}, {"title": "木兰花减字/减字木兰花 和人对雪", "paragraphs": ["清愁叠积。", "更莫迟留春酒逼。", "吹面和风。", "梅信新来一线通。", "危楼晓望。", "雪满群山开画障。", "目断瑶川。", "同凭阑干意几般。"], "annotations": []}, {"title": "木兰花减字/减字木兰花", "paragraphs": ["今年百五。", "风日清明尘不举。", "紫袖红陈。", "三节烟花次第春。", "来舆去马。", "千念一空春事谢。", "白下门东。", "谁见初杨弄晚风。"], "annotations": []}, {"title": "木兰花减字/减字木兰花", "paragraphs": ["匀红点翠。", "取次梳妆谁得似。", "风柳腰肢。", "尽日纤柔属阿谁。", "娇娇小小。", "却是寻春人较老。", "著便休痴。", "付与风流幕下儿。"], "annotations": []}, {"title": "木兰花/玉楼春 汝阴湖上同东坡用六一韵", "paragraphs": ["湖平木落摇空阔。", "叶底流泉鸣复咽。", "酒边清漏往时同，花里朱弦纤手抹。", "风光过手春冰滑。", "十事违人常七八。", "不将白发并黄花，拟下清流揽明月。"], "annotations": []}, {"title": "木兰花/玉楼春 和何大夫", "paragraphs": ["荣光休气天为瑞。", "道祖当天传宝裔。", "千年昌运此时逢，四海欢声今日沸。", "蒙蒙香雾沾衣腻。", "漠漠轻寒梅柳细。", "封人长有祝尧心，从此年年并岁岁。"], "annotations": []}, {"title": "木兰花/玉楼春", "paragraphs": ["阴阴云日江城晚。", "小院回廊春已满。", "谁教言语似鹂黄，深闭玉笼千万怨。", "蓬莱易到人难见。", "香火无凭空有愿。", "不辞歌里断人肠，只怕有肠无处断。"], "annotations": []}, {"title": "西江月 其一 咏酴醾菊", "paragraphs": ["点点轻黄减白，垂垂重露生鲜。", "肌香骨秀月中仙。", "雪满瑶台曳练。", "绰约却宜长见，清真不假馀妍。", "殷勤与插小婵娟。", "要试尊前玉面。"], "annotations": []}, {"title": "西江月 咏丁香菊", "paragraphs": ["浅色千重柔叶，深心一点娇黄。", "只消可意更须香。", "好个风流模样。", "玉蕊今谁攀折，诗人此日凄凉。", "正须蛮素作伊凉。", "与插钗傍鬓上。"], "annotations": []}, {"title": "西江月 其二 咏榴花", "paragraphs": ["叶叶枝枝绿暗，重重密密红滋。", "芳心应恨赏春迟。", "不会春工著意。", "晚照酒生娇面，新妆睡污胭脂。", "凭将双叶寄相思。", "与看钗头何似。"], "annotations": []}, {"title": "西江月 席上劝彭舍人饮", "paragraphs": ["楼上风生白羽，尊前笑出青春。", "破红展翠恰如今。", "把酒如何不饮。", "绣幕灯深绿暗，画帘人语黄昏。", "晚云将雨不成阴。", "竹月风窗弄影。"], "annotations": []}, {"title": "罗敷媚/采桑子 二首和何大夫酴醾菊 其一", "paragraphs": ["春风吹尽秋光照，瘦减初黄。", "改样新妆。", "特地相逢只认香。", "南台九日登临处，不共飞觞。", "镜里伊傍。", "独秀钗头殿众芳。"], "annotations": []}, {"title": "罗敷媚/采桑子 其二", "paragraphs": ["芙蓉不借韶华助，故著缃黄。", "宿面留妆。", "不出寒花只暂香。", "伤春不尽悲秋苦，落蕊浮觞。", "知在谁傍。", "一笑盈盈百种芳。"], "annotations": []}, {"title": "临江仙 送叠罗菊与赵使君", "paragraphs": ["官样初黄过闰九。", "鲜妍时更宜寒。", "挽回人意不成阑。", "香罗堆叶密，芳意著心单。", "过与后房歌舞手，轻盈喜色生颜。", "堕钗拥髻与垂鬟。", "欲知谁称面，遍插一枝看。"], "annotations": []}, {"title": "南乡子 其一 九日用东坡韵", "paragraphs": ["晴野下田收。", "照影寒江落雁洲。", "禅榻茶炉深闭阁，飕飕。", "横雨旁风不到头。", "登览却轻酬。", "剩作新诗报答秋。", "人意自阑花自好，休休。", "今日看时蝶也愁。"], "annotations": []}, {"title": "南乡子 其一", "paragraphs": ["风絮落东邻。", "点缀繁枝旋化尘。", "关锁玉楼巢燕子，冥冥。", "桃李摧残不见春。", "流转到如今。", "翡翠生儿翠作衿。", "花样腰身官样立，婷婷。", "困倚阑干一欠伸。"], "annotations": []}, {"title": "南乡子 其二 咏棣棠菊", "paragraphs": ["乱蕊压枝繁。", "堆积金钱闹作团。", "晚起涂黄仍带酒，看看。", "衣剩腰肢故著单。", "薄瘦却禁寒。", "牵引人心不放阑。", "拟折一枝遮老眼，难难。", "蝶横蜂争只倚阑。"], "annotations": []}, {"title": "南乡子 其二", "paragraphs": ["潮落去帆收。", "沙涨江回旋作洲。", "侧帽独行斜照里，飕飕。", "卷地风前更掉头。", "语妙后难酬。", "回雁峰南未得秋。", "唤取佳人听旧曲，休休。", "瘴雨无花孰与愁。"], "annotations": []}, {"title": "南柯子/南歌子 贺彭舍人黄堂成", "paragraphs": ["故国山河在，新堂冰雪生。", "万家和气贺初成。", "人在笙歌声里、暗生春。", "今代无双士，当年第一人。", "杯行到手莫辞频。", "明日凤池归路、隔清尘。"], "annotations": []}, {"title": "南柯子/南歌子 问王立之督茶", "paragraphs": ["天上云为瑞，人间睡作魔，疏帘清簟汗成河。", "酒醒梦回眵眼、费摩娑。", "但有寒暄问，初无凤鸟过。", "尘生铜碾网生罗。", "一喏十年犹未、意如何。"], "annotations": []}, {"title": "洛阳春", "paragraphs": ["酒到横波娇满。", "和香喷面。", "攀花落雨祝东风，诮不借、周郎便。", "背立腰肢挪捻。", "更须回盼。", "多生不作好因缘，甚只向、尊前见。"], "annotations": []}, {"title": "洛阳春", "paragraphs": ["素手拈花纤软。", "生香相乱。", "却须诗力与丹青，恐俗手、难成染。", "一顾教人微倩。", "那堪亲见。", "不辞紫袖拂清尘，也要识、春风面。"], "annotations": []}, {"title": "减字木兰花 九日", "paragraphs": ["清尊白发。", "曾是登临年少客。", "不似当年。", "人与黄花两并妍。", "来愁去恨。", "十载相看情不尽。", "莫更思量。", "梦破春回枉断肠。"], "annotations": []}, {"title": "清平乐 二首 其一", "paragraphs": ["秋声隐地。", "叶叶无留意。", "冰簟流光团扇坠。", "惊起双栖燕子。", "夜堂帘合回廊。", "风帏吹乱凝香。", "卧看一庭明月，晓衾不耐初凉。"], "annotations": []}, {"title": "清平乐 二首 其二", "paragraphs": ["休休莫莫。", "更莫思量著。", "记著不如浑忘著。", "百种寻思枉却。", "绣囊锦帐吹香。", "雄蜂雌蝶难双。", "眉上放开春色，眼前怜取新郎。"], "annotations": []}, {"title": "清平乐 并引咏柑子菊", "paragraphs": ["重重叠叠。", "娜袅裙千𫌇。", "时样官黄香百叶。", "一岁相逢两节。", "曲阑绕遍芳丛。", "一枝作意妍秾。", "折得有谁相忆，却须还与秋风。"], "annotations": []}, {"title": "渔家傲 从叔父乞苏州湿红笺", "paragraphs": ["一舸姑苏风雨疾。", "吴笺满载红犹湿。", "色润朝花光触日。", "人未识。", "街南小阮应先得。", "青入柳条初著色。", "溪梅已露春消息。", "拟作新词酬帝力。", "轻落笔。", "黄秦去后无强敌。"], "annotations": []}, {"title": "菩萨蛮 其四", "paragraphs": ["银潢清浅填乌鹊。", "画檐急雨长河落。", "初月未成圆。", "明星惜此筵。", "愁来无断绝。", "岁岁年年别。", "不用泪红滋。", "年年岁岁期。"], "annotations": []}, {"title": "菩萨蛮 寄赵使君", "paragraphs": ["清词丽句前朝曲。", "使君借与灯前读。", "读罢已三更。", "寒窗雨打声。", "应怜诗客老。", "要使情怀好。", "犹有解歌人。", "尊前未得听。"], "annotations": []}, {"title": "菩萨蛮 和彭舍人留别", "paragraphs": ["喧喧车马西郊道。", "临行更觉人情好。", "住有一年情。", "去留千载名。", "离歌声欲尽。", "只作常时听。", "天上玉堂东。", "阳春是梦中。"], "annotations": []}, {"title": "菩萨蛮 其二", "paragraphs": ["东飞乌鹊西飞燕。", "盈盈一水经年见。", "急雨洗香车。", "天回河汉斜。", "离愁千载上。", "相远长相望。", "终不似人间。", "回头万里山。"], "annotations": []}, {"title": "菩萨蛮 其一 七夕", "paragraphs": ["行云过尽星河烂。", "炉烟未断蛛丝满。", "想得两眉颦。", "停针忆远人。", "河桥知有路。", "不解留郎住。", "天上隔年期。", "人间长别离。"], "annotations": []}, {"title": "菩萨蛮 佳人", "paragraphs": ["晓来误入桃源洞。", "恰见佳人春睡重。", "玉腕枕香腮。", "荷花藕上开。", "一扇俄惊起。", "敛黛凝秋水。", "笑倩整金衣。", "问郎来几时。"], "annotations": []}, {"title": "满庭芳 咏茶", "paragraphs": ["闽岭先春，琅函联璧，帝所分落人间。", "绮窗纤手，一缕破双团。", "云里游龙舞凤，香雾起、飞月轮边。", "华堂静，松风竹雪，金鼎沸湲潺。", "门阑。", "车马动，扶黄籍白，小袖高鬟。", "渐胸里轮囷，肺腑生寒。", "唤起谪仙醉倒，翻湖海、倾泻涛澜。", "笙歌散，风帘月幕，禅榻鬓丝斑。"], "annotations": []}, {"title": "虞美人 席上赠王提刑", "paragraphs": ["城南观阁连云起。", "形像丹青里。", "使君笳鼓渡江来。", "尽带江南春色、放春回。", "青春欲住风催去。", "流水花无数。", "尊前触目一番新。", "只有玉楼明月、记游人。"], "annotations": []}, {"title": "蝶恋花 送彭舍人罢徐", "paragraphs": ["九里山前千里路。", "流水无情，只送行人去。", "路转河回寒日暮。", "连峰不许重回顾。", "水解随人花却住。", "衾冷香销，但有残妆污。", "泪入长江空几许。", "双洪一抹无寻处。"], "annotations": []}, {"title": "踏莎行 其十二", "paragraphs": ["红上花梢，风传梅信。", "青春欲动群芳竞。", "林声鸟语带馀寒，江光野色开游径。", "乍雨还晴，暄寒不定。", "重门深院帘帷静。", "又还日日唤愁生，到谁准拟风流病。"], "annotations": []}, {"title": "南乡子", "paragraphs": ["风絮落东邻。", "点缀繁枝旋化尘。", "关锁玉楼巢燕子，冥冥。", "桃李摧残不见春。", "流转到如今。", "翡翠生儿翠作衿。", "花样腰身官样立，婷婷。", "困倚阑干一欠伸。", "潮落去帆收。", "沙涨江回旋作洲。", "侧帽独行斜照里，飕飕。", "卷地风前更掉头。", "语妙后难酬。", "回雁峰南未得秋。", "唤取佳人听旧曲，休休。", "瘴雨无花孰与愁。"], "annotations": []}, {"title": "清平乐 二首", "paragraphs": ["秋声隐地。", "叶叶无留意。", "冰簟流光团扇坠。", "惊起双栖燕子。", "夜堂帘合回廊。", "风帏吹乱凝香。", "卧看一庭明月，晓衾不耐初凉。", "休休莫莫。", "更莫思量著。", "记著不如浑忘著。", "百种寻思枉却。", "绣囊锦帐吹香。", "雄蜂雌蝶难双。", "眉上放开春色，眼前怜取新郎。"], "annotations": []}, {"title": "卜算子", "paragraphs": ["摇风影似凝，带雪香如抱。", "开尽南枝到北枝，不道春将老。", "飘飖姑射仙，谁识冰肌好。", "会有青绫梦觉人，可爱池塘草。", "绣幕罩梅花，莫放清香透。", "鉴里朱颜岁岁移，只道花依旧。", "把酒问梅花，知我离情否。", "若使梅花知我时，料得花须瘦。", "雪暗岭头云，竹冷溪边树。", "还似潇湘缥缈人，玉骨笼香雾。", "月下幽香度。", "梦里香魂驻。", "回首南枝酒半醺，寂寞无寻处。"], "annotations": []}, {"title": "卜算子", "paragraphs": ["纤软小腰身，明秀天真面。", "淡画修眉小作春，中有相思怨。", "背立向人羞，颜破因谁倩。", "不比阳台梦里逢，亲向尊前见。", "梅岭数枝春，疏影斜临水。", "不借芳华只自香，娇面长如洗。", "还把最繁枝，过与偏怜底。", "试傍鸾台仔细看，何似丹青里。"], "annotations": []}]}