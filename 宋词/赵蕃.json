{"dynasty": "宋", "author": "赵蕃", "author_desc": "", "works": [{"title": "小重山 寄刘叔通先生序云：小重山一阕，传", "paragraphs": ["何地无溪祗欠人。", "有翁年八十，住其滨。", "直钩元不事丝缗。", "优游尔，聊以遂吾身。", "陶令赋归辰。", "未尝轻出入，犯风尘。", "江洲太守独情亲。", "庐山醉，谁主复谁宾。"], "annotations": [], "rhythmic": "小重山"}, {"title": "菩萨蛮 送游季仙归东阳", "paragraphs": ["鸡声茅店饮残月。", "板桥人迹霜如雪。", "此是古人诗。", "身经老忘之。", "君行当此境。", "令我昏成醒。", "乘月犯霜来。", "诗真误尔哉。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "失调名", "paragraphs": ["春浦雪，涧泉梅。"], "annotations": [], "rhythmic": "失调名"}, {"title": "渔父", "paragraphs": ["自得江湖乐，信无朝市求。", "扁舟载妻子，没齿是春秋。", "见客如成愕，问鱼多掉头。", "严陵疑可亚，范蠡岂其流。"], "annotations": []}]}