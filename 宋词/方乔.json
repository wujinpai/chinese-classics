{"dynasty": "宋", "author": "方乔", "author_desc": "", "works": [{"title": "菩萨蛮 玉楼春 答紫竹", "paragraphs": ["绿阴扑地莺声近。", "柳絮如绵烟草衬。", "双鬟玉面碧窗人。", "一纸银钩青鸟信。", "佳期远卜清秋夜。", "桐树梢头明月挂。", "天公若解此情深，此岁何须三月夏。"], "annotations": []}, {"title": "菩萨蛮 复答紫竹", "paragraphs": ["秋风即拟同衾枕。", "春归依旧成孤寝。", "爽约不思量。", "翻言要打郎。", "鸳鸯如共耍。", "玉手何辞打。", "若再负佳期。", "还应我打伊。"], "annotations": []}]}