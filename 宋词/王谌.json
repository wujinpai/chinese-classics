{"dynasty": "宋", "author": "王谌", "author_desc": "", "works": [{"title": "渔父词・渔父", "paragraphs": ["兰芷流来水亦香。", "满汀鸥鹭动斜阳。", "声诶乃，间鸣榔。", "侬家只合岸西旁。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["翁妪齐眉妇亦贤。", "小姑颜貌正笄年。", "头发乱，髻鬟偏。", "爱把花枝立舵前。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["湘妃泪染竹痕斑。", "风雨连朝下钓难。", "春浪急，石矶寒。", "买得茅柴味亦酸。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["满湖飞雪搅长空。", "急起呼儿上短蓬。", "箬笠具，画图同。", "铁笛声长曲未终。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["离骚读罢怨声声。", "曾向江边问屈平。", "醒还醉，醉还醒。", "笑指沧浪可濯缨。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["白发髼松不记年。", "扁舟泊在荻花边。", "天上月，水中天。", "夜夜烟波得意眠。"], "annotations": [], "rhythmic": "渔父词・渔父"}, {"title": "渔父词・渔父", "paragraphs": ["只在青山可卜邻。", "妻儿笑语意全真。", "休识字，莫嫌贫。", "方是安闲第一人。"], "annotations": [], "rhythmic": "渔父词・渔父"}]}