{"dynasty": "宋", "author": "谭宣子", "author_desc": "", "works": [{"title": "摸鱼儿", "paragraphs": ["掩朱弦、住听金缕。", "天涯同是羁旅。", "多情记把香罗袖，残粉半粘荆树。", "还信否。", "便忍道、石台暗寂春无主。", "分明间阻。", "那睡鸭嘘云，翔鸳溜月，此际更休语。", "人间世，谁识缄愁最苦。", "轻帆重解烟雨。", "而今翻笑周郎误。", "挑剔寒缸寻谱。", "游倦处。", "果因甚、亭亭瘦影如前度。", "无由寄与。", "待谢却梅花，东风为我，吹梦过淮浦。"], "annotations": [], "rhythmic": "摸鱼儿"}, {"title": "西窗烛", "paragraphs": ["春江骤涨，晓陌微干，断云如梦相逐。", "料应怪我频来去，似千里迢遥，伤心极目。", "为楚腰、惯舞东风，芳草萋萋衬绿。", "燕飞独。", "知是谁家箫声多事，吹咽寻常怨曲。", "尽教衿袖香泥涴，君不见、扬州三生杜牧。", "待泪华、暗落铜盘，甚夜西窗剪烛。"], "annotations": [], "rhythmic": "西窗烛"}, {"title": "侧犯", "paragraphs": ["素秋渐爽，倚香曲枕情依旧。", "怀袖。", "浸数尺湘漪、簟纹皱。", "悲欢尽梦里，玉骨从消瘦。", "空又。", "思太液芙蓉未央柳。", "翔凤何在，乐府传孤奏。", "人病酒。", "有鸳鸯双字倩谁绣。", "拜月西楼，几声滴漏。", "应恐纨洁，已疏郎手。"], "annotations": [], "rhythmic": "侧犯"}, {"title": "春声碎", "paragraphs": ["津馆贮轻寒，脉脉离情如水。", "东风不管，垂杨无力，总雨颦烟寐。", "栏干外。", "怕春燕掠天，疏鼓叠、春声碎。", "刘郎易憔悴。", "况是恹恹病起。", "蛮笺漫展，便写就新词，倩谁将寄。", "当此际。", "浑似梦峡啼湘，一寸相思千里。"], "annotations": [], "rhythmic": "春声碎"}, {"title": "长相思", "paragraphs": ["去路遥。", "归路遥。", "灯月光中立小桥。", "魂萦紫玉箫。", "风萧萧。", "雨萧萧。", "此夜相思空寂寥。", "梅花落丽谯。"], "annotations": [], "rhythmic": "长相思"}, {"title": "长相思", "paragraphs": ["净亭亭。", "步盈盈。", "蝉影明绡傅体轻。", "水边无限情。", "翠尊倾。", "翠环倾。", "归去如何睡得成。", "西风吹酒醒。"], "annotations": [], "rhythmic": "长相思"}, {"title": "谒金门", "paragraphs": ["银漏滴。", "午夜平康巷陌。", "双掩兽环人语寂。", "馀香无处觅。", "回首旧游踪迹。", "绀碧染衣犹湿。", "一饷沉吟谁会得。", "月明春店笛。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门", "paragraphs": ["人病酒。", "生怕日高催绣。", "昨夜新翻花样瘦。", "旋描双蝶凑。", "闲凭绣床呵手。", "却说春愁还又。", "门外东风吹绽柳。", "海棠花厮勾。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "浣溪沙", "paragraphs": ["欲展吴笺咏杜娘。", "为停楚棹觅秦郎。", "藕花三十六湖香。", "珠颗翠檠饶宿泪，玉痕红退怯晨妆。", "小桥风月思凄凉。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "玲珑四犯", "paragraphs": ["碧黯塞榆，黄销堤柳，危栏谁料重抚。", "才情犹未减，指点惊如许。", "当时共伊东顾。", "为辞家、怕吟鹦鹉。", "衮衮波光，悠悠云气，陶写几今古。", "生尘每怜微步。", "渺江空岁晚，知在何处。", "土花封玉树。", "恨极山阳赋。", "吹芗扇底馀欢断，怎忘得、阴移庭午。", "离别苦。", "那堪听、敲窗冻雨。"], "annotations": [], "rhythmic": "玲珑四犯"}, {"title": "鸣梭", "paragraphs": ["织绡机上度鸣梭。", "年光容易过。", "萦