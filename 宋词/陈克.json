{"dynasty": "宋", "author": "陈克", "author_desc": "", "works": [{"title": "西江月", "paragraphs": ["捣玉扬珠万户，膴眉高髻千峰。", "佳辰清寿黑头公，老稚扶携欢动。", "借问优游黄倚，何如强健夔龙。", "斝舡一棹百分空，浇泼胸中云梦。"], "annotations": [], "rhythmic": "西江月"}, {"title": "鹧鸪天", "paragraphs": ["风露绢绢玉井莲，霓旌绛节会中元。", "鬓头未学功名晚，金紫由来称长年。", "青作穗，酒如泉。", "蓬莱方丈自飞仙。", "黄麻敕胜长生箓，早送夔龙到日边。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "南歌子", "paragraphs": ["凤斝飞醇酎，龙筵喷异香。", "又还仁还祝延长。", "正对金风玉露、爽秋光。", "一种庄椿老，五杸仙桂芳。", "当年天产窦家郎。", "须信来春同此、赋高唐。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子", "paragraphs": ["爱日烘晴昼，轻寒护晓霜。", "小春庭院绕天香。", "仙风珊珊来自、五云乡。", "庭下芝兰秀，壶中日月长。", "要看发绿与瞳方。", "一笑人间千岁、饮淋浪。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "临江仙 其一", "paragraphs": ["枕帐依依残梦，斋房忽忽馀酲。", "薄衣团扇绕阶行。", "曲阑幽树，看得绿成阴。", "檐雨为谁凝咽，林花似我飘零。", "微吟休作断肠声。", "流莺百啭，解道此时情。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "临江仙 其二", "paragraphs": ["四海十年兵不解，胡尘直到江城。", "岁华销尽客心惊。", "疏髯浑似雪，衰涕欲生冰。", "送老齑盐何处是，我缘应在吴兴。", "故人相望若为情。", "别愁深夜雨，孤影小窗灯。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "渔家傲", "paragraphs": ["宝瑟尘生郎去后。", "绿窗闲却春风手。", "浅色宫罗新染就。", "晴时后。", "裁缝细意花枝斗。", "象尺熏炉移永昼。", "粉涩浥浥蔷薇透。", "晚景看来浑似旧。", "沈吟久。", "个侬争得知人瘦。"], "annotations": [], "rhythmic": "渔家傲"}, {"title": "浣溪沙", "paragraphs": ["浅画香膏拂紫绵。", "牡丹花重翠云偏。", "手挼梅子并郎肩。", "病起心情终是怯，困来模样不禁怜。", "旋移针线小窗前。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其二", "paragraphs": ["香雾空蒙堕彩蟾。", "倾城催映出重帘。", "□□银烛夜厌厌。", "何物与侬供醉眼，半黄梅子带红盐。", "粉融香润玉纤纤。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其三", "paragraphs": ["淡墨花枝掩薄罗。", "嫩蓝裙子窣湘波。", "水晶新样碾风荷。", "问著似羞还似恶，恼来成笑不成歌。", "芙蓉帐里奈君何。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其四", "paragraphs": ["短烛荧荧照碧窗。", "重重帘幕护梨霜。", "幽欢不怕夜偏长。", "罗袜钿钗红粉醉，曲屏深幔绿橙香。", "征鸿离远断人肠。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其五", "paragraphs": ["小院春来百草青。", "拂墙桃李已飘零。", "绝知春意总无凭。", "卢女嫁时终薄命，徐娘身老谩多情。", "洗香吹粉转娉婷。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其六", "paragraphs": ["窗纸幽幽不肯明。", "寒更忍作断肠声。", "背人残烛却多情。", "合下心期唯有梦，如今魂梦也无凭。", "几行闲泪莫纵横。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "摊破浣溪沙・山花子", "paragraphs": ["□慢梳头浅画眉。", "乱莺残梦起多时。", "不道小庭花露湿，翦酴醿。", "帘额好风低燕子，窗油晴日打蜂儿。", "翠袖粉笺闲弄笔，写新诗。"], "annotations": [], "rhythmic": "摊破浣溪沙・山花子"}, {"title": "谒金门 其一", "paragraphs": ["花满院。", "飞去飞来双燕。", "红雨入帘寒不卷。", "晓屏山六扇。", "翠袖玉笙凄断。", "脉脉两娥愁浅。", "消息不知郎近远。", "一春长梦见。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其二", "paragraphs": ["柳丝碧。", "柳下人家寒食。", "莺语匆匆花寂寂。", "玉阶春藓湿。", "闲凭薰笼无力。", "心事有谁知得。", "檀炷绕窗灯背壁。", "画檐残雨滴。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其三", "paragraphs": ["深院静。", "尘暗曲房凄冷。", "黄叶满阶风不定。", "无端吹酒醒。", "露湿小园幽径。", "悄悄啼姑相应。", "半被馀熏残烛影。", "夜长人独冷。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门", "paragraphs": ["春漏促。", "谁见两人心曲。", "罨画屏风银蜡烛。", "泪珠红蔌蔌。", "懊恼欢娱不足。", "只许梦中相逐。", "今夜月明何处宿。", "画桥春水绿。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其五", "paragraphs": ["春草碧。", "忆著去年寒食。", "白纻红裙香□□，折花闹调客。", "好在江南江北。", "燕子不传消息。", "醉眼腾腾羞面赤。", "断肠侬记得。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其六", "paragraphs": ["罗帐薄。", "缥缈绮疏飞阁。", "红地团花金解络。", "香囊垂四角。", "尽日春风帘幕。", "谁见绿屏纤弱。", "云压枕函钗自落。", "无端春梦恶。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其七", "paragraphs": ["愁脉脉。", "目断江南江北。", "烟树重重芳信隔。", "小楼山几尺。", "细草孤云斜日。", "一向弄晴天色。", "帘外落花飞不得。", "东风无气力。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "谒金门 其八", "paragraphs": ["春寂寂。", "绿暗溪南溪北。", "溪水沈沈天一色。", "鸟飞春树黑。", "肠断小楼吹笛，醉里看朱成碧。", "愁满眼前遮不得。", "可怜双鬓白。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "虞美人 其一 张宰祈雨有感", "paragraphs": ["踏车不用青裙女。", "日夜歌声苦。", "风流墨绶强跻攀。", "唤起潜蛟飞舞、破天悭。", "公庭休更重门掩。", "细听催诗点。", "一尊已咏北窗风。", "卧看雪儿纤手、剥莲蓬。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "虞美人 其二", "paragraphs": ["小山戢戢盆池浅。", "芳树阴阴转。", "红阑干上刺蔷薇。", "蝴蝶飞来飞去、两三枝。", "绣裙斜立腰肢困。", "翠黛萦新恨。", "风流踪迹使人猜。", "过了斗鸡时节、合归来。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "虞美人 其三", "paragraphs": ["绿阴满院帘垂地。", "落絮萦香砌。", "池光不定药栏低。", "闲并一双㶉𫛶、没人时。", "旧欢黯黯成幽梦。", "帐卷金泥重。", "日虹斜处暗尘飞。", "脉脉小窗孤枕、镜花移。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "菩萨蛮 其一", "paragraphs": ["柳条窣窣闲庭院。", "锦波绣浪春风转。", "红日上阑干。", "晚来花更寒。", "绿檀金隐起。", "翠被香烟里。", "幽恨有谁知。", "空梁落燕泥。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮 其二", "paragraphs": ["赤阑桥尽香街直。", "笼街细柳娇无力。", "金碧上青空。", "花晴帘影红。", "黄衫飞白马。", "日日青楼下。", "醉眼不逢人。", "午香吹暗尘。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮 其三", "paragraphs": ["池塘淡淡浮㶉𫛶。", "杏花吹尽垂杨碧。", "天气度清明。", "小园新雨晴。", "绿窗描绣罢。", "笑语酴醿下。", "围坐赌青梅。", "困从双脸来。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮 其四", "paragraphs": ["绿芜墙绕青苔院。", "中庭日淡芭蕉卷。", "蝴蝶上阶飞。", "烘帘自在垂。", "玉钩双语燕。", "宝甃杨花转。", "几处簸钱声。", "绿窗春睡轻。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮 其五", "paragraphs": ["柳条到地莺声滑。", "鸳鸯睡稳清沟阔。", "九曲转朱阑。", "花深人对闲。", "日长刀尺罢。", "试屐樱桃下。", "䰉髻玉钗风。", "云轻线脚红。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "菩萨蛮 其六", "paragraphs": ["绿阴寂寂樱桃下。", "盆池劣照蔷薇架。", "帘影假山前。", "映阶红叶翻。", "芭蕉笼碧砌。", "猧子中庭睡。", "香径没人来。", "拂墙花又开。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "点绛唇", "paragraphs": ["曲陌春风，谁家姊妹同墙看。", "映花烘暖。", "困入茸茸眼。", "细马轻衫，倚醉偷回面。", "垂杨转。", "坠鞭挥扇。", "白地肝肠断。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "好事近 石亭探梅", "paragraphs": ["寻遍石亭春，黯黯暮山明灭。", "竹外小溪深处，倚一枝寒月。", "淡云疏雨苦无情，得折便须折。", "醉帽凤鬟归去，有馀香愁绝。"], "annotations": [], "rhythmic": "好事近"}, {"title": "千秋岁", "paragraphs": ["柏舟高躅。", "晚岁宜遐福。", "门户壮，疏汤沐。", "青袍围白发。", "端锦缥犀轴。", "仙桂长，交柯却映蟠桃熟。", "缥缈长江曲。", "入破□箫逐。", "香雾满，飞华屋。", "玉钩凉月挂，冰麝芙蓉馥。", "千万寿，酒中倒卧南山绿。"], "annotations": [], "rhythmic": "千秋岁"}, {"title": "鹧鸪天 其一", "paragraphs": ["禁瘆馀寒酒半醒。", "蒲萄力软被愁侵。", "鲤鱼不寄江南信，绿尽菖蒲春水深。", "疑梦断，怆离襟。", "重帘复幕静愔愔。", "赤阑干外梨花雨，还是去年寒食心。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天 其二", "paragraphs": ["芳树阴阴脱晚红。", "馀香不断玉钗风。", "簿情夫婿花相似，一片西飞一片东。", "金翡翠，绣芙蓉。", "从教纤媚笑床空。", "揉蓝衫子休无赖，只与离人结短封。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天 其三", "paragraphs": ["小市桥弯更向东。", "便门长记旧相逢。", "踏青会散秋千下，鬓影衣香怯晚风。", "悲往事，向孤鸿。", "断肠肠断旧情浓。", "梨花院落黄茅店，绣被春寒此夜同。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "豆叶黄/忆王孙 其一", "paragraphs": ["粉墙丹柱柳丝中。", "帘箔轻明花影重。", "午醉醒来一面风。", "绿匆匆。", "几颗樱桃叶底红。"], "annotations": [], "rhythmic": "豆叶黄・忆王孙"}, {"title": "豆叶黄/忆王孙 其二", "paragraphs": ["树头初日鹁鸠鸣。", "野店山桥新雨晴。", "短褐无泥竹杖轻。", "水泠泠。", "梅片飞时春草青。"], "annotations": [], "rhythmic": "豆叶黄・忆王孙"}, {"title": "豆叶黄/忆王孙 其三", "paragraphs": ["秋千人散小庭空。", "麝冷灯昏愁杀侬。", "独有闲阶两袖风。", "月胧胧。", "一树梨花细雨中。"], "annotations": [], "rhythmic": "豆叶黄・忆王孙"}, {"title": "鹧鸪天 阳羡竞渡", "paragraphs": ["柳外东风不满旗。", "青裾白面出疏篱。", "㬠来打鼓侬吹笛，催送儿郎踏浪飞。", "倾两耳，斗双螭。", "家家春酒泻尖泥。", "侬今已是沧浪客，莫向尊前唱教池。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "浣溪沙", "paragraphs": ["罨画溪头春水生。", "铜官山外夕阳明。", "暖风无力小舟横。", "万事悠悠生处熟，三杯兀兀醉时醒。", "杏花杨柳更多情。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "浣溪沙 其二 阳羡上元", "paragraphs": ["桥北桥南新雨晴。", "柳边花底暮寒轻。", "万家灯火照溪明。", "凫舄差池官事了，木山彩错市人惊。", "街头酒贱唱歌声。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "减字木兰花 子寿母", "paragraphs": ["阆风玄圃。", "阳羡溪头山好处。", "郁郁葱葱。", "胜日尊罍笑语中。", "十分芳酒。", "鹤发初生千万寿。", "乐事年年。", "弟劝兄酬阿母前。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "临江仙 秋夜怀人", "paragraphs": ["老屋风悲脱叶，枯城月破浮烟。", "谁人惨惨把忧端。", "蛮歌犯星起，重觉在天边。", "秋色巧摧愁鬓，夜寒偏著诗肩。", "不知桂影为谁圆。", "何须照床里，终是一人眠。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "清平乐 怀人", "paragraphs": ["枕边清血。", "梦好离肠切。", "笑倚柳条同挽结。", "满眼河桥烟月。", "莺啼新晓璁珑。", "罗窗寂寞春空。", "只许梦魂相近，此生枉是相逢。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "鹧鸪天 寄友人", "paragraphs": ["白苎吴侬红颊儿。", "行歌半是使君诗。", "山茶处处春犹浅，灯市人人夜不归。", "拚剧饮，莫相违。", "皇恩往往下丹墀。", "挥毫却对莲花炬，忆著苹洲秉烛时。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "南歌子 其一 毛翰林席上", "paragraphs": ["午夜添红蜡，分曹立翠娥。", "觥筹寂寂断经过。", "谁料绮丛香里、是银河。", "老去空髯戟，愁来奈脸波。", "一杯如此断肠何。", "枉杀两人心事、只闻歌。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子", "paragraphs": ["献鲤荣今日，凭熊瑞此邦。", "年年寿酒乐城隍。", "共道使君椿树、似甘棠。", "歌舞重城晓，从容燕席凉。", "不须苏合与都梁。", "风外荷花无数、是炉香。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子 其三", "paragraphs": ["北固烟中寺，西津雨后山。", "看公英气两眉间。", "如在林霏、江月袭人寒。", "展翼声名久，占熊福艾全。", "风流不是地行仙。", "好去鞭笞鸾凤、紫微天。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子 其四", "paragraphs": ["云里千山暖，溪头八月凉。", "华簪霭霭待萱堂。", "羡子怀中双橘、半青黄。", "老去齐眉案，闲来坦腹床。", "相如何日从长杨。", "惭愧年年高会、索槟榔。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子 其五", "paragraphs": ["胜日萱庭小，西风橘柚长。", "天怜扇枕彩衣郎。", "乞与淡云纤月、十分凉。", "潋滟三危雾，氤氲百濯香。", "年来椿树更苍苍。", "不用蓝桥辛苦、捣玄霜。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子 其六", "paragraphs": ["画幛经梅润，罗衣尚麦寒。", "古苔苍石绿句栏。", "帘外映花新竹、两三竿。", "蠢蠢吴蚕卧，娉娉楚女闲。", "红阴角子共尝酸。", "肠断个侬憨态、小眉弯。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "南歌子 其七", "paragraphs": ["看月凭肩枨，娇春枕臂眠。", "不尽花絮夜来寒。", "帐底浓香残梦、更缠绵。", "起晚笼莺怪，妆迟绣伴牵。", "声声催唤药栏边。", "整髻收裙无力、上秋千。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "虞美人 曹申甫以著色山水小景作短制，思极萧散，方倅袭明邀予为咏", "paragraphs": ["越罗巧画春山叠。", "个里融香雪。", "满身空翠不胜寒。", "恰似那回偷印、小眉山。", "青骢油壁西陵下。", "仿佛当时话。", "而今眼底是高唐。", "拂拂淡云疏雨、断人肠。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "南歌子 其一", "paragraphs": ["凤斝飞醇酎，龙筵喷异香。", "又还仁还祝延长。", "正对金风玉露、爽秋光。", "一种庄椿老，五仙桂芳。", "当年天产窦家郎。", "须信来春同此、赋高唐。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["柳条窣窣闲庭院。", "锦波绣浪春风转。", "红日上阑干。", "晚来花更寒。", "绿檀金隐起。", "翠被香烟里。", "幽恨有谁知。", "空梁落燕泥。", "赤阑桥尽香街直，笼街细柳娇无力。", "金碧上青空，花晴帘影红。", "黄衫飞白马，日日青楼下。", "醉眼不逢人，午香吹暗尘。", "池塘淡淡浮㶉𫛶。", "杏花吹尽垂杨碧。", "天气度清明。", "小园新雨晴。", "绿窗描绣罢。", "笑语酴醾下。", "围坐赌青梅。", "困从双脸来。", "绿芜墙绕青苔院。", "中庭日淡芭蕉卷。", "蝴蝶上阶飞。", "烘帘自在垂。", "玉钩双语燕。", "宝甃杨花转。", "几处簸钱声。", "绿窗春睡轻。", "柳条到地莺声滑。", "鸳鸯睡稳清沟阔。", "九曲转朱阑。", "花深人对闲。", "日长刀尺罢。", "试屐樱桃下。", "䰉髻玉钗风。", "云轻线脚红。", "绿阴寂寂樱桃下。", "盆池劣照蔷薇架。", "帘影假山前。", "映阶红叶翻。", "芭蕉笼碧砌。", "猧子中庭睡。", "香径没人来。", "拂墙花又开。"], "annotations": []}, {"title": "鹧鸪天", "paragraphs": ["禁瘆馀寒酒半醒。", "蒲萄力软被愁侵。", "鲤鱼不寄江南信，绿尽菖蒲春水深。", "疑梦断，怆离襟。", "重帘复幕静愔愔。", "赤阑干外梨花雨，还是去年寒食心。", "芳树阴阴脱晚红。", "馀香不断玉钗风。", "薄情夫婿花相似，一片西飞一片东。", "金翡翠，绣芙蓉。", "从教纤媚笑床空。", "揉蓝衫子休无赖，只与离人结短封。", "小市桥弯更向东。", "便门长记旧相逢。", "踏青会散秋千下，鬓影衣香怯晚风。", "悲往事，向孤鸿。", "断肠肠断旧情浓。", "梨花院落黄茅店，绣被春寒此夜同。"], "annotations": []}, {"title": "南歌子", "paragraphs": ["凤斝飞醇酎，龙筵喷异香。", "又还仁还祝延长。", "正对金风玉露、爽秋光。", "一种庄椿老，五仙桂芳。", "当年天产窦家郎。", "须信来春同此、赋高唐。", "北固烟中寺，西津雨后山。", "看公英气两眉间。", "如在林霏、江月袭人寒。", "展骥声名久，占熊福艾全。", "风流不是地行仙。", "好去鞭笞鸾凤、紫微天。", "云里千山暖，溪头八月凉。", "华簪霭霭待萱堂。", "羡子怀中双橘、半青黄。", "老去齐眉案，闲来坦腹床。", "相如何日从长杨。", "惭愧年年高会、索槟榔。", "胜日萱庭小，西风橘柚长。", "天怜扇枕彩衣郎。", "乞与淡云纤月、十分凉。", "潋滟三危雾，氤氲百濯香。", "年来椿树更苍苍。", "不用蓝桥辛苦、捣玄霜。", "画幛经梅润，罗衣尚麦寒。", "古苔苍石绿句栏。", "帘外映花新竹、两三竿。", "蠢蠢吴蚕卧，娉娉楚女闲。", "红阴角子共尝酸。", "肠断个侬憨态、小眉弯。", "看月凭肩枨，娇春枕臂眠。", "不禁花絮夜来寒。", "帐底浓香残梦、更缠绵。", "起晚笼莺怪，妆迟绣伴牵。", "声声催唤药栏边。", "整髻收裙无力、上秋千。"], "annotations": []}, {"title": "豆叶黄/忆王孙", "paragraphs": ["粉墙丹柱柳丝中。", "帘箔轻明花影重。", "午醉醒来一面风。", "绿匆匆。", "几颗樱桃叶底红。", "树头初日鹁鸠鸣。", "野店山桥新雨晴。", "短褐无泥竹杖轻。", "水泠泠。", "梅片飞时春草青。", "秋千人散小庭空。", "麝冷灯昏愁杀侬。", "独有闲阶两袖风。", "月胧胧。", "一树梨花细雨中。"], "annotations": []}]}