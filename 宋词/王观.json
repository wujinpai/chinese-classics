{"dynasty": "宋", "author": "王观", "author_desc": "", "works": [{"title": "忆黄梅", "paragraphs": ["枝上叶儿未展。", "已有坠红千片。", "春意怎生防，怎不怨。", "被我安排，矮牙床斗帐，和娇艳。", "移在花丛里面。", "请君看。", "惹清香，偎媚暖。", "爱香爱暖金杯满。", "问春怎管。", "大家拼、便做东风，总吹交零乱。", "犹肯自、输我鸳鸯一半。"], "annotations": [], "rhythmic": "忆黄梅"}, {"title": "浪淘沙令", "paragraphs": ["素手水晶盘。", "垒起仙丸。", "红绡剪碎却成团。", "逗得安排金粟遍，何似鸡冠。", "味胜玉浆寒。", "只被宜酸。", "莫将荔子一般看。", "色淡香消僝僽损，才到长安。"], "annotations": [], "rhythmic": "浪淘沙"}, {"title": "天香", "paragraphs": ["霜瓦鸳鸯，风帘翡翠，今年早是寒少。", "矮钉明窗，侧开朱户，断莫乱教人到。", "重阴未解，云共雪、商量不了。", "青帐垂毡要密，红炉收围宜小。", "呵梅弄妆试巧。", "绣罗衣、瑞云芝草。", "伴我语时同语，笑时同笑。", "已被金尊劝倒。", "又唱个新词故相恼。", "尽道穷冬，元来恁好。"], "annotations": [], "rhythmic": "天香"}, {"title": "卜算子 送鲍浩然之浙东", "paragraphs": ["水是眼波横，山是眉峰聚。", "欲问行人去那边，眉眼盈盈处。", "才始送春归，又送君归去。", "若到江东赶上春，千万和春住。"], "annotations": [], "rhythmic": "卜算子"}, {"title": "清平乐 应制", "paragraphs": ["黄金殿里。", "烛影双龙戏。", "劝得官家真个醉。", "进酒犹呼万岁。", "折旋舞彻伊州。", "君恩与整搔头。", "一夜御前宣住，六宫多少人愁。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "雨中花令 夏词", "paragraphs": ["百尺清泉声陆续。", "映潇洒、碧梧翠竹。", "面千步回廊，重重帘幕，小枕敧寒玉。", "试展鲛绡看画轴。", "见一片、潇湘凝绿。", "待玉漏穿花，银河垂地，月上栏干曲。"], "annotations": [], "rhythmic": "雨中花令"}, {"title": "庆清朝慢/庆清朝 踏青", "paragraphs": ["调雨为酥，催冰做水，东君分付春还。", "何人便将轻暖，点破残寒。", "结伴踏青去好，平头鞋子小双鸾。", "烟郊外，望中秀色，如有无间。", "晴则个，阴则个，饾饤得天气，有许多般。", "须教镂花拨柳，争要先看。", "不道吴绫绣袜，香泥斜沁几行斑。", "东风巧，尽收翠绿，吹在眉山。"], "annotations": [], "rhythmic": "庆清朝慢・庆清朝"}, {"title": "清平乐 拟太白应制", "paragraphs": ["宜春小苑。", "处处花开满。", "学得红妆红要浅。", "催上金车要看。", "君王曲宴瑶池。", "小舟掠水如飞。", "夺得锦标归去，匆匆不惜罗衣。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "木兰花令 柳", "paragraphs": ["铜驼陌上新正后。", "第一风流除是柳。", "勾牵春事不如梅，断送离人强似酒。", "东君有意偏撋就。", "惯得腰肢真个瘦。", "阿谁道你不思量，因甚眉头长恁皱。"], "annotations": [], "rhythmic": "木兰花令"}, {"title": "生查子", "paragraphs": ["关山魂梦长，塞雁音书少。", "两鬓可怜青，一夜相思老。", "归傍碧纱窗，说与人人道。", "真个别离难，不似相逢好。"], "annotations": [], "rhythmic": "生查子"}, {"title": "菩萨蛮 归思", "paragraphs": ["单于吹落山头月。", "漫漫江上沙如雪。", "谁唱缕金衣。", "水寒船舫稀。", "芦花枫叶浦。", "忆抱琵琶语。", "身未发长沙。", "梦魂先到家。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "江城梅花引", "paragraphs": ["年年江上见寒梅。", "暗香来。", "为谁开。", "疑是月宫、仙子下瑶台。", "冷艳一枝春在手，故人远，相思寄与谁。", "怨极恨极嗅香蕊。", "念此情，家万里。", "暮霞散绮。", "楚天碧、片片轻飞。", "为我多情，特地点征衣。", "花易飘零人易老，正心碎，那堪塞管吹。"], "annotations": [], "rhythmic": "江城梅花引"}, {"title": "高阳台", "paragraphs": ["红入桃腮，青回柳眼，韶华已破三分。", "人不归来，空教草怨王孙。", "平明几点催花雨，梦半阑、敧枕初闻。", "问东君，因甚将春，老了闲人。", "东郊十里香尘满，旋安排玉勒，整顿雕轮。", "趁取芳时，共寻岛上红云。", "朱衣引马黄金带，算到头、总是虚名。", "莫闲愁，一半悲秋，一半伤春。"], "annotations": [], "rhythmic": "高阳台"}, {"title": "减字木兰花 寿女婿", "paragraphs": ["瑞云仙雾。", "拂晓重重遮绣户。", "一炷清香。", "千尺流霞入寿觞。", "家门转好。", "从此应须长不老。", "来岁春风。", "看拜西枢小令公。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "红芍药", "paragraphs": ["人生百岁，七十稀少。", "更除十年孩童小。", "又十年昏老。", "都来五十载，一半被、睡魔分了。", "那二十五载之中，宁无些个烦恼。", "仔细思量，好追欢及早。", "遇酒追朋笑傲。", "任玉山摧倒。", "沈醉且沈醉，人生似、露垂芳草。", "幸新来、有酒如渑，结千秋歌笑。"], "annotations": [], "rhythmic": "红芍药"}, {"title": "失调名", "paragraphs": ["十三妮子绿窗中。"], "annotations": [], "rhythmic": "失调名"}, {"title": "临江仙 离怀", "paragraphs": ["别岸相逢何草草，扁舟两岸垂杨。", "绣屏珠箔绮香囊。", "酒深歌拍缓，愁入翠眉长。", "燕子归来人去也，此时无奈昏黄。", "桃花应是我心肠。", "不禁微雨，流泪湿红妆。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "减字木兰花", "paragraphs": ["寿星明久。", "寿曲高歌沉醉后。", "寿烛荣煌。", "手把金炉𦶟寿香。", "满斟寿酒。", "我意殷勤来祝寿。", "问寿如何。", "寿比南山福更多。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其二", "paragraphs": ["花筵布巧。", "绿绕红□花枝闹。", "朵朵风流。", "好向尊前插满头。", "此花妖艳。", "愿得年年长相见。", "满劝金锺。", "祝寿如花岁岁红。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其三", "paragraphs": ["天之美禄。", "会饮思量平生福。", "一硕刘伶，五斗将来且解酲。", "百年长解。", "三万六千能几日。", "劝饮瑶觞。", "祝寿不如岁月长。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其四", "paragraphs": ["红牙初展。", "象板如云遮娇面。", "曲按宫商。", "声遏行云绕画梁。", "正当衮遍。", "休唱阳关人肠断。", "劝饮流霞。", "祝寿千年转更加。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其五", "paragraphs": ["多愁早老。", "着甚由来闲烦恼。", "休管浮名。", "安乐身康似宝珍。", "酒逢知己，好向尊前朝日醉。", "满劝瑶觥。", "祝寿如山岁岁青。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其六", "paragraphs": ["今晨佳宴。", "昨夜南极星光现。", "鹤舞青霁，丹凤呈祥瑞气飘。", "仙书来诏。", "绿鬓朱颜长不老。", "满劝香醪。", "祝寿如云转转高。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其七", "paragraphs": ["角声三品。", "银漏更残将欲尽。", "盏盏华筵。", "玉粒琼瓯散又圆。", "知君洪量。", "不用推辞须一上。", "满劝殷勤。", "祝寿如同福禄星。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其八", "paragraphs": ["新秋气肃。", "此时仙翁曾诞育。", "禀赋应遍。", "绿□朱颜似少年。", "阶庭兰玉。", "行见儿孙俱曳绿。", "更祝遐龄。", "愿比壮椿过八千。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其九", "paragraphs": ["百年能几。", "似数巡环无了日。", "有限时光。", "玉兔金鸟晓夜忙。", "幸逢清世。", "最好排筵斟绿蚁。", "满捧金蕉。", "祝寿如松永不凋。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其一", "paragraphs": ["三皇五帝。", "古代英雄闲争气。", "勇猛韩彭。", "十大功劳空有名。", "休谈人我。", "大限催煎如何亸。", "前酌觥舡。", "祝寿如同海月圆。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其十一", "paragraphs": ["春光景媚。", "花褪残红炎天气。", "蝉噪高枝。", "雁叫长空雪乱飞。", "四时如箭。", "八节忙忙频改换。", "满捧金彝。", "祝寿如同海岳齐。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "减字木兰花 其十二", "paragraphs": ["才鸣□鼓。", "曲奏仙音如乐府。", "美似梨园。", "一派箫韶列玳筵。", "使人清耳。", "满尘宾朋皆欢喜。", "劝饮金荷。", "祝寿延长福更多。"], "annotations": [], "rhythmic": "减字木兰花"}]}