{"dynasty": "宋", "author": "朱子厚", "author_desc": "", "works": [{"title": "谒金门", "paragraphs": ["风动竹。", "清遍一窗梅溽。", "闻道小乔乘凤玉。", "仙裳飘雾縠。", "来嫁吾门公瑾叔。", "天上人间愿足。", "浓缭水沉燃宝烛。", "鬓长相对绿。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "菩萨蛮", "paragraphs": ["酴醿浴罢温香玉。", "牡丹睡起歌云绿。", "弹压属东阳。", "留春在庆堂。", "简端新组绶。", "辉映烟岚秀。", "妙曲倩清妍。", "祝君无尽年。"], "annotations": [], "rhythmic": "菩萨蛮"}]}