{"dynasty": "宋", "author": "张抡", "author_desc": "", "works": [{"title": "满庭芳", "paragraphs": ["威彻冰河，兵严玉帐，济时人在壶天。", "妙龄谈笑，图画上凌烟。", "但见勋书鼎鼐，谁知道、名列高仙。", "风云会，钩陈羽卫，绿鬓影貂蝉。", "绵绵。", "流庆远，芝兰秀发，折桂争先。", "占盛一门，文武更双全。", "已饵琼英绛雪，灵龟寿、何止千年。", "年年看，笙歌丛里，金盏倒垂莲。"], "annotations": [], "rhythmic": "满庭芳"}, {"title": "鹧鸪天", "paragraphs": ["鹤驭来从玉席前。", "笑谈勋业照凌烟。", "心游物外都无碍，春在壶中别有天。", "香似雾，酒如泉。", "华堂冰雪映神仙。", "灵椿不老青松健，花里年年醉管弦。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天", "paragraphs": ["彩舞萱堂喜气新。", "年年今日庆生辰。", "碧凝香雾笼清晓，红入桃花媚小春。", "须酩酊，莫逡巡。", "九霞杯冷又重温。", "壶天自是人难老，长拥笙歌醉洞云。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天", "paragraphs": ["五福仙娥月殿来。", "依稀微步彩云随。", "一从别有瑶池宴，不见蟠桃几度开。", "歌宛转，舞徘徊。", "碧梧秋意满池台。", "年年玉露收残暑，长送新凉入寿杯。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天", "paragraphs": ["消息枝头梅子黄。", "两宫恩意酿湖光。", "长庚自是文章瑞，好伴前星烛万方。", "金鸭暖，玉杯香。", "换鹅笔墨醉淋浪。", "只将名字为公祝，便合千秋佐玉皇。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "鹧鸪天", "paragraphs": ["福善天应锡寿祺。", "人生七十古来稀。", "我翁更有椿龄在，馀庆堂前玉树辉。", "传世业，长孙枝。", "捧杯欢见老莱衣。", "一阳渐近门多喜，百禄争迎好事归。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "画堂春", "paragraphs": ["月娥来自广寒宫。", "步摇环珮丁东。", "戏鸾双舞驾天风。", "雪满云空。", "一剪玉梅花小，九霞琼醴杯浓。", "凤箫千载莫匆匆。", "且醉壶中。"], "annotations": [], "rhythmic": "画堂春"}, {"title": "望仙门", "paragraphs": ["玉池波浪碧如鳞。", "露莲新。", "新歌一曲翠眉嚬。", "舞乖裀。", "满酌兰英酒，须知献寿千春。", "太平无事荷君恩，齐唱望仙门。"], "annotations": [], "rhythmic": "望仙门"}, {"title": "望仙门", "paragraphs": ["玉京清漏起微凉。", "好秋光。", "金杯潋滟酌琼浆。", "会仙乡。", "新曲调丝管，新声更飐霓裳。", "博山炉暖泛浓香。", "为寿百千长。"], "annotations": [], "rhythmic": "望仙门"}, {"title": "望仙门", "paragraphs": ["紫微枝上露华浓。", "起秋风。", "管弦声细出帘栊。", "象筵中。", "仙酒斟云液，山歌转绕梁虹。", "此时佳会庆相逢。", "欢醉且从容。"], "annotations": [], "rhythmic": "望仙门"}, {"title": "柳梢青", "paragraphs": ["柳色初匀。", "轻寒似水，纤雨如尘。", "一阵东风，縠绞微皱，碧沼鳞鳞。", "仙娥花月精神。", "奏凤管、鸾丝斗新。", "万岁声中，九霞杯里，长醉芳春。"], "annotations": [], "rhythmic": "柳梢青"}, {"title": "蝶恋花", "paragraphs": ["前日海棠犹未破。", "点点胭脂，染就真珠颗。", "今日重来花下坐。", "乱铺宫锦春无那。", "剩摘繁枝簪几朵。", "痛惜深怜，只恐芳菲过。", "醉倒何妨花底卧。", "不须红袖来扶我。"], "annotations": [], "rhythmic": "蝶恋花"}, {"title": "临江仙", "paragraphs": ["玉宇凉生清禁晓，丹葩色照晴空。", "珊瑚敲碎小玲珑。", "人间无此种，来自广寒宫。", "雕玉阑干深院静，嫣然凝笑西风。", "曲屏须占一枝红。", "且图敧醉枕，香到梦魂中。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "临江仙", "paragraphs": ["闻道彤庭森宝仗，霜风逐雨驱云。", "六龙扶辇下青冥。", "香随鸾扇远，日射赭袍明。", "帘卷天街人隘路，满城喜望清尘。", "欢声催起岭梅春。", "欲知天意好，昨夜月华新。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "西江月", "paragraphs": ["翦就碧云闹叶，刻成紫玉芳心。", "浅春不怕峭寒侵。", "暧彻薰笼瑞锦。", "花里清芬独步，尊前胜韵难禁。", "飞香直到玉杯深。", "消得厌厌痛饮。"], "annotations": [], "rhythmic": "西江月"}, {"title": "朝中措", "paragraphs": ["灯花挑尽夜将阑。", "斜掩小屏山。", "一点凉蟾窥慢，钏敲玉臂生寒。", "起来无绪，炉薰烬冷，桐叶声干。", "都把沈思幽恨，明朝分付眉端。"], "annotations": [], "rhythmic": "朝中措"}, {"title": "烛影摇红", "paragraphs": ["双阙中天，凤楼十二春寒浅。", "去年元夜奉宸游，曾侍瑶池宴。", "玉殿珠帘尽卷。", "拥群仙、蓬壶阆苑。", "五云深处，万烛光中，揭天丝管。", "驰隙流年，恍如一瞬星霜换。", "今宵谁念泣孤臣，回首长安远。", "可是尘缘未断。", "谩惆怅、华胥梦短。", "满怀幽恨，数点寒灯，几声归雁。"], "annotations": [], "rhythmic": "烛影摇红"}, {"title": "浣溪沙", "paragraphs": ["筑室峥嵘占宝峰。", "退朝燕坐万缘空，出尘高志抗冥鸿。", "何日嘉招陪一笑，看君豪饮釂千锺。", "试凭鄙句作先容。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "霜天晓角", "paragraphs": ["晓风摇幕。", "敧枕闻残角。", "霜月可窗寒影，金猊冷、翠衾薄。", "旧恨无处著。", "新愁还又作。", "夜夜单于声里，灯花共、泪珠落。"], "annotations": [], "rhythmic": "霜天晓角"}, {"title": "点绛唇", "paragraphs": ["何处春来，惠风初自东郊至。", "柳条花蕊。", "迤逦争明媚。", "造化难穷，谁晓幽微理。", "都来是。", "自然天地。", "一点冲和气。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["昨夜东风，又还吹遍闲花草。", "翠轻红小。", "触处惊春早。", "草舍茅□，□□□□□。", "谁□□。", "□□丹灶。", "别有阳和□。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["阳气初生，万花潜动根荄暖。", "暗藏芳艳。", "未许东君见。", "恰似温温，铅鼎丹初转。", "功犹浅。", "九回烹炼。", "日月光华满。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["暖日迟迟，乱莺声在垂杨里。", "昼眠惊起。", "花影间铺地。", "试问荣名，何似花前醉。", "陶陶地。", "任他门外。", "车驾喧朝市。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["花满名园，万红千翠交相映。", "画阑幽径。", "行乐迷芳景。", "惟有幽人，不与浮华竞。", "便幽静。", "兴来独饮。", "花下风吹醒。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["春入山家，杖藜独步登严岫。", "野花争秀。", "弄蕊香盈袖。", "对景开怀，莫遣双眉皱。", "春难久。", "乱红飞后。", "留得韶光否。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["气体冲融，四时长在阳春里。", "玉田琼蕊。", "养就灵苗异。", "堪笑□□，□□□□□。", "□□□。", "□□流水。", "半落苍□□。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["乐事难并，少年常恨春宵短。", "万花丛畔。", "只恐金杯浅。", "方喜春来，又叹韶华晚。", "频相劝。", "且闻强健。", "莫厌花经眼。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["一瞬光阴，世人常被芳菲恼。", "玉壶频倒。", "惟恨春归早。", "何似逍遥，物外寻三岛。", "春长好。", "瑞芝瑶草。", "春又何曾老。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "点绛唇", "paragraphs": ["浮世如何，问花何事花无语。", "夜来风雨。", "已送韶华暮。", "念此堪惊，得失休思虑。", "从今去。", "醉乡深处。", "莫管流年度。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "阮郎归", "paragraphs": ["亭亭槐柳午阴圆。", "薰风拂舜弦。", "一轮红日贴中天。", "乾坤如火然。", "观上象，想丹田。", "阳精色正鲜。", "□从炼得体纯全。", "朱颜无岁年。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["欲如臭腐化神奇。", "当观蝉蜕时。", "脱然飞上绿槐枝。", "炎炎昼景□。", "□□□，□如斯。", "□□□□迷。", "灵躯一旦脱□□。", "□□□□归。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["深亭邃馆锁清风。", "榴花芳艳浓。", "阳光染就欲烧空。", "谁能窥化工。", "观物外，喻身中。", "灵砂别有功。", "若将一粒比花容。", "金丹色又红。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["炎天何处可登临。", "须于物外寻。", "松风涧水杂清音。", "空山如弄琴。", "宜散发，称披襟。", "都无烦暑侵。", "莫将城市比山林。", "山林兴味深。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["豪家大厦敞千楹。", "风摇玉柄轻。", "金盆弄水复敲冰。", "热从何处生。", "低草舍，小茅亭。", "如何安此身。", "元来一念静无尘。", "萧然心自清。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["金乌玉兔最无情。", "驱驰不暂停。", "春光才去又朱明。", "年华只暗惊。", "须省悟，莫劳神。", "朱颜不再新。", "灭除妄想养天真。", "管无寒暑侵。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["动时思静暑思寒。", "尘劳扰扰间。", "翻云复雨百千般。", "几时心地闲。", "□□□，□□难。", "将□□□然。", "自然寒暑不相□。", "□□□地仙。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["谁言无处避炎光。", "山中有草堂。", "安然一枕即仙乡。", "竹风穿户凉。", "名不恋，利都忘。", "心闲日自长。", "不须辛苦觅琼浆。", "华池神水香。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "阮郎归", "paragraphs": ["炎炎皦日正当中。", "