{"dynasty": "宋", "author": "苏辙", "author_desc": "", "works": [{"title": "调啸・调笑令", "paragraphs": ["渔父。", "渔父。", "水上微风细雨。", "青蓑黄箬裳衣。", "红酒白鱼暮归。", "暮归、暮归、归暮。", "长笛一声何处。"], "annotations": [], "rhythmic": "调啸・调笑令"}, {"title": "效韦苏州调啸词二首 其二", "paragraphs": ["归雁。", "归雁。", "饮啄江南南岸。", "将飞却下盘桓。", "塞北春来苦寒。", "苦寒。", "苦寒。", "寒苦。", "藻荇欲生且住。"], "annotations": [], "rhythmic": "调啸・调笑令"}, {"title": "水调歌头 徐州中秋", "paragraphs": ["离别一何久，七度过中秋。", "去年东武今夕，明月不胜愁。", "岂意彭城山下，同泛清河古汴，船上载凉州。", "鼓吹助清赏，鸿雁起汀洲。", "坐中客，翠羽帔，紫绮裘。", "素娥无赖，西去曾不为人留。", "今夜清尊对客，明夜孤帆水驿，依旧照离忧。", "但恐同王粲，相对永登楼。"], "annotations": [], "rhythmic": "水调歌头"}, {"title": "渔家傲 和门人祝寿", "paragraphs": ["七十馀年真一梦。", "朝来寿斝儿孙奉。", "忧患已空无复痛。", "心不动。", "此间自有千钧重。", "早岁文章供世用。", "中年禅味疑天纵。", "石塔成时无一缝。", "谁与共。", "人间天上随他送。"], "annotations": [], "rhythmic": "渔家傲"}, {"title": "赤壁怀古", "paragraphs": ["新破荆州得水军，鼓行夏口气如云。", "千艘已共长江崄，百胜安知赤壁焚。", "觜距方强要一斗，君臣已定势三分。", "古来伐国须观衅，意突成功所未闻。"], "annotations": []}]}