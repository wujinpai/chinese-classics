{"dynasty": "宋", "author": "黄时龙", "author_desc": "", "works": [{"title": "浣溪沙", "paragraphs": ["雨歇花梢月正明。", "映帘人静绣灯昏。", "鸳鸯成字便停针。", "笑启玉奁明酒晕，缓寻金叶熨香心。", "一春情绪此时深。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "雨中花令", "paragraphs": ["十四弦声犹未断。", "星月上、西墙一半。", "却手休弹，含情微妒，报道春宵短。", "银烛纱笼须早办。", "不住地、金蕉催劝。", "别院人归，小窗灯静，自把花枝看。"], "annotations": [], "rhythmic": "夜行船"}, {"title": "虞美人", "paragraphs": ["卷帘人出身如燕。", "烛底粉妆明艳。", "羯鼓初催按六么。", "无限春娇都上、舞裙腰。", "画堂深窈亲曾见。", "宛转楚波如怨。", "小立花心曲未终。", "一把柳丝无力、倚东风。"], "annotations": [], "rhythmic": "虞美人"}]}