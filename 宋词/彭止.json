{"dynasty": "宋", "author": "彭止", "author_desc": "", "works": [{"title": "满庭芳 寿平交五十", "paragraphs": ["月闰清秋，时逢诞节，画堂瑞气多多。", "遥瞻南极，瑞彩照盘坡。", "好是年才五十，身当贵、福比山河。", "无些事，方裙短揭，时复自高歌。", "欢娱，当此际，香燃宝鸭，酒酌金荷。", "恣柳腰樱口，左右森罗。", "纵有人人捧拥，争得似、正面嫦娥。", "思量取，朱颜未老，好事莫蹉跎。"], "annotations": [], "rhythmic": "满庭芳"}, {"title": "留春令", "paragraphs": ["夜来小雨三更作。", "近水处、小桃开却。", "玉女向晓掀朱箔。", "似与花枝有约。", "绿池上、柳腰纤弱。", "燕子过、谁家院落。", "春衫试着香罗薄。", "无奈东风太恶。"], "annotations": [], "rhythmic": "留春令"}]}