{"dynasty": "宋", "author": "何", "author_desc": "", "works": [{"title": "失调名", "paragraphs": ["便饶你、漫天索价，待我略地酬伊。"], "annotations": []}, {"title": "采桑子", "paragraphs": ["百花丛里花君子，取信东君。", "取信东君。", "名策花中第一勋。", "结成宝鼎和羹味，多谢东君。", "多谢东君。", "香遍还应号令春。"], "annotations": []}, {"title": "虞美人", "paragraphs": ["分香帕子揉蓝腻。", "欲去殷勤惠。", "重来直待牡丹时。", "只恐花知、知后故开迟。", "别来看尽闲桃李。", "日日阑干倚。", "催花无计问东风。", "梦作一双蝴蝶、绕芳丛。"], "annotations": []}]}