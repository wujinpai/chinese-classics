{"dynasty": "宋", "author": "许棐", "author_desc": "", "works": [{"title": "三台春曲", "paragraphs": ["昨夜微风细雨，今朝薄霁轻寒。", "檐外一声啼鸟，报知花柳平安。"], "annotations": [], "rhythmic": "三台春曲"}, {"title": "三台春曲", "paragraphs": ["春是人间过客，花随春不多时。", "人比花尤易老，那堪终日相思。"], "annotations": [], "rhythmic": "三台春曲"}, {"title": "谒金门", "paragraphs": ["微雨后。", "染得杏腮红透。", "春色好时人却瘦。", "镜寒妆不就。", "柳外一莺啼昼。", "约略情怀中酒。", "困起半弯眉袖。", "髻松簪玉溜。"], "annotations": [], "rhythmic": "谒金门"}, {"title": "鹧鸪天", "paragraphs": ["翠凤金鸾绣欲成。", "沈香亭下款新晴。", "绿随杨柳阴边去，红踏桃花片上行。", "莺意绪，蝶心情。", "一时分付小银筝。", "归来玉醉花柔困，月滤窗纱约半更。"], "annotations": [], "rhythmic": "鹧鸪天"}, {"title": "柳枝・杨柳枝", "paragraphs": ["冷迫春宵一半床。", "懒熏香。", "不如屏里画鸳鸯。", "永成双。", "重叠衾罗犹未暖。", "红烛短。", "明朝春雨足池塘。", "落花忙。"], "annotations": [], "rhythmic": "柳枝・杨柳枝"}, {"title": "小重山", "paragraphs": ["正是拈芳采艳时。", "连朝风雨里，掩朱扉。", "强排春恨剪新词。", "词未就，莺唱缕金衣。", "云薄弄晴晖。", "试穿花迳去，拣双枝。", "紫香红腻著罗衣。", "簪不尽，瓶里顿将归。"], "annotations": [], "rhythmic": "小重山"}, {"title": "满宫春", "paragraphs": ["懒抟香，慵弄粉。", "犹带浅酲微困。", "金鞍何处掠新欢，偷倩燕寻莺问。", "柳供愁，花献恨。", "衮絮猎红成阵。", "碧楼能有几番春，又是一番春尽。"], "annotations": [], "rhythmic": "满宫春"}, {"title": "浣溪沙", "paragraphs": ["欲把香缯暖缬裁。", "玉箱金锁又慵开。", "一杯茶罢上春台。", "方向柳边揉碧缕，又从花畔并红腮。", "不知凝待阿谁来。"], "annotations": [], "rhythmic": "浣溪沙"}, {"title": "更漏子", "paragraphs": ["泪淹红，腮褪粉。", "等得玉销花损。", "羞阮凤，怯筝鸾。", "指寒无好弹。", "一庭雪。", "半窗月。", "又是独眠时节。", "孤枕怨，小屏愁。", "天涯梦里游。"], "annotations": [], "rhythmic": "更漏子"}, {"title": "荷叶杯", "paragraphs": ["鹊踏画檐双噪。", "书到。", "和笑拆封看。", "归程能隔几重山。", "远约数宵间。", "准备绣轮雕辔。", "游戏。", "说与百花知。", "莫教枝上一红飞。", "留伴玉东西。"], "annotations": [], "rhythmic": "荷叶杯"}, {"title": "夜行船", "paragraphs": ["一辔东风留不住。", "离歌断、日斜春暮。", "多事啼莺，妒情飞燕，一路送人归去。", "文君自被琴心误。", "却惆怅、落花飞絮。", "锦字机寒，玉炉烟冷，门外乱山无数。"], "annotations": [], "rhythmic": "夜行船"}, {"title": "应天长", "paragraphs": ["溅紫飘红风又雨。", "一刻韶芳留不住。", "燕吞声，莺谇语。", "待得晴来人已去。", "怯新歌，怜旧舞。", "冷落艳腔芳谱。", "要识此时情绪。", "豆梅酸更苦。"], "annotations": [], "rhythmic": "应天长"}, {"title": "喜迁莺", "paragraphs": ["鸠雨细，燕风斜。", "春悄谢娘家。", "一重帘外即天涯。", "何必暮云遮。", "钏金寒，钗玉冷。", "薄醉欲成还醒。", "一春梳洗不簪花。", "孤负几韶华。"], "annotations": [], "rhythmic": "喜迁莺"}, {"title": "虞美人", "paragraphs": ["杏花窗底人中酒。", "花与人相守。", "帘衣不肯护春寒。", "一声娇嚏两眉攒。", "拥衾眠。", "明朝又有秋千约。", "恐未忺梳掠。", "倩谁传语画楼风。", "略吹丝雨湿春红。", "绊游踪。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "清平乐", "paragraphs": ["凤双鸾偶。", "天上人间有。", "檐玉无声花影瘦。", "夜浅春浓时候。", "别来几度寒宵。", "六桥风月迢迢。", "灯下有谁相伴，一方红湿鲛绡。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "山花子", "paragraphs": ["挼柳揉花旋染衣。", "丝丝红翠扑春辉。", "罗绮丛中无此艳，小西施。", "腰细最便围舞帊，袖寒时复罩香え。", "误点一痕残泪粉，怕人知。"], "annotations": [], "rhythmic": "山花子"}, {"title": "相思引", "paragraphs": ["组绣盈箱锦满机。", "倩谁缝作护花衣。", "恐花飞去，无复上芳枝。", "已恨远山迷望眼，不须更画远山眉。", "正无聊赖，雨外一鸠啼。"], "annotations": [], "rhythmic": "相思引"}, {"title": "画堂春", "paragraphs": ["一绡香暖看灯衣。", "领珠襟翠争辉。", "金球斜亸雪梅枝。", "著带都宜。", "桃艳妆成醉脸，柳娇移上歌眉。", "一轮蟾玉堕花西。", "携手同归。"], "annotations": [], "rhythmic": "画堂春"}, {"title": "相见欢", "paragraphs": ["绣围春水锦笼山。", "冶游天。", "可惜连朝中酒、怯秋千。", "妆楼暖。", "朱帘卷。", "燕斜穿。", "冲落两三花片、镜台边。"], "annotations": [], "rhythmic": "相见欢"}, {"title": "后庭花", "paragraphs": ["一春不识西湖面。", "翠羞红倦。", "雨窗和泪摇湘管。", "意长笺短。", "知心惟有雕梁燕。", "自来相伴。", "东风不管琵琶怨。", "落花吹遍。"], "annotations": [], "rhythmic": "后庭花"}, {"title": "三台春曲 其二", "paragraphs": ["春是人间过客，花随春不多时。", "人比花尤易老，那堪终日相思。"], "annotations": []}, {"title": "三台春曲 其一", "paragraphs": ["昨夜微风细雨，今朝薄霁轻寒。", "檐外一声啼鸟，报知花柳平安。"], "annotations": []}, {"title": "伤春曲", "paragraphs": ["日日望郎郎未归，玉肌宽尽缕金衣。", "春心撩乱强拘束，碎剪红绡补旧枝。", "红绡才向枝头住，残花又逐东风去。", "愿花飞入笑筵中，莫入愁人断肠处。", "愁人见花人自羞，花见愁人花也愁。", "花飞有尽愁无尽，柳外一声黄栗留。"], "annotations": []}, {"title": "三台春曲", "paragraphs": ["昨夜微风细雨，今朝薄霁轻寒。", "檐外一声啼鸟，报知花柳平安。", "春是人间过客，花随春不多时。", "人比花尤易老，那堪终日相思。"], "annotations": []}]}