{"dynasty": "宋", "author": "李德载", "author_desc": "", "works": [{"title": "眼儿媚", "paragraphs": ["雪儿魂在水云乡。", "犹忆学梅妆。", "玻璃枝上，体薰山麝，色带飞霜。", "水边竹外愁多少，不断俗人肠。", "如何伴我，黄昏携手，步月斜廊。"], "annotations": [], "rhythmic": "眼儿媚"}, {"title": "早梅芳近・早梅芳", "paragraphs": ["深院静，小阑傍。", "标致不寻常。", "尽他桃杏占风光。", "谁敢斗新妆。", "玉堂中，梁苑里。", "休把雪来轻比。", "莫吹长笛巧催残。", "留取月中看。"], "annotations": [], "rhythmic": "早梅芳近・早梅芳"}, {"title": "早梅芳近・早梅芳", "paragraphs": ["残腊里，早梅芳。", "春信报新阳。", "晓来枝上斗寒光。", "轻点寿阳妆。", "雪难欺，霜莫妒。", "别是一般风措。", "望林人意正夭饶。", "又看长新条。"], "annotations": [], "rhythmic": "早梅芳近・早梅芳"}]}