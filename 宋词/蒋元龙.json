{"dynasty": "宋", "author": "蒋元龙", "author_desc": "", "works": [{"title": "好事近", "paragraphs": ["叶暗乳鸦啼，风定老红犹落。", "蝴蝶不随春去，入薰风池阁。", "休歌金缕劝金卮，酒病煞如昨。", "帘卷日长人静，任杨花飘泊。"], "annotations": [], "rhythmic": "好事近"}, {"title": "阮郎归 春雨", "paragraphs": ["小池芳草绿初匀。", "柳寒眉尚颦。", "东风吹雨细于尘。", "一庭花脸皴。", "莺共蝶，怨还嗔。", "眼前无好春。", "这般天气煞愁人。", "人愁旋旋新。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "乌夜啼", "paragraphs": ["小桃落尽残红。", "夜来风。", "又是一番春事、不从容。", "翠屏掩。", "芳信断。", "转愁浓。", "可惜日长闲暇、小帘栊。"], "annotations": [], "rhythmic": "乌夜啼"}]}