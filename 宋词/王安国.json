{"dynasty": "宋", "author": "王安国", "author_desc": "", "works": [{"title": "点绛唇", "paragraphs": ["秋气微凉，梦回明月穿帘幕。", "井梧萧索。", "正绕南枝鹊。", "宝瑟尘生，金雁空零落。", "情无托。", "鬓云慵掠。", "不似君恩薄。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "清平乐 春晚", "paragraphs": ["留春不住。", "费尽莺儿语。", "满地残红宫锦污。", "昨夜南园风雨。", "小怜初上琵琶。", "晓来思绕天涯。", "不肯画堂朱户，春风自在梨花。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "减字木兰花 春情", "paragraphs": ["画桥流水。", "雨湿落红飞不起。", "月破黄昏。", "帘里馀香马上闻。", "徘徊不语。", "今夜梦魂何处去。", "不似垂杨。", "犹解飞花入洞房。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "金明池", "paragraphs": ["霓旌远远拂楼船，满地春风锦绣筵。", "三岛路深游阆苑，九霞觞满奏钧天。", "仗归金阙浮云外，人望池台落日边。", "最引平生江海趣，波澜一段草如烟。"], "annotations": []}]}