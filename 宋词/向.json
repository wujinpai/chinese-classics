{"dynasty": "宋", "author": "向", "author_desc": "", "works": [{"title": "念奴娇", "paragraphs": ["霜威凄紧，政悲风摇落，千山群木。", "十里清香方盛赏，岩桂娇黄姹绿。", "九畹衰丛，东篱落蕊，到此成粗俗。", "孤标高远，淡然还媚幽独。", "憔悴诗老多情，问佳人底事，幽居空谷。", "日暮天寒垂翠袖，愁倚萧萧修竹。", "林下神情，月边风露，不向雕栏曲。", "殷勤惟有，篆烟留得馀馥。"], "annotations": [], "rhythmic": "念奴娇"}, {"title": "满庭芳", "paragraphs": ["玉粉匀梅，曲尘浮柳，画檐迟日融融。", "金猊喷麝，庭户转香风。", "好是闲居戏彩，寿觞举、和满春容。", "须知道，闺门孕秀，佳气在帘栊。", "无穷。", "观盛事，年年此会，拚醉金锺。", "又何须、西池高宴仙宫。", "尽把乔松□寿，兼大国、秦虢重封。", "那堪更，门阑多喜，女婿近乘龙。"], "annotations": [], "rhythmic": "满庭芳"}, {"title": "青玉案", "paragraphs": ["别时抆泪花无语。", "但一味、教郎住。", "此日扁舟游远浦。", "雨晴云树。", "月斜烟树。", "目断家何许。", "红笺不寄相思句。", "人在潇湘雁回处。", "屈指归期秋已暮。", "万千里路。", "两三头绪。", "恨不飞将去。"], "annotations": [], "rhythmic": "青玉案"}, {"title": "青玉案", "paragraphs": ["多情赋得相思分。", "便揽断、愁和闷。", "万种千般说不尽。", "吃他圈柜，被他拖逗，便佛也、须教恨。", "传消寄息无凭信。", "水远山遥怎生奔。", "梦也而今难得近。", "伊还知道，为伊成病，便死也、谁能问。"], "annotations": [], "rhythmic": "青玉案"}, {"title": "小重山", "paragraphs": ["翡翠林梢青黛山。", "小楼新罨画，卷珠帘。", "碧纱窗外水挪蓝。", "凭栏处，相对玉纤纤。", "人散酒阑珊。", "夜长都睡皱，唾花衫。", "一弯残月下风檐。", "凌波去，罗袜步蹁跹。"], "annotations": [], "rhythmic": "小重山"}, {"title": "踏莎行", "paragraphs": ["万水千山，两头三绪。", "凭高望断迢迢路。", "钱塘江上客归迟，落花流水青春暮。", "步步金莲，朝朝琼树。", "目前都是伤心处。", "飞鸿过尽没书来，梦魂依旧阳台雨。"], "annotations": [], "rhythmic": "踏莎行"}, {"title": "蝶恋花", "paragraphs": ["费尽东君无限巧。", "玉减香销，回首令人老。", "梦绕岭头归未到。", "角声吹断江天晓。", "燕子来时春正好。", "寸寸柔肠，休问愁多少。", "从此欢心还草草。", "凭栏一任桃花笑。"], "annotations": [], "rhythmic": "蝶恋花"}, {"title": "临江仙", "paragraphs": ["瘦损东阳缘底事，离愁别恨难禁。", "夜长谁共拥孤衾。", "来时青鬓在，今已二毛侵。", "流水青山依旧是，兰桡往事空寻。", "一番风雨又春深。", "桃花都落尽，赢得是清阴。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "临江仙", "paragraphs": ["乱后此身何计是，翠微深处柴扉。", "即今双鬓已如丝。", "虚名将底用，真意在鸱夷。", "治国无谋归去好，衡门犹可栖迟。", "不妨沈醉典春衣。", "人生行乐耳，须富贵何时。"], "annotations": [], "rhythmic": "临江仙"}, {"title": "武陵春", "paragraphs": ["长记酒醒人散后，风月满江楼。", "楼外烟波万顷秋。", "高槛冷飕飕。", "想见云鬟香雾湿，斜坠玉搔头。", "两处相思一样愁。", "休更照鄜州。"], "annotations": [], "rhythmic": "武陵春"}, {"title": "阮郎归", "paragraphs": ["隔篱疏影照横塘。", "东风吹暗香。", "陇头归路指苍茫。", "江南春兴长。", "扃小院，静回廊。", "有人凭短墙。", "角声惊梦月横窗。", "此时能断肠。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "南乡子", "paragraphs": ["临水窗儿。", "与卷珠帘看画眉。", "雨浴红衣惊起后，争知。", "水远山长各自飞。", "受尽孤凄。", "极目风烟说与谁。", "直是为他憔悴损，寻思。", "怎得心肠一似伊。"], "annotations": [], "rhythmic": "南乡子"}, {"title": "西江月", "paragraphs": ["流水断桥衰草，西风落日清笳。", "往来赢得鬓边华。", "此去征鞍休跨。", "烟溆绿深陂筱，霜篱红老江花。", "青山尽处是侬家。", "拟唤渔舟东下。"], "annotations": [], "rhythmic": "西江月"}, {"title": "西江月", "paragraphs": ["门柳疏疏映日，井桐策策翻秋。", "萧条不似那时游。", "只有山光依旧。", "别久犹牵去梦，怀多还惹新愁。", "吹箫人在雁回州。", "不管沈郎消瘦。"], "annotations": [], "rhythmic": "西江月"}, {"title": "西江月", "paragraphs": ["竹寺青灯永夜，江城黄叶高秋。", "当时文物尽交游。", "更为笛声怀旧。", "牢落一生羁思，风流万斛诗愁。", "强邀从事到青州。", "酒病绵绵越瘦。"], "annotations": [], "rhythmic": "西江月"}, {"title": "西江月", "paragraphs": ["抵死漫生要见，偷方觅便求欢。", "十分赢得带围宽。", "划地如今难恋。", "枕畔水沈烟尽，床头银蜡烧残。", "鸳衾不觉夜深寒。", "记取有人肠断。"], "annotations": [], "rhythmic": "西江月"}, {"title": "西江月", "paragraphs": ["别后千思万想，眼前一日三秋。", "小街栏槛记追游。", "料得新妆依旧。", "自笑非常蒂𣨼，为他无限闲愁。", "莫将离恨寄鄜州。", "闻道腰肢愈瘦。"], "annotations": [], "rhythmic": "西江月"}, {"title": "虞美人", "paragraphs": ["酒阑敧枕新凉夜。", "断尽人肠也。", "西风吹起许多愁。", "不道沈腰潘鬓、不禁秋。", "如今病也无人管。", "真个难消遣。", "东邻一笑直千金。", "争奈茂陵情分、在文君。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "虞美人", "paragraphs": ["宝梳半脱文窗里。", "玉软因谁醉。", "锦鸳应是懒熏香。", "□我水村孤酌、减疏狂。", "此时纵有千金笑。", "情味如伊少。", "带围宽尽莫教知。", "嫌怕为侬成病、似前时。"], "annotations": [], "rhythmic": "虞美人"}, {"title": "南歌子", "paragraphs": ["路尽湘江水，人行瘴雾间。", "昏昏西日度严关。", "天外一簪初见、岭南山。", "北雁连书断，新霜点鬓斑。", "此时休问几时还。", "准拟桂林佳处、过春残。"], "annotations": [], "rhythmic": "南歌子"}, {"title": "点绛唇", "paragraphs": ["屈指新冬，肃霜天气重阳后。", "授衣时候。", "兰菊香盈袖。", "此日生申，维岳锺神秀。", "倾名酎。", "篆添金兽。", "共祝如椿寿。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "减字木兰花", "paragraphs": ["多情被恼。", "枉了东君无限巧。", "真个愁人。", "一片轻飞减却春。", "阑干凭暖。", "目断彩云肠也断。", "两岸青山。", "隐隐孤舟浪接天。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "朝中措", "paragraphs": ["平生此地几经过。", "家近奈情何。", "长记月斜风劲，小舟犹渡烟波。", "而今老大，欢消意减，只有愁多。", "不似旧时心性，夜长听彻渔歌。"], "annotations": [], "rhythmic": "朝中措"}, {"title": "忆秦娥", "paragraphs": ["秋萧索。", "别来先自情怀恶。", "情怀恶。", "日斜庭院，月明帘幕。", "轻离却似于人薄。", "而今休更思量著。", "思量著。", "肝肠空断，水云辽邈。"], "annotations": [], "rhythmic": "忆秦娥"}, {"title": "好事近", "paragraphs": ["清晓渡横江，江上月寒霜白。", "寂寞断桥南畔，有一枝春色。", "玉肌孤瘦恰如伊，此际转相忆。", "且道这些烦恼，看几时休得。"], "annotations": [], "rhythmic": "好事近"}, {"title": "点绛唇", "paragraphs": ["蕙怨兰愁，玉台羞对啼妆面。", "懒匀香脸。", "不放眉峰展。", "幽恨谁知，锦字空传远。", "何时见。", "为郎肠断。", "不似郎情浅。"], "annotations": [], "rhythmic": "点绛唇"}, {"title": "阮郎归", "paragraphs": ["湘南楼上好凭栏。", "西风吹鼻酸。", "宦游何处不惊湍。", "白鸥盟已寒。", "空饮恨，废追欢。", "沈郎衣带宽。", "故人休放酒杯干。", "而今行路难。"], "annotations": [], "rhythmic": "阮郎归"}, {"title": "如梦令", "paragraphs": ["旧恨新愁无际。", "近水远山都是。", "西北有高楼，正为行藏独倚。", "留滞。", "留滞。", "家在吴头楚尾。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "如梦令", "paragraphs": ["梦断绿窗莺语。", "消遣客愁无处。", "小槛俯青郊，恨满楚江南路。", "归去。", "归去。", "花落一川烟雨。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "如梦令", "paragraphs": ["直面雨轻风峭。", "极目水空烟渺。", "家在武陵溪，无限壑讥峰诮。", "归好。", "归好。", "睡足一江春晓。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "如梦令", "paragraphs": ["杨柳千丝万缕。", "特地织成愁绪。", "休更唱阳关，便是渭城西路。", "归去。", "归去。", "红杏一腮春雨。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "如梦令", "paragraphs": ["野店几杯空酒。", "醉里两眉长皱。", "已自不成眠，那更酒醒时候。", "知否。", "知否。", "直是为他消瘦。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "如梦令", "paragraphs": ["厮守许多时价。", "谁信一筹不画。", "相送到矾园，赢得泪珠如泻。", "挥洒。", "挥洒。", "将底江州司马。"], "annotations": [], "rhythmic": "如梦令"}, {"title": "长相思", "paragraphs": ["桃花堤。", "柳花堤。", "芳草桥边花满溪。", "而今戎马嘶。", "千山西。", "万山西。", "归雁横云落日低。", "登楼望欲迷。"], "annotations": [], "rhythmic": "长相思"}, {"title": "长相思", "paragraphs": ["行相思。", "坐相思。", "两处相思各自知。", "相思更为谁。", "朝相思。", "暮相思。", "一日相思十二时。", "相思无尽期。"], "annotations": [], "rhythmic": "长相思"}, {"title": "菩萨蛮", "paragraphs": ["小楼不放珠帘卷。", "菱花羞照啼妆面。", "金鸭水沈烟。", "待君来共添。", "鹊声生暗喜。", "翠袖轮纤指。", "细细数归程。", "脸桃春色深。"], "annotations": [], "rhythmic": "菩萨蛮"}, {"title": "清平乐", "paragraphs": ["离愁万斛。", "春思难拘束。", "瘦尽玉肌清彻骨。", "蹙损两眉秀绿。", "画屏罗幌输君。", "文鳞锦翼尤勤。", "长记酒醒香冷，笑将髻子隈人。"], "annotations": [], "rhythmic": "清平乐"}, {"title": "卜算子", "paragraphs": ["休逞一灵心，争甚闲言语。", "十一年间并枕时，没个牵情处。", "四岁学言儿，七岁娇痴女。", "说与傍人也断肠，你自思量取。"], "annotations": [], "rhythmic": "卜算子"}]}