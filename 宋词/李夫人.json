{"dynasty": "宋", "author": "李夫人", "author_desc": "", "works": [{"title": "减字木兰花", "paragraphs": ["幕天席地。", "瑞脑香浓笙歌沸。", "白纻衣轻。", "鹓发霜髯照座明。", "轻簪小珥。", "却是人间真富贵。", "好着丹青。", "画与人间作寿星。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "蝶恋花", "paragraphs": ["急鼓疏钟声报晓，楼上今朝，卷起重帘早。", "环珮珊珊香袅袅。", "尘埃不到如蓬岛。", "何用珠玑相映照。", "韵胜形清，自有天然好。", "莫向尊前辞醉倒。", "松枝鹤骨偏宜老。"], "annotations": [], "rhythmic": "蝶恋花"}, {"title": "瑞鹧鸪", "paragraphs": ["新晴庭院暑风轻。", "瑞气朝来特地清。", "霞帔羽衣筠竹杖，萱堂真有寿星明。", "自来忠孝传家世，所以芝兰满户庭。", "簪笏成行称寿处，老来皆已鬓星星。"], "annotations": [], "rhythmic": "瑞鹧鸪"}]}