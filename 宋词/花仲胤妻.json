{"dynasty": "宋", "author": "花仲胤妻", "author_desc": "", "works": [{"title": "伊川令/伊州令 寄外", "paragraphs": ["西风昨夜穿帘幕。", "闺院添消索。", "最是梧桐零落。", "迤逦秋光过却。", "人情音信难托。", "鱼雁成耽阁。", "教奴独自守空房，泪珠与、灯花共落。"], "annotations": [], "rhythmic": "伊川令・伊州令"}, {"title": "失调名 答外", "paragraphs": ["奴启情人勿见罪。", "闲将小书作尹字。", "情人不解其中意。", "问伊间别几多时。", "身边少个人儿。"], "annotations": [], "rhythmic": "失调名"}]}