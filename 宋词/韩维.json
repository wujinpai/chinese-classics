{"dynasty": "宋", "author": "韩维", "author_desc": "", "works": [{"title": "西江月 席上呈子华", "paragraphs": ["早岁相期林下，高年同在尊前。", "风花绣舞乍晴天。", "绿蚁新浮酒面。", "身外虚名电转，人间急景梭传。", "当筵莫惜听朱弦。", "一品归来强健。"], "annotations": [], "rhythmic": "西江月"}, {"title": "踏莎行 次韵范景仁寄子华", "paragraphs": ["归雁低空，游蜂趁暖。", "凭高目向西云断。", "具茨山外夕阳多，展江亭下春波满。", "双桂情深，千花明焕。", "良辰谁是同游伴。", "辛夷花谢早梅开。", "应须次第调弦管。"], "annotations": [], "rhythmic": "踏莎行"}, {"title": "减字木兰花 颍州西湖", "paragraphs": ["和风动□。", "□□新年□入手。", "世事尘□。", "□□□情近酒□。", "水开湖□。", "□□笙歌波面起。", "相与排□。", "□□□胜特地□。"], "annotations": [], "rhythmic": "减字木兰花"}, {"title": "浪淘沙令", "paragraphs": ["饱食日□□。", "□上危亭。", "东风昨夜入□□。", "□□雪晴云□□，□遍银屏。", "回首叹劳生。", "□鼎相承。", "皇恩早晚□□□。", "□□陂边垂钓手，不负幽情。"], "annotations": [], "rhythmic": "浪淘沙"}, {"title": "胡捣练令・胡捣练", "paragraphs": ["夜来风横雨飞狂，满地闲花衰草。", "燕子渐归春悄。", "帘幕垂清晓。", "天将佳景与闲人，美酒宁嫌华皓。", "留取旧时欢笑。", "莫共秋光老。"], "annotations": [], "rhythmic": "胡捣练令・胡捣练"}, {"title": "失调名 其一", "paragraphs": ["轻云薄雾。", "散作催花雨。"], "annotations": [], "rhythmic": "失调名"}, {"title": "失调名 其二", "paragraphs": ["兄弟对举杯。"], "annotations": [], "rhythmic": "失调名"}, {"title": "步月", "paragraphs": ["初阳夺残凛，和气不待春。", "况兹华月白，光彩清路尘。", "整我巾与屦，迢遥步城𬮱。", "仰观众星色，收芒避孤轮。", "虚无一境间，岂复知吾身。", "嗟哉御风者，有待奚足珍。"], "annotations": []}, {"title": "失调名", "paragraphs": ["轻云薄雾。", "散作催花雨。", "兄弟对举杯。"], "annotations": []}]}