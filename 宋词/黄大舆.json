{"dynasty": "宋", "author": "黄大舆", "author_desc": "", "works": [{"title": "更漏子", "paragraphs": ["怜宋玉、许王昌。", "东西邻短墙。"], "annotations": [], "rhythmic": "更漏子"}, {"title": "虞美人", "paragraphs": ["世间离恨何时了。", "不为英雄少。", "楚歌声起霸图休。", "玉帐佳人血泪、满东流。", "葛荒葵老芜城暮。", "玉貌知何处。", "至今芳草解婆娑。", "只有当时魂魄、未消磨。"], "annotations": [], "rhythmic": "虞美人"}]}