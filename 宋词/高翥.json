{"dynasty": "宋", "author": "高翥", "author_desc": "", "works": [{"title": "秋日田父辞", "paragraphs": ["啄黍黄鸡没骨肥。", "绕篱绿橘缀枝垂。", "新酿酒，旋裁衣。", "正是昏男嫁女时。"], "annotations": [], "rhythmic": "秋日田父辞"}, {"title": "秋日田父辞", "paragraphs": ["少妇挼蓝旋染裙。", "大儿敲葛自浆巾。", "新摘摘，笑欣欣。", "相唤相呼看赛神。"], "annotations": [], "rhythmic": "秋日田父辞"}, {"title": "春霁", "paragraphs": ["积雨才收云尽归，长空一色碧琉璃。", "日移帘影临书案，风飐瓶花落研池。", "巢燕学飞犹恋母，笼鸡得食旋呼儿。", "眼看景物关情甚，喜为新晴赋此诗。"], "annotations": []}]}