{"dynasty": "汉", "author": "刘弗陵", "author_desc": "", "works": [{"title": "黄鹄歌", "paragraphs": ["黄鹄飞兮下建章。", "羽肃肃兮行跄跄。", "金为衣兮菊为裳。", "唼喋荷荇。", "出入蒹葭。", "自顾菲薄。", "愧尔嘉祥。"], "annotations": []}, {"title": "淋池歌", "paragraphs": ["秋素景兮泛洪波。", "挥纤手兮折芰荷。", "凉风凄凄扬棹歌。", "云光开曙月低河。", "万岁为乐岂云多。"], "annotations": []}]}