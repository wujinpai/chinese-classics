{"dynasty": "汉", "author": "孔融", "author_desc": "", "works": [{"title": "六言诗三首 其三", "paragraphs": ["从洛到许巍巍。", "曹公忧国无私。", "减去厨膳甘肥。", "群僚率从祁祁。", "虽得俸禄常饥。", "念我苦寒心悲。"], "annotations": []}, {"title": "六言诗三首 其二", "paragraphs": ["郭李分争为非。", "迁都长安思归。", "瞻望关东可哀。", "梦想曹公归来。"], "annotations": []}, {"title": "六言诗三首 其一", "paragraphs": ["汉家中叶道微。", "董卓作乱乘衰。", "僣上虐下专威。", "万官惶布莫违。", "百姓惨惨心悲。"], "annotations": []}, {"title": "诗", "paragraphs": ["坐上客恒满，樽中饮不空。"], "annotations": []}, {"title": "临终诗", "paragraphs": ["言多令事败，器漏苦不密。", "河溃蚁孔端，山坏由猿穴。", "涓涓江汉流，天窗通冥室。", "谗邪害公正，浮云翳白日。", "靡辞无忠诚，华繁竟不实。", "人有两三心，安能合为一。", "三人成市虎，浸渍解胶漆。", "生存多所虑，长寝万事毕。"], "annotations": []}, {"title": "离合作郡姓名字诗", "paragraphs": ["渔父屈节，水潜匿方。", "与峕进止，出行施张。", "吕公矶钓，阖口渭旁。", "九域有圣，无土不王。", "好是正直，女回于匡。", "海外有截，隼逝鹰扬。", "六翮将奋，羽仪未彰。", "蛇龙之蛰，俾也可忘。", "玟璇隐曜，美玉韬光。", "无名无誉，放言深藏。", "按辔安行，谁谓路长。"], "annotations": []}, {"title": "六言诗三首", "paragraphs": ["汉家中叶道微。", "董卓作乱乘衰。", "僣上虐下专威。", "万官惶布莫违。", "百姓惨惨心悲。", "郭李分争为非。", "迁都长安思归。", "瞻望关东可哀。", "梦想曹公归来。", "从洛到许巍巍。", "曹公忧国无私。", "减去厨膳甘肥。", "群僚率从祁祁。", "虽得俸禄常饥。", "念我苦寒心悲。"], "annotations": []}]}