{"dynasty": "汉", "author": "杨孚", "author_desc": "", "works": [{"title": "桂", "paragraphs": ["桂之灌生，必粹其族。", "柯叶不渝，冬夏常绿。", "□匪桂植，在乎嵩岳。"], "annotations": []}, {"title": "蚺", "paragraphs": ["蚺惟大蛇，既洪且长。", "采色驳荦，其文锦章。", "食豕吞鹿，腴成养创。", "宾享嘉宴，是豆是觞。"], "annotations": []}, {"title": "摩厨", "paragraphs": ["木有摩厨，生于斯调。", "厥汁肥润，其泽如膏。", "馨香馥郁，可以煎熬。", "彼州之民，仰为嘉肴。"], "annotations": []}, {"title": "榕", "paragraphs": ["榕树栖栖，长与少殊。", "高出林表，广荫原丘。", "孰知初生，葛蔂之俦。"], "annotations": []}, {"title": "丈草", "paragraphs": ["丈草作酒，能成其味。", "以金买草，不言其贵。"], "annotations": []}, {"title": "鲛", "paragraphs": ["鲛之为鱼，其子既育。", "惊必归母，还入其腹。", "小则如之，大则不复。"], "annotations": []}, {"title": "三薕", "paragraphs": ["三薕大实，实不但三。", "食之多汁，味酸且甘。", "藏之尤好，与果相参。"], "annotations": []}, {"title": "周留", "paragraphs": ["苍毛豕身，角若担矛。", "卫护其犊，与虎为雠。"], "annotations": []}, {"title": "鹧鸪", "paragraphs": ["鸟象雌鸡，自名鹧鸪。", "其志怀南，不思北徂。"], "annotations": []}, {"title": "犀", "paragraphs": ["于惟玄犀，处自林麓。", "食惟棘刺，体兼五肉。", "或有神异，表灵以角。", "含精吐烈，望若华烛。", "置之荒野，禽兽莫触。"], "annotations": []}, {"title": "贝", "paragraphs": ["乃有大贝，奇姿难俦。", "素质紫饰，文若罗珠。", "不磨而莹，采耀光流。", "思雕莫加，欲琢靡逾。", "在昔姬伯，用免其拘。"], "annotations": []}, {"title": "象", "paragraphs": ["象之为兽，形体特诡。", "身倍数牛，目不逾狶。", "鼻为口役，望头若尾。", "驯良承教，听言则跪。", "素牙玉洁，载籍所美。", "服重致远，行如丘徙。"], "annotations": []}]}