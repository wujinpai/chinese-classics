{"dynasty": "汉", "author": "李尤", "author_desc": "", "works": [{"title": "九曲歌", "paragraphs": ["年岁晚墓时已斜。", "安得壮士翻日车。", "肥骨消灭随尘去。"], "annotations": []}, {"title": "武功歌", "paragraphs": ["□□□。", "鸣金鼓。", "马模起。", "士激怒。", "清埃飞。", "连日月。", "恩普洽。", "威令行。", "身非金石。", "名俱灭焉。"], "annotations": []}, {"title": "河铭", "paragraphs": ["洋洋河水，赴宗于海。", "经自中州，龙图所在。", "昔周诸侯，会于孟津。", "鱼入王舟，乃往尅殷。", "大汉承绪，怀附遐邻。", "邦事来济，各贡厥珍。"], "annotations": []}, {"title": "洛水铭", "paragraphs": ["洛出熊耳，东流会集。", "夏禹导疏，经于洛邑。", "元龟赤字，汉符是立。", "帝都通路，建国南乡。", "万乘终济，造舟为梁。", "三都五州，贡篚万方。", "广视远听，审任贤良。", "元首昭明，庶物是康。"], "annotations": []}, {"title": "金羊灯铭", "paragraphs": ["贤哲勉务，惟日不足。", "金羊载耀，作明以续。"], "annotations": []}, {"title": "舟楫铭", "paragraphs": ["舟楫之利，譬犹舆马。", "辇重历远，以济天下。", "相风视波，穷䆒川野。", "安审惧慎，终无不可。"], "annotations": []}, {"title": "小车铭", "paragraphs": ["员盖象天，方舆则地。", "轮法阴阳，动不相离。", "合之嗛嘘，疏达开通。", "两辎障邪，尊卑是从。", "𫐐𫐄之用，信义所同。"], "annotations": []}, {"title": "天𫐌车铭", "paragraphs": ["奚氏本造，后裔饰雍。", "轮以代步，𫐌以蔽容。", "轮𫐌并合，出入周通。", "追仁赴义，惟礼是恭。"], "annotations": []}, {"title": "良弓铭", "paragraphs": ["弓矢之作，爰自曩时。", "乡射载礼，招命在诗。", "妙称颜高，巧发晋师。", "不争之美，亦以辨仪。"], "annotations": []}, {"title": "印铭", "paragraphs": ["赤绂在躬，非印不明。", "棨传符节，非印不行。", "龟钮犊鼻，用尔作程。"], "annotations": []}, {"title": "冠帻铭", "paragraphs": ["冠为元服，帻为首服。", "君子敬慎，自强不忒。"], "annotations": []}, {"title": "熏炉铭", "paragraphs": ["上似蓬莱，吐气委蛇。", "芳烟布绕，遥冲紫微。"], "annotations": []}, {"title": "镜铭", "paragraphs": ["铸铜为鉴，整饰容颜。", "修尔法服，正尔衣冠。"], "annotations": []}, {"title": "围棋铭", "paragraphs": ["诗人幽忆，感物则思。", "志之空闲，玩弄游意。", "局为宪矩，棋法阴阳。", "道为经纬，方错列张。"], "annotations": []}, {"title": "樽铭", "paragraphs": ["樽设在堂，以俟俊乂。", "三山共承，雕琢错带。"], "annotations": []}, {"title": "床几铭", "paragraphs": ["虚左致贤，设坐来宾。", "筵床对几，盛养巳陈。", "殽仁饭义，枕典席文。", "道可醉饱，何必清醇。", "西伯善养，二老来臻。"], "annotations": []}]}