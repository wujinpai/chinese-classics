{"dynasty": "元", "author": "侯善渊", "author_desc": "", "works": [{"title": "一叶舟", "paragraphs": ["颠倒一阳初起。", "万化混元同体。", "光灿射瑶宫。", "满堂红。", "了正圆明开启。", "上下贯穿无底。", "天地悉空皆空。", "太玄中。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["海底凝珠鲜洁。", "天上莹然清绝。", "中道太虚宽。", "滚神丹。", "光胜一轮秋月。", "照鉴本无圆缺。", "清爽逼人寒。", "透琅玕。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["大道孤然独立。", "善用本元辙迹。", "寰海好云游。", "玩清秋。", "月色扶空澄瑞，微现桂红轻翠。", "嘉景最奇幽。", "赛瀛洲。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["照海凝珠光灿。", "贵贱不分弹雀。", "可惜本来珍。", "污泥津。", "认取勿令差错。", "莹净免繁萦缚。", "决正出嚣尘。", "玩长春。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["不觉形躯衰老。", "受尽许多萦恼。", "谁肯死前休。", "苦贪求。", "识破修行早早。", "认取自家珍宝。", "珍宝价无酬。", "永存留。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["大道本无一物。", "遍纳十方充塞。", "无外亦无心。", "不容针。", "要见阐开清目。", "认得本元虚谷。", "非浅亦非深。", "满壶金。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["道契希夷恍惚，辩正其中有物。", "物物自然通。", "尽包容。", "月白风清满目。", "宝篆玲珑馥郁。", "寥落遍精空。", "有无中。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["摆脱尘情冤业。", "此是利名休歇。", "清净谨威仪。", "宴瑶池。", "水静澄澄冰洁。", "显焕碧潭秋月。", "月里悟丹枝。", "性光辉。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["顶笠披莎归去。", "渐入芦花深处。", "绿岸缆渔舟。", "钓纶收。", "轻泛壶中一味。", "野鹤孤云相济。", "横管韵清幽。", "乐无愁。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["万象冲开寥廓。", "元气混然虚托。", "海月晏晶金。", "照天心。", "睫外威神辉豁。", "冰体雪肌绰约。", "稳稳过琼琳。", "上瑶岑。"], "annotations": []}, {"title": "一叶舟", "paragraphs": ["运动一阳初出。", "照破太空微密。", "万象总潜形。", "炫然明。", "凝化鼎中灵质。", "丹就刹那功毕。", "仙子上云英。", "玩蓬瀛。"], "annotations": []}, {"title": "太平令", "paragraphs": ["芝堂无事启丹经。", "香烟袅，慧灯明。", "声和流玉音清。", "云收绝雾敛，眄平一色瑶池净。", "洞天玄照瑞光凝。", "分明见，豁然惺。", "回眸返入道圆成。", "便忘形羽化，虚皇付我天符令。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["长生道，日用在虚无。", "一气初分明动静，三才应化见沈浮。", "玉兔趁灵乌。", "轰宇宙，一撞出昏衢。", "光射三山白虎额，焰飞两道赤龙须。", "照见夜明珠。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["修真理，何在斗禅机。", "广念葛藤空厮□，多参功案总虚脾。", "争似悟无为。", "开道眼，一性出昏迷。", "竹密不妨流水过，山高难碍白云飞。", "升上紫霄微。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["虚无道，元气自相和。", "玄览涤除贤士少，合尘背觉俗徒多。", "终日谩蹉跎。", "开法眼，一性贯娑婆。", "莹净净如秋月冷，冰清清似泛琼波。", "浇溉润灵柯。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["修行事，割爱断攀缘。", "身净心清明道眼，内持无漏气神全。", "真汞炼真铅。", "安炉鼎，进火任烹煎。", "款款捞来捶作片，团团结就宝珠圆。", "身外化飞仙。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["真常道，日用遍三千。", "大则包罗天地外，小周沙芥亦如然。", "物物尽通玄。", "威神力，混里任循环。", "撞破虚空七八片，明珠滚出海鳌边。", "光接焰魔天。"], "annotations": []}, {"title": "归来曲", "paragraphs": ["忘俗念，万类悉皆空。", "欹枕宵眠游梦断，半窗明月一帘风。", "迤逦觉朦胧。", "披衣坐，照见本来容。", "静室生白冲浩气，虚堂祥瑞现神功。", "光射玉壶中。"], "annotations": []}, {"title": "玉笼璁", "paragraphs": ["守清净，凭志恳，绝尽荒淫。", "持内境，月透双林。", "玉童戏，遥指处，碧潭波心。", "捞摝取起，水中金。", "灵宝灿，慧灯明，神光相任。", "对面有，没人推寻。", "君还省，明了了，灾祸不侵。", "龙虎伏，鬼神钦。"], "annotations": []}, {"title": "江月晃重山", "paragraphs": ["斗柄指回一性，璇玑斡转双关。", "滔天洪浪雪华翻。", "中秋夜，江月晃重山。", "独步上星坛。", "剑光横宇角，逼人寒。", "五灵仙子抱青鸾。", "飞入华胥阆苑。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["内阐规函致本宗。", "道相通。", "寂寥常在混元宫。", "悟真空。", "上下观之无一物，与谁同。", "逍遥独坐月明中。", "伴清风。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["宝性完容上下冲。", "内推穷。", "氤氲三色射瑶宫。", "焰飞空。", "洞济玉阳澄宝瑞，自和同。", "谷神翔翥混元中。", "玩仙风。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["偃息团𪢮玩宝窥。", "目无疵。", "涤除玄览似婴儿。", "正容仪。", "欲问今宵何处也，赴仙期。", "满船空载月明归。", "上瑶池。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["丱岁飘蓬住远山。", "水云闲。", "须知千载厌人间。", "欲回还。", "换骨脱胎归旧路，返童颜。", "步虚升入古仙坛。", "泛云鸾。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["孰见西明画锦妆。", "景非常。", "烟波柳岸映斜阳。", "水云乡。", "咫尺家山人不到，好风光。", "步虚升入碧云房。", "洞天长。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["鹤性佋佋望远攀。", "过潼关。", "秋深雨霁乍衣单。", "水云寒。", "争忍昔年名利染，早回还。", "夕阳村落杏摽间。", "望家山。"], "annotations": []}, {"title": "添声杨柳枝", "paragraphs": ["顿识圆明象易冲。", "妙无穷。", "祥烟飞入玉清宫。", "月临空。", "物性自然纯古道，与谁同。", "杨柳枝插宝瓶中。", "好家风。"], "annotations": []}, {"title": "玩华胥", "paragraphs": ["古岸蟠桃初绽。", "新月素光交灿。", "尘世几人窥，我留心高盼。", "长叹。", "长叹。", "回首远游仙梵。"], "annotations": []}, {"title": "玩华胥", "paragraphs": ["冒啸古风溪月。", "晃耀太虚澄彻。", "美盼清圆，不见又还重缺。", "光接。", "光接。", "玉桂寒林冰洁。"], "annotations": []}, {"title": "转调采桂枝", "paragraphs": ["分明相外归宗祖，道眼俱全。", "出入绵绵。", "升降浮沉任往还。", "最幽玄。", "日精月髓安炉内，一气烹煎。", "丹就凝然。", "皎皎光明滚上天。", "化飞仙。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["羽倪澄秀。", "午夜能令回春昼。", "奕御中天。", "绝妙清奇玄又玄。", "精瑛微密。", "散景瑶花横空碧。", "日照琅玕。", "风息犹闻佩玉寒。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["丹田固蒂。", "旋引灵泉频溉济。", "渐长黄芽。", "风撼孤根一径斜。", "美金花发。", "艳放清香初破甲。", "煎插银瓶。", "兼炷龙涎献上清。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["无荣无辱。", "内守真元常自足。", "外应无居。", "上下周流出六虚。", "昆岗玄玉。", "擅假阳光盈满国。", "混一凝珠。", "宝洁灵华五彩舒。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["灵源虚静。", "物换流阳如宝镜。", "满目清光。", "寂寞无为用在常。", "本乎一性。", "返照真空终复始。", "性命俱全。", "炼就阳神得自然。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["瞽之善听。", "一气清聪通惠性。", "聋者能惺。", "两点精神入宝瓶。", "返邪归正。", "有似高空悬玉镜。", "鉴照分明。", "始信金丹一日成。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["寂虚湛湛。", "道大圆明如宝鉴。", "清夜霜天。", "物洁星稀海桂圆。", "幽栖静悄。", "独坐陵溪风浩渺。", "水碧澄烟。", "心适清聪物外仙。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["除贪绝爱。", "性静心清明宝界。", "宝界华阳。", "换质琅然雪隐霜。", "虚白晃耀。", "轩外澄神凭自照。", "照破昏衢。", "显出圆通五彩珠。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["真清真静。", "静里清清完性命。", "命蒂含神。", "神奕竽都紫府春。", "春光皓皓。", "皓旷明阳盈古道。", "道太升玄。", "玄远无隅天外天。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["清虚妙理。", "湛湛圆明融彻底。", "海净天空。", "空里明知有圣功。", "心珠涌跃。", "焰迸流霞光睒烁。", "凤炽金乌。", "飞过新罗上玉都。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["颐生就死。", "死里逃生终复始。", "弃假求真。", "真性明知身外身。", "无中生有。", "有里还无难启口。", "默守神功。", "功满朝无上碧空。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["灵元恢鄂。", "满目风光虚倚托。", "落落无涯。", "飘入瑶宫散宝华。", "通玄慧口。", "面启南轩观北斗。", "宝洁凝然。", "一粒明珠滚上天。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["凝空寂湛。", "眩集神风明自鉴。", "洞达遥天。", "一性寥寥点桂圆。", "地入净悄。", "湛静冷波风浩渺。", "宝炷轻烟。", "烟彻丹霄降瑞仙。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["回头问己。", "认取无生真妙理。", "内阐灵光。", "升入蟾宫点桂霜。", "混成天癸。", "窈窕流霞融彻底。", "洞济冥阳。", "仙子功标北帝乡。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["三关锁闭。", "沐浴琅膏容可济。", "养就灵砂。", "晴灿玲珑益宝霞。", "玄英幽邃。", "金阙寥阳澄秀瑞。", "两个青童。", "捧出玄珠入绛宫。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["亲传妙诀。", "法眼清眸超亿劫。", "似月临溪。", "飘落琼花满太微。", "冷然莹彻。", "瑞彩祥光冰玉洁。", "焕若星仪。", "虽有真容出绣帏。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["内观北斗。", "斡转天关通慧口。", "阴里生阳。", "烹炼三魂七魄亡。", "玉炉功毕。", "宝鼎金丹明沥沥。", "晃耀灵砂。", "日灿晴空落翠霞。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["忘形遗照。", "无垢清虚真至妙。", "物外霞辉。", "天岸波澄混太微。", "列开丹窍。", "悟入重玄明总要。", "出化星仪。", "风御灵飙易象嬉。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["景风初现。", "宝适祥云乘九变。", "始信清然。", "游奕南陵泻素圆。", "冥灵才见。", "又早新春通一线。", "象外游仙。", "看尽瑶池五色莲。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["默然内守。", "混里倾阳无中有。", "有里何如。", "独体圆通照海珠。", "神清气秀。", "游奕丹天明如昼。", "上下无拘。", "密布灵华满太虚。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["回头问己。", "返照蓬壶明彻底。", "一颗玄珠。", "上下周流出六虚。", "混成天癸。", "象适圆通明亹亹。", "内外无拘。", "游奕天中不卷舒。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["无知野叟。", "信意颠狂胡乱走。", "大道平夷。", "跂径便心逐景迷。", "因观慧口。", "渺邈精阳无中有。", "昼梦华胥。", "莹魄童儿天奕飞。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["无言无说。", "信任随缘消旧业。", "物我俱忘。", "晦迹韬光德自长。", "幻根寂灭。", "觉照圆通忘标月。", "直向当阳。", "一颗心珠混日光。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["人生幻化。", "咫尺无常全不怕。", "莫望来生。", "据算来生甚处行。", "前程路恶。", "剑戟臻侁难进脚。", "劝汝回头。", "随我逍遥物外游。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["身居火院。", "儿女妻奴由贪恋。", "惺悟痴除。", "鼓腹歌吟乐有馀。", "逍遥甚处。", "回首家山堪归去。", "豁落壶天。", "月湛澄江宝桂圆。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["真仙秘诀。", "志信忠良须引接。", "临义堤防。", "勿信邪言说短长。", "玉机漏泄。", "法眼灵光清皎洁。", "洞鉴精微。", "宝桂寒林素羽飞。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["澄神独坐。", "进锐纷纭尝自挫。", "外户长扃。", "内库劳封守宝瓶。", "玄光飞过。", "撞透虚空心鼎破。", "金碧丹瑛。", "满目灵芝气象清。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["净无瑕翳。", "握固存神颐浩气。", "润谷玄霜。", "养就神砂满鼎香。", "清如赫日。", "瑞气凝空盈满室。", "混一先天。", "易御星仪达妙玄。"], "annotations": []}, {"title": "益寿美金花", "paragraphs": ["擘开鬼窟。", "杳杳冥冥精恍惚。", "满目华阳。", "□耀灵珠映日光。", "至真无物。", "宝灿精□明返复。", "致死不忘。", "星