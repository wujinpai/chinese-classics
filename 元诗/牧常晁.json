{"dynasty": "元", "author": "牧常晁", "author_desc": "", "works": [{"title": "梧桐树", "paragraphs": ["这金丹，无二道。", "方寸不离真水火，既未相颠倒。", "个中运用不辞劳。", "海底天心呼吸到。", "现出长生宝。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["守真元，专一气。", "婴儿养就吾身里。", "十月胎圆备。", "万般譬喻总皆非。", "大底由他心意地。", "外觅徒劳耳。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["这丹头，牢结媾。", "念头动处灵丹走。", "固济要无漏。", "绵绵一气三关透。", "拨转天轮行火候。", "金鼎蟾光透。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["学道人，知端的。", "要须认取元初一。", "休外寻觅。", "初因一气成形质。", "配合阴阳生万物。", "此身实自玄元出。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["道无他，心为主。", "执象拘文徒自苦。", "记取圣贤语。", "丹经譬喻千万句。", "止是阴阳两个字。", "要识根元处。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["谩腾腾，无造作。", "任意逍遥随饮啄。", "真个清平乐。", "喉手幸无名利索。", "万里孤云并野鹤。", "这般谁知觉。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["得人身，元自错。", "莫信愚痴常造恶。", "积善□□乐。", "为人幸是生中国。", "闻早回头参玄学。", "休被尘劳缚。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["参玄人，听付嘱。", "百岁光阴如迅速。", "转眼花开落。", "大事因缘如未熟。", "急须猛省开心目。", "莫被邪师惑。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["汞即心，铅即气。", "汞铅结就丹根蒂。", "产在西南地。", "坎离龙虎总由伊。", "性命阴阳只这是。", "劝君早留意。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["早修行，听劝谕。", "绿鬓朱颜易变故。", "光景流如注。", "妻儿金宝暂相遇。", "到了何曾将得去。", "不用萦怀虑。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["学无为，离尘俗。", "结草为庵山水绿。", "散诞无拘束。", "南山看过牛如玉。", "人牛且喜俱相熟。", "脱下蓑衣吹一曲。"], "annotations": []}, {"title": "梧桐树", "paragraphs": ["世间人，须觉悟。", "难得人身休辜负。", "莫把时虚度。", "不离方寸蓬莱岛。", "多少时人行不到。", "劝君早觅长生路。"], "annotations": []}]}