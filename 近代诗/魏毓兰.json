{"dynasty": "近现代", "author": "魏毓兰", "author_desc": "", "works": [{"title": "菩萨鬘·庚申之秋，久病初起，淹迹龙城，昔日知交率迁调以去。孤馆寂寥，触境兴怀，殊无聊赖。倚声集句，寄吉垣政厅周斗钦玉柄厅长", "paragraphs": ["风吹画角孤城晓。", "破裘不补知寒早。", "木叶向人飘。", "辛勤鬓易凋。", "梦回鸡塞远。", "烟锁深深院。", "谁竟是知音。", "低徊一寸心。"]}, {"title": "减兰·暮春江上", "paragraphs": ["淡烟疏柳。", "十分春色今无九。", "流水孤村。", "南浦离愁入梦魂。", "落花飞絮。", "小立东风谁共语。", "雨恨云愁。", "芳草斜阳古渡头。"]}, {"title": "点绛唇·辛酉春仲别袁秘书长洁珊", "paragraphs": ["聚散匆匆，白沙翠竹江村路。", "暮云烟树。", "都为相思苦。", "憔悴天涯，有意同谁语。", "浑无绪。", "闲秋几许。", "最怕黄昏雨。"]}, {"title": "蝶恋花·春暮和作", "paragraphs": ["碧玉高楼临水住。", "燕子呢喃，恼破春情绪。", "满眼游丝兼落絮。", "纱窗一阵萧萧雨。", "尽日东风吹柳树。", "带得春来，又送春归去。", "著意留春春不许。", "问花花又娇无语。"]}, {"title": "忆王孙·送于九之扶余，时在望江楼上", "paragraphs": ["故园何处此登楼。", "王粲春来更远游。", "月落猿啼送客舟。", "去悠悠。", "惟见长江天际留。"]}, {"title": "渔家傲·春闺，寄梦蝶长春", "paragraphs": ["西楼望月人共远。", "困人天气帘慵卷。", "愁对画梁双语燕。", "音尘断。", "沉吟不语晴窗畔。", "鸾镜朱颜惊暗换。", "百花时节教人懒。", "尽日相思罗带缓。", "啼莺散。", "梨花瘦尽东风软。"]}, {"title": "青玉案·怀黄申甫北平", "paragraphs": ["天涯何处无芳草。", "山色东西多少。", "杜宇教唆春去早。", "别情离绪，数声啼鸟。", "都入相思调。", "去年人到今年老。", "帘外落花闲不扫。", "池草梦回诗思杳。", "断云残日，关山故道。", "鱼雁何时到。"]}, {"title": "谒金门·乡思", "paragraphs": ["空相忆。", "惆怅此情难寄。", "浊酒一杯家万里。", "年年江海客。", "心事有谁知得。", "欲起还涌未起。", "过眼韶华有几。", "画楼愁独倚。"]}, {"title": "醉花阴·春闺，寄大颠济南", "paragraphs": ["睡起花阴初转午。", "有意同谁语。", "记得别郎时，才过清明，烟柳暗南浦。", "眼底韶华戎衣度。", "不道春将暮。", "后会杳何时，帘卷西风，望断归来路。"]}, {"title": "破阵子·春思，柬冯问田", "paragraphs": ["惆怅旧欢如梦，一春无限思量。", "小立东风谁共语，那堪独自步池塘。", "柳色过邻墙。", "悔不当初留住，为他花月凄凉。", "十二栏干闲倚遍，暗思何事立残阳。", "岁闰觉春长。"]}, {"title": "菩萨鬘·春闺，沈阳旅次感作", "paragraphs": ["红英落尽青梅小。", "天涯何处无芳草。", "凭槛欲沾衣。", "王孙归不归。", "问花花不语。", "望断春归处。", "独抱影儿眠。", "相逢尔许难。"]}, {"title": "卜算子·登望江楼有感", "paragraphs": ["春水碧于天，野旷天低树。", "乘兴闲看万里流，且莫乘流去。", "寂寞对汀洲，故国知何处。", "凭著朱栏思浩然，处处牵愁绪。"]}, {"title": "踏莎行·江村题壁", "paragraphs": ["流水孤村，淡烟微雨。", "杜鹃声里斜阳暮。", "醉来扶上木兰舟，醒来忘却桃源路。", "短梦惊回，乱红流去。", "楼头水阔山无数。", "清溪西畔小桥东，武陵风景知何处。"]}, {"title": "惜分飞·春闺，怀梯云营川", "paragraphs": ["满地落花红几片。", "楼外春愁无限。", "烟锁深深院。", "沉吟不语晴窗畔。", "鸾镜朱颜惊暗换。", "惆怅空教梦见。", "流水天涯远。", "茫茫只见双飞燕。"]}, {"title": "浣溪沙·望江楼同鹃声晚眺，时将赴川", "paragraphs": ["芳草斜阳古渡头。", "独携孤剑塞垣游。", "春风回首仲宣楼。", "目送征鸿飞杳杳，绿杨枝外尽汀洲。", "关河万里路悠悠。"]}, {"title": "菩萨鬘·春思，再柬问田", "paragraphs": ["穿帘燕子双双好。", "惜花人共春光老。", "独抱影儿眠。", "天涯殊未还。", "恼人春不管。", "酒熟凭花劝。", "无计奈情何。", "青山入梦多。"]}, {"title": "生查子·闺思，次味庄", "paragraphs": ["关山梦里长，梦转纱窗晓。", "檐雨细随风，花落知多少。", "今岁未还家，鱼雁何时到。", "忆君君不知，古道多芳草。"]}, {"title": "闲中好", "paragraphs": ["闲中好。", "梦转纱窗晓。", "万里故园心，醉里愁如扫。"]}, {"title": "闲中好", "paragraphs": ["闲中好。", "绿树闻歌鸟。", "未遣酒樽空，肯信春光老。"]}, {"title": "闲中好", "paragraphs": ["闲中好。", "鱼笋朝餐饱。", "此趣人不知，客醉花能笑。"]}, {"title": "归国谣·春暮，寄黄山友人", "paragraphs": ["春欲去。", "尽日东风吹绿树。", "帘外落红无数。", "莺声留不住。", "心事欲谁分付。", "问花花不语。", "无酒无诗情绪。", "绿杨三月暮。"]}, {"title": "归国谣", "paragraphs": ["湘帘卷。", "十二栏干闲倚遍。", "楼外春愁无限。", "远山欹枕见。", "满地落花千片。", "日长蜂蝶乱。", "惆怅空教梦见。", "恼人春不管。"]}, {"title": "归国谣·闺思", "paragraphs": ["深相忆。", "新恨旧愁眉上集。", "心事有谁知得。", "绣花无气力。", "芳树重重凝碧。", "楼台山色里。", "惆怅此情难寄。", "断肠人独立。"]}, {"title": "玉楼春·本意", "paragraphs": ["楼头水阔山无数。", "弱柳系船都不住。", "一年春事又杨花，眼底韶华容易度。", "相思心住东流去。", "小立东风谁共语。", "栏干倚遍使人愁，深闭重门听夜雨。"]}, {"title": "丑奴儿·题美女图", "paragraphs": ["酡颜一笑夭桃绽，寸寸柔肠。", "无限思量。", "未解知羞最爱狂。", "金钗斜带宜春胜，玉佩珠珰。", "带绣鸳鸯。", "并蒂芙蓉本自双。"]}, {"title": "玉树后庭花·春感，和公竺", "paragraphs": ["残花飞满帘前路。", "深沉院宇。", "许多心事谁传与。", "昼长无侣。", "欲凭莺语留春住。", "烟迷津树。", "纱窗一阵萧萧雨。", "闲愁几许。"]}, {"title": "玉树后庭花", "paragraphs": ["卷帘半醉春风好。", "离情杳杳。", "一庭风日知音少。", "暗伤怀抱。", "归来应被青山笑。", "归盟误了。", "惜花人共春光老。", "数声啼鸟。"]}]}