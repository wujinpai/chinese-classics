{"dynasty": "清", "author": "恽珠", "author_desc": "", "works": [{"title": "点绛唇 夏日偶成", "paragraphs": ["漫卷湘帘，正雨过凉生庭院。", "绿荫葱茜。", "好鸟枝头啭。", "午梦初回，懒去拈针线。", "诗情倦。", "茶经香传。", "且自闲消遣。"], "annotations": []}, {"title": "点绛唇 秋夜", "paragraphs": ["夜静天空，西风料峭秋声老。", "浮云如扫。", "月到天心小。", "一卷南华，解却愁多少。", "香闺悄。", "炉烟细袅。", "锦帐罗衾好。"], "annotations": []}, {"title": "渔歌子 舟中晚眺", "paragraphs": ["高柳荫浓罩绿溪。", "轻舟摇过小桥西。", "波潋滟，影迷离。", "斜阳几树晚鸦栖。"], "annotations": []}, {"title": "如梦令 风雨遣怀", "paragraphs": ["窗外潇潇风雨。", "春在儿家庭户。", "懒去理瑶琴，闲倚雕栏无语。", "愁绪。", "愁绪。", "又听数声杜宇。"], "annotations": []}, {"title": "忆江南 闺情", "paragraphs": ["空庭静，翠色上帘旌。", "好鸟数声惊梦短，落花几片点苔轻。", "无语总含情。"], "annotations": []}, {"title": "甘州子 晓妆", "paragraphs": ["菱花乍启觑分明。", "云鬓拢，玉钗横。", "茜衣新试越罗轻。", "何事最关情。", "深巷里，风送卖花声。"], "annotations": []}]}