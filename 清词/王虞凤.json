{"dynasty": "清", "author": "王虞凤", "author_desc": "", "works": [{"title": "相见欢", "paragraphs": ["新兴蛾髻如盂。", "插金鹅。", "点点蔷薇香露、沁牙梳。", "匀面罢，呼女伴，坐氍歈。", "又向绿窗深处、赌樗蒲。"], "annotations": []}, {"title": "相见欢", "paragraphs": ["雕栏笼鸟无声。", "耽窗明。", "两两黄蜂抱蕊、刺纱棂。", "凭湘几，匀银管，画绡屏。", "印出些些花样、粟纹轻。"], "annotations": []}, {"title": "贺圣朝", "paragraphs": ["彩线抛残金剪慵。", "绿鬟松。", "些些香唾湿残绒。", "小窗中。", "阿母拾花翻绣架，脸霞红。", "低垂凤颈剔春葱。", "意惺忪。"], "annotations": []}, {"title": "生查子 怀姊", "paragraphs": ["忆昔别离时，欲想心先痛。", "独自拥寒衾，一夜难成梦。", "只见碧纱窗，竹影频移动。", "残月冷花梢，幽恨和伊共。"], "annotations": []}]}