{"dynasty": "清", "author": "颜氏", "author_desc": "", "works": [{"title": "浪淘沙", "paragraphs": ["箫史韵凄凉。", "月冷筠廊。", "本来劲节傲冰霜。", "地下人间心一点。", "幻影茫茫。", "白发两高堂。", "暮景悲伤。", "亲调药饵检丹方。", "泪洒西风红叶里。", "一带斜阳。"], "annotations": []}, {"title": "点绛唇 题孔蕴光女史籍兰诗后", "paragraphs": ["黄鹄吟馀，声声字字俱呜咽。", "素心凄绝，鸾镜悲残缺。", "点笔窗间，树树鹃啼血。", "冰心洁。", "冷如寒雪，皎似天边月。"], "annotations": []}]}