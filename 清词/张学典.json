{"dynasty": "清", "author": "张学典", "author_desc": "", "works": [{"title": "浣溪沙 秋闺闻雁", "paragraphs": ["庭院萧疏落叶稠。", "数声寒雁起汀洲。", "惊回蝶梦故园游。", "翠柳凋残宁似惜，黄花憔悴不禁秋。", "仰看双影漫凝眸。"], "annotations": []}, {"title": "苏幕遮 咏秋海棠和外", "paragraphs": ["嫩舒红，轻剪翠。", "拂拭新妆，一种天然媚。", "浅晕胭脂凝宿醉。", "力怯凭阑，香梦初惊起。", "映残霞，笼晓雾。", "娇态含情，欲语还羞吐。", "自是月中丹桂侣。", "一夜金风，吹向瑶阶聚。"], "annotations": []}, {"title": "蝶恋花 六妹放纸蝶戏作", "paragraphs": ["绛袖玉纤牵一线。", "新制云衣，冉冉凌空展。", "赵后香魂疑更返。", "东君谪作探花伴。", "斜逐游蜂过柳院。", "倦绣佳人，误扑轻罗扇。", "一自飘扬春不管。", "多情空把东风怨。"], "annotations": []}, {"title": "蝶恋花", "paragraphs": ["力弱巧将纤缕系。", "粉翅翩翩，恐逐东风去。", "未解寻香花下度。", "玉人芳信犹耽误。", "轻薄却同飞絮舞。", "乍见疑真，扑向枝头堕。", "可是蒙庄幽梦破。", "魂消不识春归路。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["远烟笼翠舒新柳。", "春光暗向楼中逗。", "莫把绣帘开。", "东风引恨来。", "遥山云一带。", "人在云山外。", "芳草似离情。", "逢春处处生。"], "annotations": []}]}