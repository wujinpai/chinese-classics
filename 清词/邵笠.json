{"dynasty": "清", "author": "邵笠", "author_desc": "", "works": [{"title": "菩萨蛮", "paragraphs": ["乱莺啼破流苏梦。", "樱桃露湿花梢重。", "小婢促梳头。", "开奁满镜愁。", "画眉人不在。", "蹙损双螺黛。", "淡日上红纱。", "轻蝉鬓影斜。"], "annotations": []}, {"title": "虞美人", "paragraphs": ["金铃密缀桐龙凤。", "粉淡檀痕重。", "半遮团扇眼波斜。", "多恐养娘偷检、守宫砂。", "翠眉一霎愁峰锁。", "挼碎芙蓉朵。", "问伊底事忽娇嗔。", "道是采花掠乱、鬓梢云。"], "annotations": []}, {"title": "步蟾宫 中秋", "paragraphs": ["风尖云嫩山容瘦。", "数飞鸟、鸦前鹊后。", "夜阑带醉听箫声，恍瞥见、谁家红袖。", "蟾钩穿过疏林骤。", "桂子落、满山金镂。", "桥边错认玉人来，惹裙带、暗香偷嗅。"], "annotations": []}, {"title": "凤凰台上忆吹箫 秋夜怀姊", "paragraphs": ["桂院香残，松窗月冷，孤鸿呖乱楼头。", "见梧桐摇落，叶叶惊秋。", "几阵轻风暗度，窗儿外、细戛帘钩。", "听砧声，随风断续，惹起闲愁。", "悠悠。", "玉人别后，又三秋去也，谁与绸缪。", "对孤灯兀坐，冷落香篝。", "画阁深沉独自，镇日里、挨尽清幽。", "无聊赖，且凭绿绮，一曲凉州。"], "annotations": []}]}