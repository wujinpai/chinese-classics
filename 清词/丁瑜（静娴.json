{"dynasty": "清", "author": "丁瑜（静娴", "author_desc": "", "works": [{"title": "如梦令 春闺", "paragraphs": ["卷幔难消长昼。", "花落鸟啼时候。", "罗绮试新妆，剪剪轻烟香瘦。", "纤手。", "纤手。", "笑指鸳鸯佳偶。"], "annotations": []}, {"title": "长相思 忆外", "paragraphs": ["听钟声。", "数寒更。", "窗外芭蕉滴到明。", "梦儿也无情。", "薄罗轻。", "玉钗横。", "目送新鸿字未成。", "非关宿酒醒。"], "annotations": []}, {"title": "昭君怨 秋闺", "paragraphs": ["帘外秋声何早。", "染得叶儿黄了。", "泪湿倚栏杆。", "怯衣单。", "正是伤情时候。", "新恨浓浓如酒。", "好梦忽然惊。", "梦中莺。"], "annotations": []}, {"title": "桃源忆故人 闺怨", "paragraphs": ["一轮皎皎清如水。", "慵把朱颜妄拟。", "斜挂柳梢何意。", "想照征人矣。", "梦魂昨夜纱窗里。", "记得吴头楚尾。", "纵有绸缪双鲤。", "更胜青梅味。"], "annotations": []}, {"title": "南乡子 闺情", "paragraphs": ["钗凤似飞鸦。", "袅袅香罗笼绛纱。", "妆罢戏将红豆掷，休哗。", "无数黄莺闹柳衙。", "蓬岛即伊家。", "那得轻乘天上槎。", "只恐无情如柳絮，愁他。", "夜半殷勤诉月华。"], "annotations": []}, {"title": "虞美人 忆外", "paragraphs": ["疏篱隐隐迷天晓。", "帘卷云山小。", "数行雁字自南来。", "却带相思离恨、万千回。", "东风一夜添憔悴。", "滴尽长江泪。", "痴情日日倚妆台。", "只恐梦魂无据、过阳台。"], "annotations": []}]}