{"dynasty": "清", "author": "路传经", "author_desc": "", "works": [{"title": "淡黄柳 疏柳", "paragraphs": ["西风几日，一带黄金陌。", "摇落朱楼芳槛侧。", "水驿旗亭烟冷，顿觉纤腰瘦无力。", "远山隙，丝丝尚凝碧。", "遮不住，陶潜宅。", "只残鸦几点还相识。", "一样销魂，后湖荷盖，近来也恁萧瑟。"], "annotations": []}, {"title": "更漏子 落叶声", "paragraphs": ["碧天高，凉月小。", "蓦地声来秋杪。", "堆金井，落荒铺。", "寒枝起夜乌。", "松阁静，湘帘冷。", "簌簌寂无人影。", "谁染就一林枫。", "飘零万点红。"], "annotations": []}]}