{"dynasty": "清", "author": "储慧", "author_desc": "", "works": [{"title": "一剪梅", "paragraphs": ["旭日东升上海棠。", "红映雕梁。", "绿映瑶窗。", "晓妆才罢出兰房。", "罗袂生香。", "锦袜生凉。", "风送飞花处处飏。", "鸭唼回塘。", "燕啄回廊。", "流萤也解惜春光。", "半学调簧。", "半劝飞觞。"], "annotations": []}, {"title": "少年游 美人足", "paragraphs": ["玉笋才芽，金莲未蕊，裂帛裹初成。", "兜罢弓鞋，藏来锦袜，点地更轻盈。", "香尘留得纤纤印，软步悄无声。", "藕覆轻移，榴裙低掩，瘦处可怜情。"], "annotations": []}, {"title": "忆江南", "paragraphs": ["梅风紧，冷透绮罗裳。", "悄地正怀天末意，画堂忽讶报芹香。", "喜拆锦书忙。"], "annotations": []}, {"title": "相见欢", "paragraphs": ["月明才上帘钩。", "正凝眸。", "忽忆去年今日、动离愁。", "柳初绿，征帆促，恨难留。", "寂寞而今经岁、锁眉头。"], "annotations": []}, {"title": "捣练子", "paragraphs": ["莺语急，蝶魂惊。", "风雨催春一霎行。", "绕遍阑干愁独倚，伤春何必为离情。"], "annotations": []}, {"title": "惜分飞", "paragraphs": ["帘幕深沉人静悄。", "杜宇数声啼了。", "梦醒纱窗晓。", "博山宝篆香犹袅。", "睡起凝妆浑觉早。", "窥镜眉痕略扫。", "著意东风小。", "海棠一夜开多少。"], "annotations": []}, {"title": "惜分飞 忆从二姑", "paragraphs": ["欲别还期相聚首。", "记得叮咛时候。", "一去音沉久。", "病馀弱骨摧残否。", "匪石贞心终自守。", "荼毒怎生禁受。", "玉质应非旧。", "连宵梦见分明瘦。"], "annotations": []}, {"title": "醉花阴", "paragraphs": ["曲沼芙蕖香乍透。", "看睡鸳如绣。", "恼的是蝉声。", "纨扇频摇无计、消炎昼。", "新词按拍清商奏。", "喜晚凉还骤。", "攀取碧筒杯。", "试酌金波小饮、黄昏后。"], "annotations": []}, {"title": "南乡子", "paragraphs": ["流火恰才收。", "南院先惊一叶秋。", "络纬啼残金井里，含愁。", "倦倚雕栏看女牛。", "莲瓣堕溪流。", "雨褪红妆水国忧。", "未卜征鸿何日到，凝眸。", "丹桂飘香罢倚楼。"], "annotations": []}, {"title": "南乡子 新葺秦邮学署，并建柏荫轩，落成寄怀仙芝姑母", "paragraphs": ["槐市最清严。", "喜辟新居敞画檐。", "月转回廊花映槛，垂帘。", "风弄银钩戛响尖。", "伴侣故乡淹。", "辜负琴樽乐事兼。", "绣阁依依浑似梦，愁黏。", "便饮香醪不喜添。"], "annotations": []}, {"title": "南乡子 冬夜即事", "paragraphs": ["月色淡银蟾。", "阵阵风声到画檐。", "应是晚来天欲雪，廉纤。", "细雨如丝冻不黏。", "炉火阁中添。", "坐拥金貂下绣帘。", "满室春温寒不到，红酣。", "数朵盆花映镜奁。"], "annotations": []}, {"title": "秋蕊香 七夕", "paragraphs": ["帘卷星辉如昼。", "织女渡河时候。", "龙梭此际应离手。", "博得鹊桥填就。", "一年一度光阴骤。", "滞清漏。", "支机石畔重逢又。", "不似尘寰别久。"], "annotations": []}, {"title": "散馀霞 前题", "paragraphs": ["粉墙低亚重重影。", "渐玉阶人静。", "道是天上良宵，正秋清夜永。", "人间曲阑独凭。", "引苕苕离恨。", "举酒暗祝双星，愿团圆共证。"], "annotations": []}, {"title": "滴滴金 病中自述", "paragraphs": ["蕉阴黯淡斜阳色。", "恁迟迟，过窗隙。", "镇日如年挨向夕。", "更昏沉无力。", "那堪千里音尘隔。", "渺难闻，空相忆。", "脉脉衷情何处说。", "纵离魂谁惜。"], "annotations": []}, {"title": "少年游 喜外乡捷", "paragraphs": ["小病恹恹，重阳过了，整日下帘栊。", "盼煞江南，音书未到，相对话喁喁。", "泥金忽报登科信，喜色上眉峰。", "愿祝郎君，明年及第，人镜艳芙蓉。"], "annotations": []}, {"title": "蝶恋花 忆外京邸病状", "paragraphs": ["独对残红眉暗皱。", "青鸟来时，正是春归后。", "惆怅京华人病久。", "而今不识平安否。", "想是芸窗攻苦骤。", "更为思亲，忆别成消瘦。", "盼到玉堂欢聚首。", "妆台细把衷情剖。"], "annotations": []}, {"title": "蝶恋花 寄仙芝姑母", "paragraphs": ["绣阁依依分袂后。", "一日三秋，试问君知否。", "早约重来期莫负，而今底事还延久。", "况是重阳难聚首。", "寂寞黄花，也似人消瘦。", "待得相逢开笑口，金尊共倒花间酒。"], "annotations": []}, {"title": "减字木兰花 赠仙芝姑母", "paragraphs": ["冰霜怀抱。", "十载钦迟劳远道。", "把臂而今。", "喜偕闺中当竹林。", "相怜非偶。", "石上三生缘夙有。", "豁达如君。", "肯比嫦娥逊几分。"], "annotations": []}, {"title": "减字木兰花 为从二姑作", "paragraphs": ["闷怀遮掩。", "强似无愁含笑脸。", "便问漂流。", "诉到伤心话即休。", "明知无奈。", "不肯将身填孽债。", "却怪灵娲。", "会补青天缺几些。"], "annotations": []}]}