{"dynasty": "清", "author": "沈士芳", "author_desc": "", "works": [{"title": "渔歌子", "paragraphs": ["凉气萧萧坐久生。", "风吹败叶落闲庭。", "窗纸响，砌蛩吟。", "残月依依影半明。"], "annotations": []}, {"title": "清平乐", "paragraphs": ["柳风梅雪。", "绣幕云驱月。", "花气扑帘香影折。", "睡暖一双蝴蝶。", "敛眉独倚金扉。", "轻寒吹上铢衣。", "满地星红小绿，凤尖怕蹴香泥。"], "annotations": []}, {"title": "相思引", "paragraphs": ["绣阁无心理翠𫔇。", "臂环轻卸耳珰欹。", "鹧鸪香冷，频揭玉狻猊。", "雁婿衔霜传锦字，猧儿带月护铜扉。", "无多春色，又逐杏花飞。"], "annotations": []}, {"title": "相思引", "paragraphs": ["蟾影筛花印翠蚨。", "为寻粉蝶上兰陂。", "板桥怯渡，笑带柳枝扶。", "归路卸头灯背立，回波旖旎态摩挲。", "春图半幅，香阁背人摹。"], "annotations": []}]}