{"dynasty": "清", "author": "陈敬（端宁", "author_desc": "", "works": [{"title": "画堂春 送春   见《词综》、《词雅》", "paragraphs": ["呢喃双燕傍檐飞。", "绿阴摇曳成围。", "朝来便觉眼前非。", "初试罗衣。", "宝马香车人散，金铃彩幔花稀。", "年年此际对斜晖。", "可奈春归。"], "annotations": []}, {"title": "忆秦娥 忆姊", "paragraphs": ["心如结。", "风前空把名香𦶟。", "名香𦶟。", "姊归何处，贝宫瑶阙。", "银釭频剔明还灭。", "听来村鼓含悲咽。", "含悲咽。", "怕伤亲意，泪珠偷浥。"], "annotations": []}, {"title": "如梦令 灯花", "paragraphs": ["缥缈绿烟笼雾。", "一朵朱蕤明吐。", "春色贮银釭，空使蝶忙蜂妒。", "休误。", "休误。", "莫作等闲花数。"], "annotations": []}]}