{"dynasty": "清", "author": "钟青", "author_desc": "", "works": [{"title": "如梦令 五月十五夜", "paragraphs": ["皓月柳梢堪恋。", "风散榴花片片。", "总是一情痴，可惜流光如电。", "倚遍。", "倚遍。", "花影遮人半面。"], "annotations": []}, {"title": "西溪子 梨花", "paragraphs": ["淡荡相宜月下，媚态光宜朝夜。", "曲栏边，人不见。", "愁无限。", "错嫁东风难恋。", "零落晓枝头。", "一春休。"], "annotations": []}, {"title": "浪淘沙 寄眉令妹", "paragraphs": ["寂寞久临风。", "敛步从容。", "春来懒玩小墙东。", "怕他撩乱花飞处，芳草茸茸。", "忆别恨匆匆。", "失语无穷。", "何如那日莫相逢。", "可惜一番光景好，心与谁同。"], "annotations": []}, {"title": "惜分钗 海棠", "paragraphs": ["情难判。", "春时半。", "东风爱拂初醒面。", "晓烟笼。", "碧霞容。", "态若轻云，醉舞腾空。", "溶。", "溶。", "何人伴。", "肠应断。", "疑嗔疑笑胭脂浅。", "思无穷。", "恨谁同。", "月色扶来，梦入闺中，重。", "重。"], "annotations": []}]}