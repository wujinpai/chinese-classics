{"dynasty": "清", "author": "顾若璞", "author_desc": "", "works": [{"title": "浣溪沙", "paragraphs": ["嫩柳牵丝覆绮窗。", "起来无绪理明珰。", "恼人最是日初长。", "三尺乌云随意挽，两条却月待萧郎。", "胡琴闲放竹方床。"], "annotations": []}, {"title": "浣溪沙", "paragraphs": ["绿水红莲一带妍。", "荷衣欲剪惜金钱。", "可怜㶉𫛶不同眠。", "纨扇看来心已碎，迎凉盼不到秋天。", "算来又怕说秋天。"], "annotations": []}, {"title": "长相思 春词", "paragraphs": ["梅子青。", "豆子青。", "飞絮飘飘扑短襟。", "风褰罗袖轻。", "送芳辰。", "惜芳辰。", "春事支离些个情。", "眉峰恨几层。"], "annotations": []}, {"title": "长相思", "paragraphs": ["春先到。", "愁先到。", "嫩莺故对新丛叫。", "懒把云和抱。", "愁先到。", "春先到。", "花轻蝶乱东风袅。", "捻却花相照。"], "annotations": []}, {"title": "减字木兰花 月夜闻沈媚清夫人吹箫", "paragraphs": ["雨收风细。", "一片清光疑是洗。", "秦女楼头。", "吹出柔肠几许愁。", "花枝掩映。", "素腕金环频弄影。", "香软寒轻。", "寂寂帘帏夜不扃。"], "annotations": []}, {"title": "玉楼春 晚春，三桥看月", "paragraphs": ["花飞锦带春波起。", "残月流辉明水底。", "万珠灼烁照新妆，故掬嫦娥纤手里。", "柳线牵烟轻重绿。", "渔灯高下鸳鸯宿。", "无情花柳送归春，不管离人肠断续。"], "annotations": []}, {"title": "忆王孙 织女怨", "paragraphs": ["年年云锦织天孙。", "银汉无情劳梦魂。", "乌鹊声声隔岸闻。", "怨黄昏。", "烟锁琼楼月到门。"], "annotations": []}, {"title": "忆秦娥", "paragraphs": ["晓莺呕。", "懒梳云鬓上秦楼。", "上秦楼。", "一帘春色，惹起新愁。", "杨花飘荡弄轻柔。", "残红零落倩谁收。", "倩谁收。", "乌盐歌罢，倦倚箜篌。"], "annotations": []}]}