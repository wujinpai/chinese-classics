{"dynasty": "清", "author": "屠茝佩", "author_desc": "", "works": [{"title": "南乡子 秋思", "paragraphs": ["独上楼西。", "绿鬟鸾镜晓妆低。", "半暖乍寒花影静，重思省。", "听得砧声着意整。"], "annotations": []}, {"title": "七娘子 喜晴", "paragraphs": ["湿云销尽朝阳皎。", "庭前绿遍忘忧草。", "玫瑰香浓，紫霞凌晓。", "重帘不锁炉烟袅。", "树头梅子青多少。", "熏风吹透荷钱小。", "愁在眉山，欣看林表。", "芳菲又恐莺啼早。"], "annotations": []}]}