{"dynasty": "清", "author": "陆珊", "author_desc": "", "works": [{"title": "谒金门 题芳草胡蝶便面", "paragraphs": ["春欲去。", "不管落红如雨。", "胡蝶留春春不住。", "依依芳草路。", "写上滕王图谱。", "锦翼对飞双舞。", "爱傍画裙香重处。", "夜来仙梦度。"], "annotations": []}, {"title": "清平乐 秋蛩", "paragraphs": ["嘈嘈切切。", "多少闲愁说。", "不管愁人肠百结。", "一夜小楼听彻。", "声声梦断西窗。", "奈何秋夜偏长。", "推枕揽衣起坐，床前明月如霜。"], "annotations": []}, {"title": "唐多令 用草窗韵", "paragraphs": ["谢了木芙蓉。", "一年花事空。", "望家乡、心事归鸿。", "越水胥江天咫尺，飞不过，数山峰。", "画烛影摇红。", "乱蛩吟砌东。", "待消愁、酒浅愁浓。", "病骨支床眠不得，听疏雨，打梧桐。"], "annotations": []}, {"title": "蝶恋花", "paragraphs": ["春色三分抛一半。", "阵阵芳红，飞去难留绾。", "欲折好花休更晚。", "怕它莺老啼声换。", "蜂音燕语增烦惋。", "梦比河长，愁比天涯远。", "雨雨风风还逼趱。", "瞢腾只把杯斟满。"], "annotations": []}, {"title": "扫花游 西湖新绿", "paragraphs": ["两峰霁雨，正艳艳盈盈，冶鬟如笑。", "画眉未了。", "试新黄浅绿，淡笼轻扫。", "翠色生生，燕子钗头细袅。", "镜奁晓。", "似汉殿新妆，帘卷人俏。", "堤岸图画绕。", "衬曲色裙痕，暖波芳草。", "暮烟更好。", "蘸斜阳一片，水云深窈。", "数点娇红，逗出宫桃瘦小。", "听莺早。", "莫教它、翠阴春老。"], "annotations": []}, {"title": "疏影", "paragraphs": ["千回百折。", "顿悲来满臆，甚于针刺。", "酸上心头，泪下襟头，寸肠浑似梭织。", "愁时怕把啼痕揾，越揾住、越和愁结。", "算生来、瘦骨柔魂，禁得几番凄恻。", "懊恼邻家儿女，话黄昏妮妮，添助萧瑟。", "倚枕摩挲，梦又惊残，欲睡何曾睡得。", "深宵万种柔情绪，只一点、夜灯知悉。", "道无人、说与愁思，量取画裙宽窄。"], "annotations": []}, {"title": "河传 兰", "paragraphs": ["空谷。", "幽独。", "谁知我者。", "月明风穆。", "众香丛里抱遐心。", "瑶琴。", "一弹山气深。", "绿窗人静珠帘下。", "芳情写。", "艳想都抛谢。", "望湘沅。", "路漫漫。", "无言。", "楚骚吟又叹。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["听。", "何处临风玉笛鸣。", "高楼倚，吹起故乡情。"], "annotations": []}, {"title": "玉楼春 庭中新植牡丹放花", "paragraphs": ["玉环百媚盈盈笑。", "罗绮三千都压倒。", "装成金屋护风欺，烧起银釭当夜照。", "人间富贵难征兆。", "只愿画堂春莫老。", "露华酣染几朝昏，独倚阑干频起早。"], "annotations": []}, {"title": "浣溪沙 并蒂莲", "paragraphs": ["白水盟心两意同。", "颤盈盈立态何秾。", "脸霞偎得十分红。", "贮稳一枝金屋里，照来双影画屏中。", "对花人语自喁喁。"], "annotations": []}, {"title": "清平乐", "paragraphs": ["梦回莺啭。", "催起情还懒。", "画了娥眉云鬓绾。", "已自卖花声远。", "韶光暗里消磨。", "闲愁可奈春何。", "燕子也怜人病，去来频拂帘波。"], "annotations": []}, {"title": "谒金门", "paragraphs": ["秋满院。", "莫道秋花寒贱。", "紫姹红嫣纷在眼。", "浓于春圃绚。", "晨起殷勤手灌。", "相映晓妆容倩。", "帘卷西风人特健。", "傲它霜片片。"], "annotations": []}, {"title": "南歌子 泥美人", "paragraphs": ["滴粉搓酥巧，深脂浅黛妍。", "淡妆缟袂意翩跹。", "笑倚东风欲语、又无言。", "宜喜望嗔面，多情少恨颜。", "盈盈我见也生怜。", "伴我青灯黄奶、夜窗前。"], "annotations": []}, {"title": "南乡子 春雨写闷", "paragraphs": ["无赖是东风。", "吹出愁云恨雨浓。", "花落春城飞不得，流红。", "都付长沟暗水中。", "寂寞掩帘栊。", "滑滑禽声唤懊侬。", "燕姹莺娇何处去，天公。", "一片苍烟皓雾重。"], "annotations": []}, {"title": "喝火令", "paragraphs": ["买醉红螺酌，游仙绿绮弹。", "愁思难得片时阑。", "偏又抬头瞥见，镜样月儿圆。", "闷掩窗朱鸟，慵偎被彩鸾。", "待寻幽梦到乡关。", "无奈千川，无奈万重山。", "无奈层层春树，叠叠暮云拦。"], "annotations": []}, {"title": "长相思", "paragraphs": ["风丝丝。", "雨丝丝。", "织到愁人肠断时。", "绿杨还乱吹。", "昼迟迟。", "日迟迟。", "无数飞红吹下枝。", "流莺偏又知。"], "annotations": []}, {"title": "浣溪沙 咏一足踢帐", "paragraphs": ["六柱湘筠一指攐。", "碧纱舒卷漾轻烟。", "梦回错认短蓬圆。", "曲榭凭张云作帷，扁舟不碍月盈肩。", "倦来随处好游仙。"], "annotations": []}, {"title": "生查子 杨妃病齿图", "paragraphs": ["睡起海棠慵，斗蹙双蛾晕。", "浑懒启朱唇，反怪君王问。", "停进荔枝浆，尚困梨花酝。", "歌曲歇霓裳，多少闲愁恨。"], "annotations": []}, {"title": "生查子 太真出浴图", "paragraphs": ["罗袂护春寒，小立屏山畔。", "出水玉芙蓉，一段巫云现。", "娇倩侍儿护，皓腕横金钏。", "女伴见犹怜，披与轻绡茜。"], "annotations": []}, {"title": "南歌子 七月八日坐夜", "paragraphs": ["暮雨银河洗，微凉绣幕招。", "月钩金挂翠云绡。", "正是新秋第一、好良宵。", "扇懒流萤扑，香残宝鸭烧。", "倚楼何处学吹箫。", "闲看一庭花影、上林梢。"], "annotations": []}, {"title": "菩萨蛮 初秋湖上", "paragraphs": ["绕堤荷盖田田立。", "万丛绿里娇红出。", "朝露染花肤。", "搴花罗袂濡。", "牵牛花数点。", "掩映秋容淡。", "小立六桥西。", "水痕岚翠低。"], "annotations": []}, {"title": "江城子 夜雪", "paragraphs": ["被池难熨夜寒生。", "梦初醒。", "小窗明。", "看月开门、正待下阶庭。", "吹下满天杨柳絮，黏翠袖，冷无声。", "晓来不怕剪风轻。", "卷纱棂。", "拓银屏。", "极目远山、遮却几分青。", "层叠远山全不见，惟一抹、白云横。"], "annotations": []}, {"title": "霜天晓角 除夕", "paragraphs": ["韶华暗徙。", "爆竹声声里。", "守到烛花成片，留不住，年如水。", "闺房占吉利。", "金钱罗玉几。", "岁岁年年如愿，团𪢮夜、总欢喜。"], "annotations": []}, {"title": "南歌子 山阴道上", "paragraphs": ["金碎明霞散，脂红落日悬。", "晚来乡思蓦悠然。", "遥想当楼残照、小窗间。", "渔梦醒残月，江村起曙烟。", "晓来乡思蓦悠然。", "雁度晴空只少、素书传。"], "annotations": []}, {"title": "忆秦娥 越中旅舍", "paragraphs": ["轻离别。", "一枝聊借身如叶。", "身如叶。", "寸眉双锁，寸肠千折。", "夜窗虚幌明如雪。", "羁人怕见天边月。", "天边月。", "举头谁共，大江澜叠。"], "annotations": []}, {"title": "醉太平", "paragraphs": ["虫声雁声。", "砧清笛清。", "唤回幽梦无成。", "数三更四更。", "愁形病形。", "花零絮零。", "翠裙斜倚银屏。", "怕新寒暮生。"], "annotations": []}, {"title": "忆秦娥", "paragraphs": ["秋凄凄。", "秋声秋声酸心脾。", "酸心脾。", "藓阶蛩絮，枫岸乌啼。", "月盈南浦花东篱。", "玉箫金管谁家吹。", "谁家吹。", "画堂春夜，忽忆当时。"], "annotations": []}, {"title": "忆秦娥 题大漠行旅图", "paragraphs": ["明驼疾。", "咸阳古道西风急。", "西风急。", "连天衰草，四无人迹。", "解鞍下骑聊休息。", "拥裘闲话家山隔。", "家山隔。", "天涯梦见，翠楼春色。"], "annotations": []}, {"title": "菩萨蛮 其一 簪茉莉美人", "paragraphs": ["画眉才了临妆镜。", "一枝斜飐生娇韵。", "倦压鬓云偏。", "呼鬟整翠钿。", "夜香烧月下。", "细步吹兰麝。", "卸向枕函旁。", "凉宵梦也香。"], "annotations": []}, {"title": "菩萨蛮 其二 簪茉莉美人", "paragraphs": ["露阶蛩语声呜咽。", "玉炉香尽天街寂。", "明月半窥帘。", "思乡人未眠。", "望云空伫立。", "岁岁伤离别。", "生小本多愁。", "听风怕到秋。"], "annotations": []}, {"title": "菩萨蛮 簪茉莉美人", "paragraphs": ["画眉才了临妆镜。", "一枝斜飐生娇韵。", "倦压鬓云偏。", "呼鬟整翠钿。", "夜香烧月下。", "细步吹兰麝。", "卸向枕函旁。", "凉宵梦也香。", "露阶蛩语声呜咽。", "玉炉香尽天街寂。", "明月半窥帘。", "思乡人未眠。", "望云空伫立。", "岁岁伤离别。", "生小本多愁。", "听风怕到秋。"], "annotations": []}]}