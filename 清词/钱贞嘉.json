{"dynasty": "清", "author": "钱贞嘉", "author_desc": "", "works": [{"title": "十六字令", "paragraphs": ["鸳被暖，横陈白玉床。", "贪午睡，不识晓来霜。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["朱栏匀粉镜奁斜。", "蛛网丝丝罥碧纱。", "墙外荼蘼日影遮。", "曲篱笆。", "邻女携香换杏花。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["淡烟冲雾掠蜻蜓。", "秋渚潮回沙面平。", "一曲渔歌月满罾，水荭青，风落残红补断萍。"], "annotations": []}, {"title": "天仙子", "paragraphs": ["宝髻蓬松羞翠镜。", "诃梨贴面安黄正。", "残花鹯雨洒东风，风不静。", "花不定。", "杜娟啼老鸳鸯病。"], "annotations": []}, {"title": "菩萨蛮 盼信", "paragraphs": ["窗前风竹敲寒玉。", "回文不寄飞鸿足。", "立尽小花廊。", "归鸦影过墙。", "新诗和恨续。", "徙倚红阑曲。", "尘积旧琵琶。", "羞歌玉树花。"], "annotations": []}]}