{"dynasty": "清", "author": "吴文柔", "author_desc": "", "works": [{"title": "谒金门 寄汉槎兄塞外   见《今词初集》、《瑶华集》、《词综》、《词雅》", "paragraphs": ["情恻恻。", "谁遣雁行南北。", "惨淡云迷关塞黑。", "那知春草色。", "细雨花飞绣陌。", "又是去年寒食。", "啼断子规无气力。", "欲归归未得。"], "annotations": []}, {"title": "长相思", "paragraphs": ["关山秋。", "故山秋。", "叶落宫槐起暮愁。", "新凉作意收。", "蓼花洲。", "荻花洲。", "分付蛩吟且暂休。", "断肠人倚楼。"], "annotations": []}]}