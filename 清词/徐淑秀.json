{"dynasty": "清", "author": "徐淑秀", "author_desc": "", "works": [{"title": "渔歌子 秋夜", "paragraphs": ["露滴花寒入夜深。", "多情明月向愁人。", "灯隐隐，漏沉沉。", "断续钟声断续砧。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["重重幽恨锁眉峰。", "斜倚阑干思未穷。", "徒使心牵问不通。", "忆相逢。", "在梦中。"], "annotations": []}, {"title": "丑奴儿令 有怀", "paragraphs": ["自从别后长相忆，慵整新妆。", "瘦怯春裳。", "怕见庭前芍药芳。", "停针不语愁无限，蜂闹纱窗。", "燕语雕梁。", "独倚阑干欲断肠。"], "annotations": []}, {"title": "鹧鸪天 夜坐", "paragraphs": ["宝篆香消觉夜深。", "挑灯无语倍伤情。", "瑶琴欲抚闲消闷，拨尽朱弦总断魂。", "风索莫，月凄清。", "无端愁思苦萦心。", "徘徊不尽梧桐月，守着窗儿坐到明。"], "annotations": []}]}