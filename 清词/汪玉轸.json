{"dynasty": "清", "author": "汪玉轸", "author_desc": "", "works": [{"title": "长相思  见《灵芬馆诗话》", "paragraphs": ["夜寒生。", "梦魂惊。", "半烬兰膏暗壁灯。", "床头饥鼠行。", "数长更。", "起离情。", "倚枕填词句未成。", "推敲直到明。"], "annotations": []}, {"title": "风光好", "paragraphs": ["掩花关。", "启花关。", "看偏春光春又残。", "动愁端。", "空庭雨过苔痕碧。", "天寥寂。", "短短回廊曲曲栏。", "且盘桓。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["愁中得句浑难续。", "无眠夜半烧灯烛。", "风送露微茫。", "逼人秋气凉。", "熏炉添兽炭。", "香篆微微散。", "何物助吟情。", "一虫阶下鸣。"], "annotations": []}, {"title": "菩萨蛮  见《词综续编》", "paragraphs": ["西风庭院人凄绝。", "梧桐几片残秋叶。", "敲著纸窗棂。", "孤衾和梦听。", "长更和短角。", "催得灯花落。", "触目总销魂。", "低头见泪痕。"], "annotations": []}, {"title": "海棠春", "paragraphs": ["无端一夜东风骤。", "便吹得、杏花消瘦。", "待等小桃红，是晚春时候。", "惜花心事花知否。", "看镜里、双眉长皱。", "花信一番番，只芳年难又。"], "annotations": []}]}