{"dynasty": "清", "author": "唐芑", "author_desc": "", "works": [{"title": "渔家傲 其一 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["石径春生残艳雪。", "山边一曲溪流活。", "瓶漾梅花随意折。", "和风拂。", "蓬门也写王正月。", "炉火拨红茅屋热。", "南窗杂坐透披褐。", "韭茁芹芽爽口物。", "香醪掇。", "村庄儿女团圆节。"], "annotations": []}, {"title": "渔家傲 其二 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["锦样年华看又半。", "药畦兰砌频浇灌。", "一夜涨添春水岸。", "持竿便。", "鱼儿钓得杨枝贯。", "远近花香携榼看。", "踏青有约年年惯。", "沉醉归来斜照晚。", "闲庭院。", "睡浓只觉人情懒。"], "annotations": []}, {"title": "渔家傲 其三 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["最喜桃花春雨足。", "晓来手自分篱菊。", "流水潺瑗鸣涧曲。", "惊飞瀑。", "荷钱叠水纹成縠。", "一院落红飞燕蹴。", "迸泥笋长琅矸竹。", "好鸟看看来布谷。", "声声促。", "樱桃豌豆同时熟。"], "annotations": []}, {"title": "渔家傲 其四 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["浴兰抽丝逢谷雨。", "邻家忙杀蚕桑妇。", "粉箨新篁解满坞。", "绿堪谱。", "焙茶石灶香生户。", "血染杜鹃红欲吐。", "酒筒茗椀抽书赌。", "麦荐尝新初夏序。", "看渔父。", "斜阳小港横施罟。"], "annotations": []}, {"title": "渔家傲 其五 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["榴火昼明葵艳吐。", "绿阴小院逢端午。", "箬叶清芬炊角黍。", "山深处。", "蛙当鼓吹翻成部。", "挥羽半酣筇杖拄。", "轩窗不断黄梅雨。", "樾荫送凉冰簟伍。", "茶烟舞。", "几看鹤梦松间取。"], "annotations": []}, {"title": "渔家傲 其六 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["蝉咽新声天暑酷。", "北窗一枕忘三伏。", "隔院高槐环舍竹。", "花香簇。", "池蓬雨过如新沐。", "借得离骚随意读。", "头科足跣惟吾独。", "愿得床头酒盈斛。", "人间禄。", "蒸梨晚食何须肉？"], "annotations": []}, {"title": "渔家傲 其七 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["炎暑才收流火见。", "井梧一叶惊秋苑。", "天隙鳞文云片片。", "凉侵面。", "仰看鸟雀填银汉。", "紫芋缸菱香乍荐。", "山家风味元称善。", "四野砧声犹未遍。", "鹑衣绽。", "芰荷可制强于绢。"], "annotations": []}, {"title": "渔家傲 其八 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["天外清光流顾兔。", "香舒丛桂飘邻圃。", "秋逼年华期不误。", "前山路。", "翠微深处回徐步。", "薜荔牵风寒乍遇。", "乱蛩石罅吟清露。", "醉月飞觞吾志素。", "美无度。", "儿童恰读秋声赋。"], "annotations": []}, {"title": "渔家傲 其九 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["秋老衣裳寒色透。", "斜风细雨交重九。", "篱菊花开移户牖。", "持杯酒。", "雁声飞遇山窗右。", "秫稻登埸盈数亩。", "离离桔柚香堪剖。", "荡漾湖光峰影瘦。", "轻霜候。", "枫林叶老红颜骤。"], "annotations": []}, {"title": "渔家傲 其十 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["种得寒菘山圃茂。", "官租不欠秋收后。", "上瓮香腾新酿酒。", "君知否。", "霜天红日三竿透。", "矮屋数楹茅草覆。", "小窗暧暧阳和逗。", "墐户绸缪塞向又。", "棉衣授。", "冬来温鲍妻兄够。"], "annotations": []}, {"title": "渔家傲 其十一 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["奕奕奇花飞六出。", "帘前飘洒疏还密。", "榾柮地炉围斗室。", "凝眸白。", "方圆到处成圭璧。", "晚起松斋呵冻笔。", "千山玉琢供吟臆。", "俗虑尘襟烹茗涤。", "添寒色。", "山茶红映经霜橘。"], "annotations": []}, {"title": "渔家傲 其十二 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["曝背茅檐披布衲。", "心闲岁晚无纷杂。", "比屋柴扉常昼阖。", "梅香洽。", "倦眠纸帐容身榻。", "一任山溪冰尽合。", "瑶林琼榭风吹飒。", "芋栗慢煨烧短蜡。", "整肴榼。", "声声爆竹除残腊。"], "annotations": []}, {"title": "浣溪沙", "paragraphs": ["海气来时夕雨成。", "小窗重叠绿蕉声。", "教柔肠与客怀盟。", "剪却灯花催短梦。", "烧残心事怯长更。", "愁添丝鬓不胜情。"], "annotations": []}, {"title": "踏莎行", "paragraphs": ["烟冷寒炉，月窥帘幕，绕枝惊起南飞鹊。", "可堪孤馆闭清宵，雁鸿声度灯花落。", "絮被初温，风飙又作，更长数尽分明柝。", "破愁未破梦难成，鬓丝莫怪霜花薄。"], "annotations": []}, {"title": "踏莎行·送春", "paragraphs": ["蝶翅晴翻，柳绵昼飏，艳春欲去堪惆怅。", "身如萍梗滞青丘，故园花岛知何状。", "无计能留，有情莫谅。", "雕栏芍药看将放。", "漫拈不律送春归，东君应惜人贫况。"], "annotations": []}, {"title": "桂枝香 戊午初度，呈刘少钟原", "paragraphs": ["鬓霜堆白。", "竟浪寄萍踪，他乡旅食。", "玩月才过节后，恰逢今日。", "栖迟却在鄘南地，想金台、去秋此夕。", "主情深重，绮寮酒醴，银灯肴核。", "叹马齿、忽加又一。", "更剪烛西窗，数敦前席。", "椒醑盈樽，醉我衰颜生色。", "人生满百无多见，已年同、陈情李密。", "雨声廉外，蛩声榻畔，枕酣忘客。"], "annotations": []}, {"title": "临江仙 送玉坡马夫子南归", "paragraphs": ["顿足营丘春莫矣，刺苞黄萼方开。", "芙蓉幕底偶迟徊。", "心旌南北路，惜别欲盈腮。", "血泪三更悲杜宇，情深风木生哀。", "穆陵遥望白云堆。", "莺花无与共，山水倩谁陪。"], "annotations": []}, {"title": "临江仙", "paragraphs": ["屈指春归来稷里，系维一榻西楹。", "小窗日暖客凄清。", "晓凰传鹤唳，宵雨咽鼍更。", "转瞬时光逢浴佛，玉鞭又指遄征。", "滹沱波险井径横。", "萍踪随浪远，星剑作龙呜。"], "annotations": []}, {"title": "月中行 闻筝", "paragraphs": ["坐残断续丽谯钟。", "霜月媚帘栊。", "秦筝巧按小墙东。", "曲度六么红。", "想夫银甲谁言冷。", "轻拨似莺舌潜通。", "奈何辄唤雁鸣空。", "好寄与秋风。"], "annotations": []}, {"title": "南柯子", "paragraphs": ["岁近鸟飞疾，宵分蜡泪流。", "纸窗生白月光浮，无奈冷风掀树、闹枝头。", "梦去层城迥，醒来单枕羞。", "山鸡喔喔带更筹，搅乱一生愁绪、在高楼。"], "annotations": []}, {"title": "惜秋华 九日拟登妙光阁，不果，寄马桂海及家季乔伯", "paragraphs": ["嘹呖飞鸿，横晴天、似吐悲秋怀抱。", "懒上层楼，伤心暮烟斜照。", "更落叶满阶，风扫残蓼。", "当轩云扰。", "凭高处、谁称古趣，沉酣落帽。", "秋色京华老。", "想故园蓉菊，正当佳好。", "次第开、水畔放船能到。", "萍踪浪寄金台，叹归与、路迢云渺。", "应道。", "佩茱荚、一人独少。"], "annotations": []}, {"title": "渔家傲 十二月山家词，和钱舍人葆酚、董孝廉苍水", "paragraphs": ["石径春生残艳雪。", "山边一曲溪流活。", "瓶漾梅花随意折。", "和风拂。", "蓬门也写王正月。", "炉火拨红茅屋热。", "南窗杂坐透披褐。", "韭茁芹芽爽口物。", "香醪掇。", "村庄儿女团圆节。", "锦样年华看又半。", "药畦兰砌频浇灌。", "一夜涨添春水岸。", "持竿便。", "鱼儿钓得杨枝贯。", "远近花香携榼看。", "踏