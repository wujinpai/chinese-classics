{"dynasty": "清", "author": "周蕉", "author_desc": "", "works": [{"title": "浣溪沙 春半", "paragraphs": ["燕尾翻风双剪轻。", "柳眠惊觉乱啼莺。", "四旬有五半分春。", "窗外三更寒食雨，梦中一个惜花人。", "此时不怕不消魂。"], "annotations": []}, {"title": "卜算子 春病", "paragraphs": ["心是惜花疼，足是寻春乏。", "花残春老病根由，病也风流煞。", "欲补恨难消，欲泻情还弱。", "春来花放是良医，此外曾无药。"], "annotations": []}, {"title": "虞美人 怀外", "paragraphs": ["别后音书无片纸。", "一只鸳鸯愁欲死。", "莫将行迹比萍踪。", "便是浮萍还有、日相逢。", "枝头豆大青梅小。", "拟似芳心酸意少。", "寻山问水竟忘归。", "辜负山明水秀、眼和眉。"], "annotations": []}]}