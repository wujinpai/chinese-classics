{"dynasty": "清", "author": "缪珠荪", "author_desc": "", "works": [{"title": "十六字令 七夕", "paragraphs": ["凉。", "耿耿星河此夜长。", "悲欢意，天上未能忘。"], "annotations": []}, {"title": "桂殿秋 银桂", "paragraphs": ["风剪快，露华凉。", "蟾宫不禁木樨黄。", "疑他仙子挥清汗，洒向人间点滴香。"], "annotations": []}, {"title": "相见欢", "paragraphs": ["惺忪雾影迷离。", "可怜伊。", "无那春寒消瘦、一分肌。", "螺峰意。", "秋波媚。", "个侬知。", "试向卿卿斜掠、鬓丝丝。"], "annotations": []}, {"title": "浣溪沙", "paragraphs": ["乞得芳华倚石栽。", "春妆宜面小徘徊。", "新增诗思到莓苔。", "絮柳香兰花作骨，镜鸾钗凤玉为台。", "清芬和雨入帘来。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["陌南楼影波摇碧。", "碧摇波影楼南陌。", "罗薄飏风和。", "和风飏薄罗。", "奈何愁翠黛。", "黛翠愁何奈。", "云鬓贴花新。", "新花贴鬓云。"], "annotations": []}, {"title": "卜算子", "paragraphs": ["闲傍玉台吟，拾得零星字。", "集锦硾云句未成，忽被风吹去。", "诗思渺秋烟，欲觅无寻处。", "抹遍银笺不惬心，揉作团团絮。"], "annotations": []}, {"title": "南柯子 题自画", "paragraphs": ["腻粉团香雪，融酥护彩云。", "红情初赋五花纹。", "记取一枝深色、酒微醺。", "娇怯伊惊梦，秾芳我自闻。", "离离花影欲摇春。", "知是谁家亭子、午晴新。"], "annotations": []}, {"title": "醉花阴 中秋", "paragraphs": ["泛绿偎红消永夜。", "佳节团𪢮也。", "罗薄未更衣，雾影云容，花气穿窗罅。", "冰纹窈窕枝低亚。", "万里清光泻。", "扶醉话西风，天上人间，秋色平分乍。"], "annotations": []}, {"title": "南乡子", "paragraphs": ["英落舞红轻。", "惜我吟香酒病身。", "烟𣨼柳眉春好弄，啼莺。", "里院笙调乍昼晴。", "晴昼乍调笙。", "院里莺啼弄好春。", "眉柳𣨼烟身病酒，香吟。", "我惜轻红舞落英。"], "annotations": []}, {"title": "连理枝", "paragraphs": ["才说春来好。", "偏又春归早。", "容易春分，无端春暮，一年春了。", "向落红红处、惜春阴，替花枝写照。", "连理花枝少。", "婪尾花枝小。", "梅蕊春残，夭桃春谢，海棠春老。", "且晴团红粉、护春烟，漫拈花微笑。"], "annotations": []}, {"title": "南柯子 折枝梅纨扇", "paragraphs": ["冷倚团团月，晴烘薄薄霞。", "烟鬟恰称一枝斜。", "簪向东风还认、小桃花。"], "annotations": []}, {"title": "忆秦娥", "paragraphs": ["春睡足，春深悄傍阑干曲。", "阑干曲，云裳楚楚，几分新绿。", "惺忪惯挽秋千索，羡它蝴蝶深枝宿。", "深枝宿，庭阴欲午，可怜腰束。"], "annotations": []}, {"title": "喜迁莺 随官鄂城，忆燕蜀师妹", "paragraphs": ["燕树渺，蜀云低。", "娇小惯相依。", "而今劳燕各东西。", "偏是说双飞。", "天涯路，凌波步。", "相忆何如相晤。", "杜鹃枝上尽情啼。", "红透落花泥。"], "annotations": []}, {"title": "生查子", "paragraphs": ["心清闻妙香，闲把柔毫弄。", "条脱响丁东，褪压云笺緵。", "云笺写叶长，滴露和烟种。", "青上鬓云边，宛似钗头凤。"], "annotations": []}, {"title": "醉花间", "paragraphs": ["花妆靓。", "醉妆靓。", "妆靓还相映。", "侬醉笑花赤，花醉将侬迎。", "花枝凝露净。", "倚醉穿花径。", "无言意自亲，香拍花间令。"], "annotations": []}, {"title": "点绛唇", "paragraphs": ["睡鸭犹温，绣帏人起妆台晓。", "鬓云松绕。", "初日夫容皦。", "红滴樱珠，润抹香痕小。", "菱花照。", "个人嚬笑，影里春知道。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["风。", "成阵飞花舞落红。", "轩轩意，衫袖欲凌空。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["风。", "卖杏花声小院东。", "春寒峭，侵晓听朦胧。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["风。", "解阜胥归一曲中。", "男儿事，羞说大王雄。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["风。", "凤尾香罗薄几重。", "吴江冷，庭院径堆红。"], "annotations": []}, {"title": "十六字令", "paragraphs": ["风。", "林下争传咏絮工。", "寒宵静，檐铁自丁东。"], "annotations": []}, {"title": "忆秦娥 雨窗论画，漫记小词", "paragraphs": ["画画。", "画贵知宗派。", "平章。", "凡事从来上大方。", "花枝明媚交相映。", "红紫都循性。", "飞鸣。", "小小禽虫各有情。"], "annotations": []}, {"title": "桂殿秋 白海棠", "paragraphs": ["留月影，淡香魂。", "冰阶谁与话温存。", "绿翻翡翠霜初信，红褪胭脂雨后痕。"], "annotations": []}, {"title": "长相思", "paragraphs": ["醒难安。", "醉难安。", "乍上轻舟梦亦酸。", "蜀江滩复滩。", "水漫漫。", "路漫漫。", "重叠螺峰和恨攒。", "蜀山峦外峦。"], "annotations": []}, {"title": "菩萨蛮 题自画", "paragraphs": ["葳蕤兰叶青于黛。", "清芬自昔堪为佩。", "幽谷许相寻。", "红心同素心。", "娉婷芳思永。", "花气如人静。", "微雨嫩晴天。", "春风年复年。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["银鳞拨刺穿金柳。", "烹鲜小试调羹手。", "螺黛不胜颦。", "刚逢中酒辰。", "桃花红灼灼。", "江上风波恶。", "眉翠逐颜开。", "归帆带雨来。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["插花挂画人前话。", "尘寰别有清凉界。", "空翠雨馀滋，新红三两枝。", "乍晴凉意足，书幌云摇绿。", "筝语玉纤纤，清风生座筵。"], "annotations": []}, {"title": "诉衷情", "paragraphs": ["呵冻。", "青緵。", "波影送。", "远山春。", "娇叵耐。", "凝黛，月痕新。", "生小解含嗔。", "颦颦。", "无言螺翠匀。", "意梭巡。"], "annotations": []}, {"title": "江南好", "paragraphs": ["颜红借，沉醉可相嘲。", "嗤我低吟输倚马，泥它小饮点离骚。", "商略把愁浇。", "凉新透，花气袭人娇。", "树影不须银烛照，飞觞愿向素娥邀。", "最好是清宵。"], "annotations": []}, {"title": "减字木兰花 家书不尽，附词二阕", "paragraphs": ["重阳将近。", "佳节天涯谁借问。", "同是吟情。", "风雨清宵瘦几分。", "绿窗人悄。", "侬比黄花秋思早。", "厌说加餐。", "减字新声寄木兰。"], "annotations": []}, {"title": "偷声木兰花 家书不尽，附词二阕", "paragraphs": ["临书先恨蛮笺小。", "未及书成愁又绕。", "拆了重封。", "记得笺旁句已重。", "长言不及相思字。", "方胜叠成愁半纸。", "莫道偷声。", "涂乙涂鸦墨未匀。"], "annotations": []}, {"title": "鹧鸪天", "paragraphs": ["戛玉裁云韵自奢。", "窗阴句凤上纹纱。", "琅玕雅爱夫人竹，锦绣新吟命妇花。", "香旖旎，翠交加。", "沉沉帘影日初斜。", "绣馀欲待重商略，羞被旁人一再夸。"], "annotations": []}, {"title": "虞美人", "paragraphs": ["帘疏不碍银钩影。", "往事从头省。", "簪花格好记分明，学得些儿模样、怕人评。", "落霞秋水重游赋。", "阿母亲抄句。", "年年什袭付尘封，一检一回肠断、泣东风。"], "annotations": []}, {"title": "忆秦娥 忆胞妹", "paragraphs": ["妹妹。", "妹小曾亲诲。", "分离。", "一样相思各自悲。", "何年重剪灯花语，年少堪怜汝。", "蹉跎。", "我被兄讥奈汝何。"], "annotations": []}, {"title": "四字令", "paragraphs": ["春芳鬓云。", "罗轻绉裙。", "东风恻恻寒新。", "酲春宵酒人。", "更筹静闻。", "衣裳夜熏。", "朦胧月影黄昏。", "𦶟名香自温。"], "annotations": []}, {"title": "瑞鹧鸪 夏窗戏拍", "paragraphs": ["天时人事两难衡。", "覆雨翻云孰定评。", "醉岂堪醒彭泽意，醒原如醉离骚情。", "黄梅时节家家雨，梅子黄时日日晴。", "至竟是晴还是雨，熟梅天气不分明。"], "annotations": []}]}