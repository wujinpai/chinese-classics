{"dynasty": "清", "author": "陈沅", "author_desc": "", "works": [{"title": "荷叶杯 有所思", "paragraphs": ["自笑愁多欢少。", "痴了。", "底事倩传杯。", "酒一巡时肠九回。", "推不开。", "推不开。"], "annotations": []}, {"title": "丑奴儿令 梅花", "paragraphs": ["满溪绿涨春将去，马踏星沙。", "雨打梨花。", "又有香风透碧纱。", "声声羌笛吹杨柳，月映官衙。", "懒赋梅花。", "帘里人儿学唤茶。"], "annotations": []}]}