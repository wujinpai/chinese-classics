{"dynasty": "清", "author": "濮文绮", "author_desc": "", "works": [{"title": "浣溪沙 题沈鹤子表叔荷花册页，盖其悼亡之粉本也", "paragraphs": ["重雨轻云两奈何。", "红尘难免不风波。", "将他移种到银河。", "秋色已醒池馆梦，淡烟空染碧纹罗。", "春蚕丝少藕丝多。"], "annotations": []}, {"title": "柳梢青 杨花", "paragraphs": ["著雨才停。", "因风又起，恁地销魂。", "飞乱春心，做来春恨，化作春萍。", "粘衣无限殷勤。", "把风月因缘认真。", "梦警痴莺，影迷痴燕，情悟痴人。"], "annotations": []}, {"title": "南柯子 病中", "paragraphs": ["拜月庭空闭，簪花病早添。", "素娥今夜可能眠。", "闻得琼楼人说、不胜寒。", "鬟鬓抛钗凤，尘香腻镜鸾。", "落花流水奈何天。", "闲却一双飞燕，傍钩帘。"], "annotations": []}, {"title": "摘红英", "paragraphs": ["秋声恶。", "秋云薄。", "花阴渐上阑干角。", "依稀见。", "分明怨。", "梦警琼楼，露梢风乱。", "心无著。", "愁难说。", "月明又负婵娟约。", "教谁管。", "凭谁遣。", "夜香尽冷，人天同远。"], "annotations": []}, {"title": "踏莎行 题自画荷花", "paragraphs": ["曲槛风生，水亭香在。", "淡烟疏雨斜阳外。", "洛波仙佩静无声，清凉不受尘埃拜。", "晓镜初开，红妆无奈。", "瑶池碧落前生界。", "丰神写入画图中，免他颜色随秋败。"], "annotations": []}, {"title": "惜黄花慢 月", "paragraphs": ["银汉无烟。", "正碧云露重，秋宇寒添。", "去年楼上，销魂似我，今年帘外，消瘦谁看。", "镜中未改婵娟影，怎辜负、今夜檀栾。", "海天圆。", "方诸清泪，滴损华年。", "多情伴你无眠。", "愿美人花底，名士樽前。", "炉香影热，玉琴韵冷，夜明风静，好景无边。", "清光满照梅花梦，再休问、缺陷因缘。", "甚愁烦。", "人天多少缠绵。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["朝寒未定夜寒生。", "冷雨幽窗滴到明。", "风曳帘钩三两声。", "暗惊人。", "侬不知愁也断魂。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["落红散乱柳飞棉。", "斜倚疏棂眼倦看。", "辜负莺花春一年。", "怨天天。", "空把闲愁托杜鹃。"], "annotations": []}, {"title": "相见欢", "paragraphs": ["匆匆又过清明。", "月黄昏。", "那处绿杨庭院、落花深。", "已别去。", "总无计。", "苦叮咛。", "可是六朝春梦、未醒人。"], "annotations": []}, {"title": "更漏子 寄外", "paragraphs": ["晚风柔，红雨嫩。", "早是病花霜信。", "空惜别，枉相思。", "天涯无见时。", "子规声，蝴蝶影。", "不道秋心尽冷。", "书未就，泪先凝。", "离愁写不成。"], "annotations": []}, {"title": "菩萨蛮 寄外", "paragraphs": ["霜浓月淡重阳后。", "餐英人可如花瘦。", "寒意入窗来。", "闲愁漫自猜。", "江枫红欲滴。", "醉煞浔阳客。", "莫使对琴樽。", "青衫多泪痕。"], "annotations": []}, {"title": "踏莎行 归雁", "paragraphs": ["芦笋新抽，柳芽犹淡。", "天涯人不如归雁。", "含愁相望泪阑干，凤凰纵好何由见。", "疏梦无痕，朵云还散。", "何心更约秋来便。", "年华容易掷东风，未抛锦瑟先断肠。"], "annotations": []}, {"title": "减字木兰花", "paragraphs": ["添香又懒。", "人别小桃妆阁掩。", "何处寻春。", "一半东风一半尘。", "晓莺无语。", "烟重柳棉飞不起。", "莫问伊人。", "细雨梨花小病成。"], "annotations": []}, {"title": "柳梢青", "paragraphs": ["风雨无端。", "吹香尽冷，情绪何堪。", "杨柳阴中，桃花坞里，燕子帘前。", "手拈红豆无言。", "望人在天涯那边。", "千古相思，五更春梦，一世红颜。"], "annotations": []}, {"title": "菩萨蛮 寄外", "paragraphs": ["秋虫替补寒更漏。", "兰闺忆别多时候。", "相见自无因。", "谁怜两处人。", "闲情花外等。", "立瘦黄花影。", "斜月被风筛。", "玉人来不来。"], "annotations": []}, {"title": "柳梢青 秋柳寄外", "paragraphs": ["翠减柔梢。", "惊秋怨别，瘦了郎腰。", "陌上花飞，年年人去，折尽长条。", "相逢南雁迢遥。", "问何处离愁未销。", "无信春风，无聊夜月，无恙红桥。"], "annotations": []}, {"title": "如梦令", "paragraphs": ["昨夜晓窗寒甚。", "紫燕弄巢不定。", "何处觅东风，梦过月塘烟径。", "休问。", "休问。", "耽误梅花春病。"], "annotations": []}, {"title": "菩萨蛮 画牡丹花瓣", "paragraphs": ["软烟薄雾妆才就。", "年华不解伤春瘦。", "相见画栏边。", "风丝兜佩环。", "春宫三十六。", "双燕飞还宿。", "辜负玉漏恩。", "簪花先断魂。"], "annotations": []}, {"title": "醉花阴 同次泉联句，题牡丹花瓣", "paragraphs": ["绿杨深处春莺并。", "说道春将尽。", "词客暗怜春，红雨纷纷，何处题春韵。", "愁春燕子春风恨。", "春梦浑无定。", "春外觅花魂，检点春工，写出伤春影。"], "annotations": []}, {"title": "眼儿媚 暮春", "paragraphs": ["空庭日淡舞杨花。", "风袅篆烟斜。", "幽兰香谢，乳莺啼懒，春梦谁家。", "有情青帝都归去，一度一堪嗟。", "东风庭院，绿阴世界，流水年华。"], "annotations": []}, {"title": "虞美人 种桃花", "paragraphs": ["刘郎去后无音信。", "春色飘零尽。", "莫随流水去人间。", "未到花开先护、小阑干。", "香泥润透连宵雨。", "淡影斜阳里。", "画帘春困绿窗人。", "别有一天幽恨、不分明。"], "annotations": []}, {"title": "长相思 愁", "paragraphs": ["春已深。", "梦已醒。", "才下眉窝又上心。", "愁来真不明。", "针也停。", "笔也停。", "乱似蚕丝织未成。", "满怀多少情。"], "annotations": []}, {"title": "菩萨蛮 咏荷花", "paragraphs": ["南湖一带熏风晚。", "夜凉浴罢红衣软。", "西子几时来。", "姑苏月满台。", "水深人不见。", "只有鸳鸯伴。", "何处著秋尘。", "六郎残醉醒。"], "annotations": []}, {"title": "一剪梅 秋夜", "paragraphs": ["雨后凉蝉隔院鸣。", "花影中庭。", "月影桐阴。", "碧天云断雁无声。", "闲里秋情。", "忙里秋心。", "虫语凄凉杂夜吟。", "几个黄昏。", "几处销魂。", "高楼归梦故乡人。", "无数寒砧。", "无限思寻。"], "annotations": []}, {"title": "浣溪沙", "paragraphs": ["花耐西风月耐霜。", "桂阴庭院晚香廊。", "伴人秋思夜茫茫。", "天气做秋悲宋玉，时光多恨感江郎。", "人间何事是情长。"], "annotations": []}, {"title": "菩萨蛮 送外之作", "paragraphs": ["小桃泪冷东风倦。", "阳关薄酒殷勤荐。", "此去不言归。", "知君思已灰。", "云山千万叠。", "都是伤心色。", "红豆不胜情。", "何堪赠远人。"], "annotations": []}, {"title": "祝英台近 重过余氏园", "paragraphs": ["菊英残，梅雾醒，花落已成泪。", "雪意云情，多少别来味。", "销魂何处帘钩，谁家池馆，可记得、酒边人醉。", "添憔悴。", "空忆梦影如尘，何堪再相对。", "回首天涯，话别正春水。", "殷勤说与东风，递将燕子，休再问、主人归未。"], "annotations": []}]}