{"dynasty": "清", "author": "商景徽", "author_desc": "", "works": [{"title": "月中行 题陈素素像", "paragraphs": ["轻盈燕子掌中身。", "对景舞还停。", "见君佳句更相亲。", "笔底动人情。", "三春杨柳腰间细，二分明月鬓边横。", "芙蓉初放碧池新。", "知是画图人。"], "annotations": []}, {"title": "菩萨蛮", "paragraphs": ["篆烟吹过花深处。", "■■叶底垂甘露。", "何处见如来。", "青莲笔下开。", "朝朝研墨碗。", "不画春山远。", "但写妙莲华，香风遍若耶。"], "annotations": []}]}