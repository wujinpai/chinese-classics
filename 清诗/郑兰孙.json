{"dynasty": "清", "author": "郑兰孙", "author_desc": "", "works": [{"title": "明月生南浦 为孙子竺弟写丛兰便面", "paragraphs": ["情怀冷淡天涯客。", "弄墨调铅，强作消愁策。", "自叹穷途无长物。", "赠君聊写崇兰碧。", "幽艳中含贞静德。", "抱道深藏，不为炎凉易。", "珍重春华宜护惜。", "年年便面常相识。"], "annotations": []}, {"title": "双调南乡子 自题玉窗春晓图小影", "paragraphs": ["罗袖晓寒添。", "才罢晨妆掩镜奁。", "脸晕消红眉减翠，恹恹。", "修到梅花亦可怜。", "花艳尚如前。", "咏月吟风句懒拈。", "斜倚玉窗人倦也，仙仙。", "疏影清香扑画帘。"], "annotations": []}, {"title": "双调南乡子", "paragraphs": ["锦幕怯春寒。", "金鸭烟沈晓月残。", "一色花痕清似雪，漫漫。", "著意相怜起早看。", "拍遍玉阑干。", "似絮愁肠画出难。", "多谢传神双管笔，珊珊。", "顾影何须换骨丹。"], "annotations": []}, {"title": "双调南乡子", "paragraphs": ["庭院雨痕收。", "侵晓珠帘乍上钩。", "红雪装成香世界，悠悠。", "不是凝妆独倚楼。", "回首忆前游。", "铸错何须说九州。", "月地云阶无限感，休休。", "万点春痕洗旧愁。"], "annotations": []}, {"title": "双调南乡子", "paragraphs": ["香雾透红绡。", "压鬟浓芬上翠翘。", "强起扶头心绪懒，朝朝。", "酒病诗魔两不聊。", "记得放兰桡。", "香暖孤山雪未消。", "怊怅故园云路迥，迢迢。", "江北江南客梦遥。"], "annotations": []}, {"title": "双调南乡子 题美人画幅", "paragraphs": ["深院杏花天。", "垂柳丝丝未作绵。", "宜雨宜晴人意倦，窗前。", "觅句聊题玉版笺。", "无语耸吟肩。", "懒画眉痕黯自怜。", "闻说江南风景好，华年。", "罗绮争夸富贵仙。"], "annotations": []}, {"title": "转应词 寄禾中孙葆麓弟", "paragraphs": ["明月。", "明月。", "记照还乡时节。", "扁舟小住鸳湖。", "惆怅天涯隙驹。", "驹隙。", "驹隙。", "回首俊游愁绝。"], "annotations": []}, {"title": "明月生南浦 题钱奎卿诗词集", "paragraphs": ["携来戛玉敲金句。", "不弃荒芜，嘱我从头注。", "价重鸡林云锦护。", "闺中窃恐涂鸦误。", "回环雒诵匪朝暮。", "一爽尘襟，似嚼寒梅素。", "想见吟成夸七步。", "珊瑚笔底花常吐。"], "annotations": []}, {"title": "明月生南浦", "paragraphs": ["评花醉月才人事。", "倚马千言，独树骚坛帜。", "开府参军多逸思。", "清新别具天然致。", "琳琅一卷藏遥笥。", "丽句仙心，密密珍珠字。", "此日胸存湖海志。", "它年风送摩天翅。"], "annotations": []}, {"title": "明月生南浦", "paragraphs": ["新声响遏穿云裂。", "郑重题笺，字字霏香屑。", "凤吹鸾鸣清韵别。", "艳花风舞回琼雪。", "西窗有客堪愁绝。", "回首蟾光，几度圆还缺。", "不尽羁怀增感咽。", "长生何处求仙诀。"], "annotations": []}, {"title": "明月生南浦", "paragraphs": ["百篇斗酒文何绮。", "好句拈来，写遍银光纸。", "午梦未成推枕起。", "卷帘读向西风里。", "骊珠一串差堪拟。", "楚客工愁，写出愁如许。", "阶下秋花凉玉蕊。", "薜萝烟冷怀湘水。"], "annotations": []}, {"title": "明月生南浦", "paragraphs": ["自怜憔悴低飞翮。", "宦海浮沉，往事馀鸿迹。", "西子湖边烟水碧。", "平山堂下繁花易。", "而今又作东皋客。", "百感中来，天地为之窄。", "只合逃禅聊自适。", "药炉经卷虚堂夕。"], "annotations": []}, {"title": "明月生南浦", "paragraphs": ["雨过银屏风暗度。", "云洗天空，又见冰轮吐。", "窗下水沉香细护。", "五铢衣薄凉生素。", "拟欲报琼还又住。", "几度裁笺，自愧难追步。", "减尽吟怀无好句。", "宵深自把兰釭炷。"], "annotations": []}]}