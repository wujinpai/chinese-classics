{"dynasty": "清", "author": "庄盘珠", "author_desc": "", "works": [{"title": "咏晋史", "paragraphs": ["铁销消兵后，羊车纵乐时。", "儿痴原果报，妇毒原果报，妇毒竟流离。", "荆棘铜驼泣，风沙石虎移。", "百年征战里，何地不疮痍。"], "annotations": []}, {"title": "醉桃花 渔家", "paragraphs": ["无拘无束野神仙。", "扁舟不记年。", "得鱼不换酒家钱。", "今宵换醉眠。", "凉雨后，晚风前。", "蒲帆闲未闲。", "蓼花开近夕阳边。", "网拖红影天。"], "annotations": []}, {"title": "醉桃花 田家", "paragraphs": ["村醅肯费赁春钱。", "农夫几日闲。", "许多野雀啄空田。", "斜阳笠影偏。", "逢父老，话丰年。", "桃源别有天。", "人家一簇小桥边。", "鸡豚聚晚烟。"], "annotations": []}, {"title": "𣨼人娇 寒鸦", "paragraphs": ["一带疏杨，飞起三三两两。", "正人倚、小楼凝望。", "荒村野店，记初交霜降。", "风信紧、杂叶萧萧响。", "树黑争呼，烟青并飏。", "离不了、愁人头上。", "悲笳落日，为残秋摩荡。", "谁泼墨、画幅寒垣图样。"], "annotations": []}, {"title": "四换头 寒食", "paragraphs": ["日炙花须卷。", "风筛花影乱。", "燕子闹雕梁。", "春泥一夜香。", "箫声知近远。", "香闺惊梦短。", "明日又清明。", "杨枝插户青。"], "annotations": []}]}