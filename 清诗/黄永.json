{"dynasty": "清", "author": "黄永", "author_desc": "", "works": [{"title": "添字昭君怨 用唐解元“五更风雨葬西施”句，为聘姬姗姗悼亡", "paragraphs": ["花信欲开还住。", "春信欲归难驻。", "五更风雨忽来时。", "葬西施。", "何日花前欢会。", "空想花容憔悴。", "花亡可有哭花人。", "问花神。"], "annotations": []}, {"title": "添字昭君怨 春朝大雾", "paragraphs": ["今日是春来日。", "何故烟霏雾结。", "想防春色到儿家。", "去迷他。", "或者是春来日。", "故使雾迎烟接。", "知春还有几多程。", "问他声。"], "annotations": []}, {"title": "减字朩兰花 画栏", "paragraphs": ["微云如画。", "画栏小影低相亚。", "树气花香。", "半是梧桐半海棠。", "琼宫露冷。", "天上玉妃眠未醒。", "愁绝王孙。", "立尽三更月又浑。"], "annotations": []}, {"title": "减字朩兰花 忆旧", "paragraphs": ["风风雨雨。", "二十四桥侬望处。", "玉佩丁东。", "翡翠屏间醉小红。", "扬州歌吹。", "别院笙箫花底媚。", "人在黄昏。", "金鸭香消半掩门。"], "annotations": []}, {"title": "减字朩兰花 寻花", "paragraphs": ["梦魂萧洒。", "化为蝴蝶寻花也。", "花更无端。", "怪杀花名有合欢。", "急图梦醒。", "墙外风来花弄影。", "唤取双鬟。", "且向花边打蝶还。"], "annotations": []}, {"title": "减字朩兰花 送文友省亲襄阳", "paragraphs": ["轻舟弱水。", "七十二峰将至矣。", "若到襄川。", "一度寒暄孟浩然。", "霜华如片。", "昨夜高堂应梦见。", "此后斑衣。", "应傍山公白接罹。"], "annotations": []}, {"title": "减字朩兰花 盱眙残雪", "paragraphs": ["多才春雪。", "点染山川真妙绝。", "剩粉零丹。", "犹衬长途月色寒。", "陡然日出。", "雪应能剩三之一。", "日上山时。", "日又居然好画师。"], "annotations": []}, {"title": "减字朩兰花 赵真还先生别号半僧，索赠", "paragraphs": ["名于何自。", "云俗云僧俱未是。", "甚事名曾。", "仍旧还他号半僧。", "依然一我。", "唤马呼牛无不可。", "若说先生。", "还算无名是的名。"], "annotations": []}, {"title": "减字朩兰花 生日", "paragraphs": ["当年四十。", "走马长安冲雨雪。", "又五年来。", "寥落柴门酒一杯。", "从今以后。", "樵斧渔罾都制就。", "三两村翁。", "快活青山绿水中。"], "annotations": []}]}