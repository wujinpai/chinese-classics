{"dynasty": "清", "author": "濮文绮", "author_desc": "", "works": [{"title": "双调望江南", "paragraphs": ["风不定，吹乱一帘香。", "花气暖薰罗帕子，月痕凉著素衣裳。", "何事日匆忙。", "云欲散，疏雨又嫌凉。", "谁插绿杨留燕子，自书红粉饯花王。", "春去莫商量。"], "annotations": []}, {"title": "添字昭君怨 秋蝶", "paragraphs": ["香冷画楼空闭。", "都是伤春情绪。", "繁华六代梦才醒。", "怨庄生。", "何处玉钩帘卷。", "方信惜花人远。", "叮咛纨扇意难猜。", "为谁来。"], "annotations": []}]}