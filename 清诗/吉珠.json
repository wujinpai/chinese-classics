{"dynasty": "清", "author": "吉珠", "author_desc": "", "works": [{"title": "金雀鬟 闺情", "paragraphs": ["庭院春深好。", "牡丹开遍了。", "不分是双鬟偷拗。"], "annotations": []}, {"title": "春宵曲 送别", "paragraphs": ["鸭绿春波暖，莺黄柳色新。", "别路醉芳樽。", "送君南浦去、欲消魂。"], "annotations": []}, {"title": "劈瑶钗", "paragraphs": ["懒画眉。", "自颦眉。", "一晌相思一晌悲。", "昨夜梦郎郎似旧，携手醒来，无计挽郎衣。", "晓莺啼。"], "annotations": []}]}