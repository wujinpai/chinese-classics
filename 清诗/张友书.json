{"dynasty": "清", "author": "张友书", "author_desc": "", "works": [{"title": "新秋微雨入夜月光皎然有怀兰仙母女", "paragraphs": ["远树蝉响寂，一雨生微凉。", "美人隔秋水，共此明月光。", "月光空复明，相思苦难已。", "听尽漏声长，悄然立花底。"], "annotations": []}, {"title": "长男秋闱获隽感赋", "paragraphs": ["屡雪刘蕡涕，今朝暂展眉。", "未堪酬汝志，差可慰吾衰。", "兵燹馀生在，风云后日期。", "莫忘忠孝意，努力壮门楣。"], "annotations": []}, {"title": "转应曲 春晓", "paragraphs": ["春晓。", "春晓。", "风雨夜来多少。", "窗前曙色凄迷。", "枕畔时闻鸟啼。", "啼鸟。", "啼鸟。", "偏是把人梦搅。"], "annotations": []}, {"title": "转应曲 暮春", "paragraphs": ["飞雪。", "飞雪。", "柳絮漫天时节。", "青青芳草池塘。", "斜日闲阶昼长。", "长昼。", "长昼。", "深院下帘人瘦。"], "annotations": []}, {"title": "琴调相思引 寄怀宜寰宓三女弟", "paragraphs": ["焚尾开残又送春。", "将雏燕子绕重门。", "愁怀谁遣，相伴只琴尊。", "离思漫漫无晓夜。", "落花飞絮总销魂。", "不胜怊怅，新月送黄昏。"], "annotations": []}]}