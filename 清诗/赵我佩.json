{"dynasty": "清", "author": "赵我佩", "author_desc": "", "works": [{"title": "添声杨柳枝", "paragraphs": ["半卷香帘烛影摇。", "夜迢迢。", "此时情绪已魂销。", "掩轻绡。", "人瘦花残秋去了。", "愁多少。", "芭蕉窗外更无聊。", "雨潇潇。"], "annotations": []}, {"title": "鬓云松令 新病初痊，鬓发半脱，晨状梳掠，忽忽自怜", "paragraphs": ["病生愁，愁种病。", "病起愁添，强对芙蓉镜。", "委地香云慵不整。", "如剪春风，看卷晶帘影。", "钿蝉寒，钗燕冷。", "憔悴腰肢，羞与垂杨并。", "一缕柔丝千万恨。", "绿腻琼梳，指上馀香凝。"], "annotations": []}, {"title": "清门引 飞絮", "paragraphs": ["漂泊浑无定。", "可是东风薄幸。", "游丝无力绾应难，任它飞去，拼作天涯影。", "谢娘何事诗怀冷。", "憔悴江南景。", "金缕曲歌何处，阳关一阕人愁听。"], "annotations": []}, {"title": "添字采桑子", "paragraphs": ["绣衾不暖炉烟冻，剔却银釭。", "卸罢残妆。", "蓦见隔帘斜月影、上回廊。", "坠欢重省浑如梦，没个思量。", "枉费猜详。", "细数别来多少事、断人肠。"], "annotations": []}, {"title": "相思令儿", "paragraphs": ["犹记深宵剪烛，细语比肩时。", "一自个人去后，只赢得相思。", "妆台彩笔慵持。", "怕离愁、压损双眉。", "争知别后心情，去时悔不留伊。"], "annotations": []}, {"title": "琴调相思引", "paragraphs": ["滴尽莲花夜漏残。", "相思拍遍小阑干。", "吹箫人去，碧月又团𪢮。", "莫向华胥寻睡蝶，梦魂飞不倒长安。", "枕函倦倚，曲曲是关山。"], "annotations": []}, {"title": "减兰 春分夜偶成", "paragraphs": ["更长梦短。", "春色平分刚一半。", "水样轻寒。", "翠袖宵来怯倚栏。", "乱愁如絮。", "无奈东风吹不去。", "碎雨零烟。", "深院梨花瘦可怜。"], "annotations": []}, {"title": "减兰 寄君莲", "paragraphs": ["钿车人远。", "飞絮游丝无力绾。", "忆别临歧。", "执手相看泪满衣。", "韶华易老。", "姊妹花开春去了。", "珍重馀寒。", "料峭风前莫倚栏。"], "annotations": []}, {"title": "减兰 其一 题《梦云楼词》", "paragraphs": ["花生梦笔。", "麝墨纵横新玉册。", "名士才华。", "百幅琳琅写韵纱。", "西泠感旧。", "第一魂销桥畔柳。", "谱入乌丝。", "春水当年绝妙词。"], "annotations": []}, {"title": "减兰 其二 题《梦云楼词》", "paragraphs": ["酒边弹剑。", "青粉旗亭红粉店。", "檀板新腔，十五盈盈唱谢娘。", "梦云千叠。", "纸帐罗浮飞倦蝶。", "玉照词人，淡到梅花韵绝尘。"], "annotations": []}, {"title": "减兰 题《梦云楼词》", "paragraphs": ["花生梦笔。", "麝墨纵横新玉册。", "名士才华。", "百幅琳琅写韵纱。", "西泠感旧。", "第一魂销桥畔柳。", "谱入乌丝。", "春水当年绝妙词。", "酒边弹剑。", "青粉旗亭红粉店。", "檀板新腔，十五盈盈唱谢娘。", "梦云千叠。", "纸帐罗浮飞倦蝶。", "玉照词人，淡到梅花韵绝尘。"], "annotations": []}]}