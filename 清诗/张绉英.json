{"dynasty": "清", "author": "张绉英", "author_desc": "", "works": [{"title": "转应曲", "paragraphs": ["飞絮。", "飞絮。", "只解催将春去。", "池塘芳草芊芊。", "燕子归来卷帘。", "帘卷。", "帘卷。", "花影斜倚一半。"], "annotations": []}, {"title": "转应曲", "paragraphs": ["春半。", "春半。", "窗外落花不断。", "空阶独立微吟。", "云掩重门院深。", "深院。", "深院。", "绣阁画帘高卷。"], "annotations": []}, {"title": "隔溪梅", "paragraphs": ["春风飞絮满天涯。", "望残霞。", "堪恨满园春景、暮云遮。", "闲行踏落花。", "不知蝶去向谁家。", "听啼鸦。", "寂寞阶前人影、倚窗纱。", "徘徊月又斜。"], "annotations": []}]}