{"dynasty": "先秦", "author": "佚名", "author_desc": "", "works": [{"title": "五子歌", "paragraphs": ["皇祖有训。民可近。", "不可下。民惟邦本。", "本固邦宁。予视天下愚夫愚妇。", "一能胜予。怨岂在明。", "不见是图。予临兆民。", "懔乎若朽索之驭六马。为人上者。", "奈何不敬。训有之。", "内作色荒。外作禽荒。", "甘酒嗜音。峻宇雕墙。", "有一于此。未或不亡。", "惟彼陶唐。有此冀方。", "今失厥道。乱其纪纲。", "乃底灭亡。明明我祖。", "万邦之君。有典有则。", "贻厥子孙。关石和钧。", "王府则有。荒坠厥绪。", "覆宗绝祀。呜呼曷归。", "予怀之悲。万姓仇予。", "予将畴依。郁陶乎予心。", "颜厚有忸怩。弗慎厥德。", "虽悔可追。"]}, {"title": "白水诗", "paragraphs": ["浩浩白水。", "倏倏之鱼。", "君来召我。", "我将安居。", "国家未立。", "从我焉如。"], "annotations": []}, {"title": "白水诗", "paragraphs": ["浩浩者水。", "育育者鱼。", "未有室家。", "而召我安居。"], "annotations": []}, {"title": "《后汉书》引逸诗", "paragraphs": ["皎皎练丝。", "在所染之。"], "annotations": []}, {"title": "佹诗", "paragraphs": ["天地易位。", "四时易乡。", "列星陨坠。", "旦暮晦盲。", "幽暗登昭。", "日月下藏。", "公正无私。", "反见纵横。", "志爱公利。", "重楼疏堂。", "无私罪人。", "憼革二兵。", "道德纯备。", "谗口将将。", "仁人绌约。", "敖暴擅强。", "天下幽险。", "恐失世英。", "龟龙为蝘蜓。", "鸱枭为凤凰。", "比干见刳。", "孔子拘匡。", "昭昭乎其知之明也。", "郁郁乎其遇时之不祥也。", "拂乎其欲礼义之大行也。", "暗乎天下之晦盲也。", "皓天不复。", "忧无疆也。", "千秋必反。", "古之常也。", "弟子勉学。", "天不忘也。", "圣人共手。", "时几将矣。", "念彼远方。", "何其塞矣。", "仁人绌约。", "暴人衍矣。", "忠臣危殆。", "谗人般矣。", "璇玉瑶珠。", "不知佩也。", "杂布与锦。", "不知异也。", "闾娵子奢。", "莫之媒也。", "嫫母力父。", "是之喜也。", "以盲为明。", "以聋为聪。", "以危为安。", "以吉为凶。", "呜呼上天。", "曷维其同。"], "annotations": []}, {"title": "峤诗", "paragraphs": ["何自南极。", "至于北极。", "绝境越国。", "弗愁道远。"], "annotations": []}, {"title": "《家语》引逸诗", "paragraphs": ["皇皇上天。", "其命不忒。", "天之以善。", "必报其德。"], "annotations": []}, {"title": "大唐歌", "paragraphs": ["舟张辟雍，鸧鸧相从。", "八风回回，凤皇喈喈。"], "annotations": []}, {"title": "子桑琴歌", "paragraphs": ["父邪母邪。", "天乎人乎。"], "annotations": []}, {"title": "丰歌", "paragraphs": ["凤皇下丰。"], "annotations": []}, {"title": "《孔丛子》引遗谚", "paragraphs": ["尧舜千钟。", "孔子百觚。", "子路嗑嗑。", "尚饮十榼。"], "annotations": []}, {"title": "长水童谣", "paragraphs": ["城门当有血。", "城没陷为湖。"], "annotations": []}, {"title": "丘陵歌", "paragraphs": ["登彼丘陵。", "峛崺其阪。", "仁道在迩。", "求之若远。", "遂迷不复。", "自婴屯蹇。", "喟然回虑。", "题彼泰山。", "郁确其高。", "梁甫回连。", "枳棘充路。", "陟之无缘。", "将伐无柯。", "患兹蔓延。", "惟以永叹。", "涕𫕥潺湲。"], "annotations": []}, {"title": "包山谣", "paragraphs": ["禹得金简玉字书。", "藏洞庭包山湖。"], "annotations": []}, {"title": "去鲁歌", "paragraphs": ["彼妇之口。", "可以出走。", "彼妇之谒。", "可以死败。", "盖优哉游哉。", "维以卒岁。"], "annotations": []}, {"title": "鬼谷子引古语", "paragraphs": ["女爱不蔽席。", "男欢不尽轮。"], "annotations": []}, {"title": "甘泉歌", "paragraphs": ["运石甘泉口。", "渭水不敢流。", "千人唱。", "万人讴。", "金陵馀石大如𫭟。"], "annotations": []}, {"title": "申包胥歌", "paragraphs": ["吴为无道。", "封豕长蛇。", "以食上国。", "欲有天下。", "政从楚起。", "寡君出自草泽。", "使来告急。"], "annotations": []}, {"title": "申叔仪乞粮歌", "paragraphs": ["佩玉蕊兮余无所系之。", "旨酒一盛兮余与褐之父睨之。"], "annotations": []}, {"title": "乌鹊歌", "paragraphs": ["仰飞鸟兮乌鸢。", "凌玄虚兮号翩翩。", "集洲渚兮优恣。", "啄虾矫翮兮云间。", "任厥性兮往还。", "妾无罪兮负地。", "有何辜兮谴天。", "帆帆独兮西往。", "孰知返兮何年。", "心惙惙兮若割。", "泪泫泫兮双悬。", "彼飞鸟兮鸢乌。", "已回翔兮翕苏。", "心在专兮素虾。", "何居食兮江湖。", "徊复翔兮游飏。", "去复返兮于乎。", "始事君兮去家。", "终我命兮君都。", "终来遇兮何辜。", "离我国兮去吴。", "妻衣褐兮为婢。", "夫去冕兮为奴。", "岁遥遥兮难极。", "冤悲痛兮心恻。", "肠千结兮服膺。", "于乎哀兮忘食。", "愿我身兮如鸟。", "身翱翔兮矫翼。", "去我国兮心摇。", "情愤惋兮谁识。"], "annotations": []}, {"title": "龙蛇歌", "paragraphs": ["龙欲上天。", "五蛇为辅。", "龙已升云。", "四蛇各入其宇。", "一蛇独怨。", "终不见处所。"], "annotations": []}, {"title": "龙蛇歌", "paragraphs": ["有龙于飞。", "周遍天下。", "五蛇从之。", "为之承辅。", "龙返其乡。", "得其处所。", "四蛇从之。", "得其雨露。", "一蛇羞之。", "槁死于中野。"], "annotations": []}, {"title": "龙蛇歌", "paragraphs": ["有龙矫矫。", "顷失其所。", "五蛇从之。", "周遍天下。", "龙饥无食。", "一蛇割股。", "龙返其渊。", "安其壤土。", "四蛇入穴。", "皆有处所。", "一蛇无穴。", "号于中野。"], "annotations": []}, {"title": "优孟歌", "paragraphs": ["山居耕田苦。", "难以得食。", "起而为吏。", "身贪鄙者馀财。", "不顾耻辱。", "身心家室富。", "又恐受赇枉法为奸触大罪。", "身死而家灭。", "贪吏安可为也。", "念为廉吏。", "奉法守职。", "竟死不敢为非。", "廉吏安可为也。"], "annotations": []}, {"title": "岁莫歌", "paragraphs": ["岁已莫矣。", "而禾不获。", "忽忽兮若之何。", "岁已寒矣。", "而役不罢。", "惙惙兮如之何。"], "annotations": []}, {"title": "成人歌", "paragraphs": ["蚕则绩而蟹有匡。", "范则冠而蝉有绥。", "兄则死而子皋为之衰。"], "annotations": []}, {"title": "成王冠辞", "paragraphs": ["令月吉日。", "王始加元服。", "去王幼志服衮职。", "钦若昊天。", "六合是式。", "率尔祖考。", "永永无极。"], "annotations": []}, {"title": "成相杂辞", "paragraphs": ["请成相。", "世之殃。", "愚暗愚暗堕贤良。", "人主无贤。", "如瞽无相何伥伥。", "请布基。", "慎圣人。", "愚而自专事不治。", "主忌苟胜。", "群臣莫谏必逢灾。", "论臣过。", "反其施。", "尊主安国尚贤义。", "拒谏饰非。", "愚而上同国必祸。", "曷谓罢。", "国多私。", "比周还主党与施。", "远贤近谗。", "忠臣蔽塞主势移。", "曷谓贤。", "明君臣。", "上能尊主爱下民。", "主诚听之。", "天下为一四海宾。", "主之孽。", "谗人达。", "贤能遁逃国乃蹶。", "愚以重愚。", "暗以重暗成为桀。", "世之灾。", "妒贤能。", "飞廉知政任恶来。", "卑其志意。", "大其园囿高其台。", "武王怒。", "师牧野。", "纣卒易乡启乃下。", "武王善之。", "封之于宋立其祖。", "世之衰。", "谗人归。", "比干见刳箕子累。", "武王诛之。", "吕尚招麾殷民怀。", "世之祸。", "恶贤士。", "子胥见杀百里徙。", "穆公得之。", "强配五伯六卿施。", "世之愚。", "恶大儒。", "逆斥不通孔子拘。", "展禽三绌。", "春申道缀基毕输。", "请牧基。", "贤者思。", "尧在万世如见之。", "谗人罔极。", "险陂倾侧此之疑。", "基必施。", "辩贤罢。", "文武之道同伏戏。", "由之者治。", "不由者乱何疑为。", "凡成相。", "辩法方。", "至治之极复后王。", "慎墨季惠。", "百家之说诚不祥。", "治复一。", "修之吉。", "君子执之心如结。", "众人贰之。", "谗夫弃之形是诘。", "水至平。", "端不倾。", "心术如此象圣人。", "□而有势。", "直而用曳必参天。", "世无王。", "穷贤良。", "暴人刍豢仁人糟糠。", "礼乐灭息。", "圣人隐伏墨术行。", "治之经。", "礼与刑。", "君子以修百姓宁。", "明德慎罚。", "国家既治四海平。", "治之志。", "后势富。", "君子诚之好以待。", "处之敦固。", "有深藏之能远思。", "思乃精。", "志之荣。", "好而一之神以诚。", "精神相反。", "一而不贰为圣人。", "治之道。", "美不老。", "君子由佼以好。", "下以教诲子弟。", "上以事祖考。", "成相竭。", "辞不蹶。", "君子道之顺以达。", "宗其贤良辩其殃孽□□□。", "请成相。", "道圣王。", "尧舜尚贤身辞让。", "许由善卷。", "重义轻利行显明。", "尧让贤。", "以为民。", "汜利兼爱德施均。", "辩治上下。", "贵贱有等明君臣。", "尧授能。", "舜遇时。", "尚贤推德天下治。", "虽有贤圣。", "适不遇世孰知之。", "尧不德。", "舜不辞。", "妻以二女任以事。", "大人哉舜。", "南面而立万物备。", "舜授禹以天下。", "尚德推贤不失序。", "外不避仇。", "内不阿亲贤者予。", "禹劳心力。", "尧有德。", "干戈不用三苗服。", "举舜圳亩。", "任之天下身休息。", "得后稷。", "五谷殖。", "夔为乐正鸟兽服。", "契为司徒。", "民知孝弟尊有德。", "禹有功。", "抑下鸿。", "辟除民害逐共工。", "北决九河。", "通十二渚疏三江。", "禹傅土。", "平天下。", "躬亲为民行劳苦。", "得益皋陶。", "横革直成为辅。", "契玄王。", "生昭明。", "居于砥石迁于商。", "十有四世乃有天乙是成汤。", "天乙汤。", "论举当。", "身让卞随举牟光。", "□□□□道古贤圣基必张。", "□□□。", "愿陈辞。", "世乱恶善不此治。", "隐讳疾贤。", "良由奸诈鲜无灾。", "患难哉阪为先圣知不用愚者谋。", "前车已覆。", "后未知更何觉时。", "不觉悟。", "不知苦。", "迷惑失指易上下。", "忠不上达。", "蒙掩耳目塞门户。", "门户塞。", "大迷惑。", "悖乱昏莫不终极。", "是非反易。", "比周期上恶正直。", "正直恶。", "心无度。", "邪枉辟回失道途。", "已无邮人我独自美岂无故。", "不知戒。", "后必有恨后遂过不肯悔。", "谗夫多进。", "反复言语生诈态。", "人之态。", "不如备。", "争宠疾贤利恶忌。", "妒功毁贤。", "下敛党与上蔽匿。", "上壅蔽。", "失辅势。", "任用谗夫不能制。", "郭公长父之难。", "厉王流于彘。", "周幽厉。", "所以败。", "不听规谏忠是害。", "嗟我何人。", "独不遇时当乱世。", "欲对衷。", "言不从。", "恐为子胥身离凶。", "进谏不听。", "刭而独鹿弃之江。", "观往事。", "以自戒。", "治乱是非亦可识。", "□□□□托于成相以喻意。", "请成相。", "言治方。", "君论有五约以明。", "君谨守之。", "下皆平正国乃昌。", "臣下职。", "莫游食。", "务本节用财无极。", "事业听上。", "莫得相使一民力。", "守其职。", "足衣食。", "厚薄有等明爵服。", "利往卬上。", "莫得擅与孰私得。", "君法明。", "论有常。", "表仪既设民知方。", "进退有律。", "莫得贵贱孰私王。", "君法仪。", "禁不为。", "莫不说教名不移。", "修之者荣。", "离之者辱孰它师。", "刑称陈。", "守其银。", "下不得用轻私门。", "罪祸有律。", "莫得轻重威不分。", "请牧祺。", "用有基。", "主好论议必善谋。", "五听循领。", "莫不理续主执持。", "听之经。", "明其请。", "参伍明谨施赏刑。", "显者必得隐者复显民反诚。", "言有节。", "稽其实。", "信诞以分赏罚必。", "下不欺上。", "皆以情言明若日。", "上通利。", "隐远至。", "观法不法见不视。", "耳目既显。", "吏敬法令莫敢恣。", "君教出。", "行有律。", "吏谨将之无铍滑。", "下不私请。", "各以所宜舍巧拙。", "臣谨修。", "君制变。", "公察善思论不乱。", "以治天下。", "后世法之成律贯。"], "annotations": []}, {"title": "曳杖歌", "paragraphs": ["泰山其颓乎。", "梁木其坏乎。", "哲人其萎乎。"], "annotations": []}, {"title": "讽赋歌", "paragraphs": ["岁将暮兮日已寒。", "中心乱兮勿多言。", "内怵惕兮徂玉床。", "横自陈兮君之傍。"], "annotations": []}, {"title": "齐人歌", "paragraphs": ["鲁人之皋。", "数年不觉。", "使我高蹈。", "唯其儒书。", "以为二国忧。"], "annotations": []}, {"title": "齐民歌", "paragraphs": ["公胡不复遗其冠乎。"], "annotations": []}, {"title": "齐庄公歌", "paragraphs": ["已哉已哉，寡人不能说也，尔来为。"], "annotations": []}, {"title": "冻水歌", "paragraphs": ["冻水洗我若之何。", "太上糜散我若之何。"], "annotations": []}, {"title": "宋城者讴", "paragraphs": ["睅其目，皤其腹。", "弃甲而复。", "于思于思，弃甲复来。", "从其有皮。", "丹漆若何。"], "annotations": []}, {"title": "杨朱歌", "paragraphs": ["天其弗识。", "人胡能觉。", "匪佑自天。", "弗孽由人。", "我乎汝乎。", "其弗知乎。", "医乎巫乎。", "其知之乎。"], "annotations": []}, {"title": "穷劫曲", "paragraphs": ["王耶王耶何乖劣。", "不顾宗庙听谗孽。", "任用无忌多所杀。", "诛夷白氏族几灭。", "二子东奔适吴越。", "吴王哀痛助忉怛。", "垂涕举兵将西伐。", "伍胥白喜孙武决。", "三战破郢王奔发。", "留兵纵骑虏京阙。", "楚荆骸骨遭掘发。", "鞭辱腐尸耻难雪。", "几危宗庙社稷灭。", "庄王何罪国几绝。", "卿士凄怆民恻悷。", "吴军虽去怖不歇。", "愿王更隐抚忠节。", "勿为谗口能谤亵。"], "annotations": []}, {"title": "邺民歌", "paragraphs": ["邺有贤令兮为史公。", "决漳水兮灌邺旁。", "终古舄卤兮生稻粱。"], "annotations": []}, {"title": "麦秀歌", "paragraphs": ["麦秀渐渐兮禾黍油油。", "彼狡童兮不与我好兮。"], "annotations": []}, {"title": "《国语》引人言", "paragraphs": ["兄弟谗阋。", "侮人百里。", "兵在其颈。", "佐雍者尝焉。", "佐斗者伤焉。", "祸不好不能为祸。"], "annotations": []}, {"title": "《国语》引谚", "paragraphs": ["兽恶其网。", "民恶其上。", "众心成城。", "众口铄金。", "从善如登。", "从恶如崩。", "黍稷无成。", "不能为荣。", "黍不为黍。", "不能蕃朊。", "稷不为稷。", "不能繁殖。", "所生不疑。", "惟德之基。", "狐埋之而狐搰之。", "是以无成功。", "觥饭不及壶餮。"], "annotations": []}, {"title": "松柏歌", "paragraphs": ["松邪柏邪。", "住建共者客邪。"], "annotations": []}, {"title": "河上歌", "paragraphs": ["同病相怜。", "同忧相救。", "惊翔之鸟。", "相随而集。", "濑下之水。", "因复俱流。"], "annotations": []}, {"title": "河梁歌", "paragraphs": ["渡河梁兮渡河梁。", "举兵所伐攻秦王。", "孟冬十月多雪霜。", "隆寒道路诚难当。", "阵兵未济秦师降。", "诸侯怖惧皆恐惶。", "声传海内威远邦。", "称霸穆桓齐楚庄。", "天下安宁寿考长。", "悲去归兮河无梁。"], "annotations": []}, {"title": "河激歌", "paragraphs": ["升彼河兮而观清。", "水扬波兮冒冥冥。", "祷求福兮醉不醒。", "诛将加兮妾心惊。", "罚既释兮渎乃清。", "妾持楫兮操其维。", "蛟龙助兮主将归。", "呼来棹兮行勿疑。"], "annotations": []}, {"title": "泽门之皙讴", "paragraphs": ["泽门之皙。", "实兴我役。", "邑中之黔。", "实尉我心。"], "annotations": []}, {"title": "狐援辞", "paragraphs": ["先出也衣𫄨纻。", "后出也满囹圄。", "吾今见民之洋洋然。", "东走而不知所处。", "有人自南方来。", "鲋入而?居。", "使人之朝为草国为墟。", "殷有比干。", "吴有子胥。", "齐有狐援。", "已不用若言。", "又斮之东闾。", "每斮以吾参夫二子者乎。"], "annotations": []}, {"title": "狐裘歌", "paragraphs": ["狐裘尨茸。", "一国三公。", "吾谁适从。"], "annotations": []}, {"title": "采芑歌", "paragraphs": ["妪乎采芑。", "归乎田成子。"], "annotations": []}, {"title": "采葛妇歌", "paragraphs": ["葛不连蔓棻台台。", "我君心苦命更之。", "尝胆不苦甘如饴。", "令我采葛以作丝。", "女工织兮不敢迟。", "弱于罗兮轻霏霏。", "号𫄨素兮将献之。", "越王悦兮忘罪除。", "吴王欢兮飞尺书。", "增封益地赐羽奇。", "机杖茵蓐诸侯仪。", "群臣拜舞天颜舒。", "我王何忧能不移。", "饥不遑食四体疲。"], "annotations": []}, {"title": "金楼子引古语", "paragraphs": ["宁得一把五加。", "不用金玉满车。", "宁得一斤地榆。", "不用明月宝珠。"], "annotations": []}, {"title": "金楼子引殷纣时语", "paragraphs": ["车行酒。", "骑行炙。", "百二十日为一夜。"], "annotations": []}, {"title": "南风歌", "paragraphs": ["南风之薰兮，可以解吾民之愠兮，南风之时兮。", "可以阜吾民之财兮。"], "annotations": []}, {"title": "南蒯歌", "paragraphs": ["我有圃。", "生之杞乎。", "从我者子乎。", "去我者鄙乎。", "倍其邻者耻乎。", "已乎已乎。", "非吾党之士乎。"], "annotations": []}, {"title": "段干木歌", "paragraphs": ["吾君好正。", "段干木之敬。", "吾君好忠。", "段干木之隆。"], "annotations": []}, {"title": "浑良夫噪", "paragraphs": ["登此昆吾之虚。", "绵绵生之瓜。", "余为浑良夫。", "叫天无辜。"], "annotations": []}, {"title": "相和歌", "paragraphs": ["嗟来桑户乎。", "嗟来桑户乎。", "而已反其真。", "而我犹为人猗。"], "annotations": []}, {"title": "祠田辞", "paragraphs": ["荷此长耜。", "耕彼南亩。", "四海俱有。"], "annotations": []}, {"title": "原壤歌", "paragraphs": ["狸首之斑然。", "执女手之卷然。"], "annotations": []}, {"title": "夏人歌", "paragraphs": ["江水沛兮。", "舟楫败兮。", "我王废兮。", "趣归于薄。", "薄亦大兮。", "乐兮乐兮。", "四牡𫏋兮。", "六辔沃兮。", "去不善而从善。", "何不乐兮。"], "annotations": []}, {"title": "徐人歌", "paragraphs": ["延陵季子兮不忘故。", "脱千金之剑带丘墓。"], "annotations": []}, {"title": "恭世子诵", "paragraphs": ["贞之无报也。", "孰是人斯。", "而有斯臭也。", "贞为不听。", "信为不诚。", "国斯无刑。", "媮居幸生。", "不更厥贞。", "大命其倾。", "威兮怀兮。", "各聚尔有。", "以待所归兮。", "猗兮违兮。", "心之哀兮。", "岁之二七。", "其靡有征兮。", "若翟公子。", "吾是之依兮。", "镇抚国家。", "为王妃兮。"], "annotations": []}, {"title": "晋童谣", "paragraphs": ["丙之晨。", "龙尾伏辰。", "均服振振。", "取虢之旗。", "鹑之贲贲。", "天策焞焞。", "火中成军。", "虢公其奔。"], "annotations": []}, {"title": "涂山女歌", "paragraphs": ["候人猗兮。"], "annotations": []}, {"title": "涂山歌", "paragraphs": ["绥绥白狐。", "九尾庞庞。", "成于家室。", "我都攸昌。"], "annotations": []}, {"title": "离别相去辞", "paragraphs": ["跞躁摧长恧兮擢戟驭殳。", "所离不降兮以泄我王气苏。", "三军一飞降兮所向皆殂。", "一士判死兮而当百夫。", "道祐有德兮吴卒自屠。", "雪我王宿耻兮威振八都。", "军伍难更兮势如貔䝙。", "行行各努力兮于乎于乎。"], "annotations": []}, {"title": "莱人歌", "paragraphs": ["景公死乎不与埋。", "三军之士不与谋。", "师乎师乎。", "何党之乎。"], "annotations": []}, {"title": "获麟歌", "paragraphs": ["唐虞世兮麟凤游。", "今非其时来何求。", "麟兮麟兮我心忧。"], "annotations": []}, {"title": "被衣为啮缺歌", "paragraphs": ["形若槁骸。", "心若死灰。", "真其实知。", "不以故自持。", "媒媒晦晦。", "无心而不可与谋。", "彼何人哉。"], "annotations": []}, {"title": "弹铗歌", "paragraphs": ["长铗归来乎食无鱼。", "长铗归来乎出无车。", "长铗归来乎无以为家。"], "annotations": []}, {"title": "弹歌", "paragraphs": ["断竹续竹。", "飞土逐肉。"], "annotations": []}, {"title": "梦歌", "paragraphs": ["济洹之水。", "赠我以琼瑰。", "归乎归乎。", "琼瑰盈吾怀乎。"], "annotations": []}, {"title": "渔父歌", "paragraphs": ["日月昭昭乎寝已驰。", "与子期乎芦之漪。", "日已夕兮予心忧悲。", "月已驰兮何不渡为。", "事浸急兮将奈何。", "芦中人。", "芦中人。", "岂非穷士乎。"], "annotations": []}, {"title": "祭侯辞", "paragraphs": ["嗟尔不宁侯。", "为尔不朝于王所。", "故亢而射女。", "强食尔食。", "曾孙侯氏百福。"], "annotations": []}, {"title": "祭侯辞", "paragraphs": ["惟若宁侯。", "毋或若女不宁侯。", "不属于王所。", "故抗而射女。", "强饮强食。", "诒尔曾孙。", "诸侯百福。"], "annotations": []}, {"title": "祭辞", "paragraphs": ["皇皇上天。", "照临下土。", "集地之灵。", "降甘风雨。", "庶物群生。", "各得其所。", "靡今靡古。", "维予一人某敬拜皇天之祜。", "薄薄之土。", "承天之神。", "兴甘风雨。", "庶卉百物。", "莫不茂者。", "既安且宁。", "维予一人某敬拜下土之灵。", "维某年某月上日。", "明光于上下。", "勤施于四方。", "旁作穆穆。", "惟予一人某敬拜迎于郊。", "以正月朔日迎日于东郊。"], "annotations": []}, {"title": "祷雨辞", "paragraphs": ["政不节与。", "使民疾与。", "何以不雨。", "至斯极也。", "宫室崇与。", "妇谒盛与。", "何以不雨。", "至斯极也。", "苞苴行与。", "谗夫兴兴。", "何以不雨。", "至斯极也。"], "annotations": []}, {"title": "野人歌", "paragraphs": ["既定尔娄猪。", "盍归吾艾豭。"], "annotations": []}, {"title": "黄泽谣", "paragraphs": ["黄之池。", "其马喷沙。", "皇人威仪。", "黄之泽。", "其马喷玉。", "皇人受谷。"], "annotations": []}, {"title": "黄鹄歌", "paragraphs": ["悲夫黄鹄之早寡兮。", "七年不双。", "宛颈独宿兮不与众同。", "夜半悲鸣兮想其故雄。", "天命早寡兮独宿何伤。", "寡妇念此兮泣下数行。", "呜呼哀哉兮死者不可忘。", "飞鸟尚然兮况于贞良。", "虽有贤雄兮终不重行。"], "annotations": []}, {"title": "琴女歌", "paragraphs": ["罗縠单衣。", "可裂而绝。", "三尺屏风。", "可超而越。", "鹿卢之剑。", "可负而拔。"], "annotations": []}, {"title": "琴歌", "paragraphs": ["百里奚。", "初娶我时五羊皮。", "临当相别时烹乳鸡。", "今适富贵忘我为。"], "annotations": []}, {"title": "琴歌", "paragraphs": ["百里奚。", "五羊皮。", "忆别时。", "烹伏雌。", "炊扊扅。", "今日富贵忘我为。"], "annotations": []}, {"title": "琴歌", "paragraphs": ["百里奚。", "百里奚。", "母已死。", "葬南溪。", "坟以瓦。", "覆以柴。", "舂黄藜。", "扼伏鸡。", "西入秦。", "五羖皮。", "今日富贵捐我为。"], "annotations": []}, {"title": "赓歌", "paragraphs": ["股肱喜哉。", "元首起哉。", "百工熙哉。", "元首明哉。", "股肱良哉。", "庶事康哉。", "元首丛脞哉。", "股肱惰哉。", "万事堕哉。"], "annotations": []}, {"title": "越人歌", "paragraphs": ["今夕何夕兮搴洲中流。", "今日何日兮得与王子同舟。", "蒙羞被好兮不訾诟耻。", "心几烦而不绝兮得知王子。", "山有木兮木有枝。", "心说君兮君不知。"], "annotations": []}, {"title": "韩非子引古语", "paragraphs": ["奔车之上无仲尼。", "覆舟之下无伯夷。"], "annotations": []}, {"title": "韩非子引古谚", "paragraphs": ["为政若沐也。", "虽有弃发之费而有长发之利也。"], "annotations": []}, {"title": "韩非子引先圣谚", "paragraphs": ["不踬于山。", "而踬于垤。", "规有摩而水有波。", "我欲更之。", "无奈之何。"], "annotations": []}, {"title": "韩非子引鄙谚", "paragraphs": ["长袖善舞。", "多财善贾。", "莫众而迷。", "佣自卖。", "哀而不售。", "士自誉。", "辨而不信。"], "annotations": []}, {"title": "暇豫歌", "paragraphs": ["暇豫之吾吾不如鸟鸟。", "人皆集于菀。", "已独集于枯。"], "annotations": []}, {"title": "楚人为诸御己歌", "paragraphs": ["薪乎菜乎。", "无诸御己。", "讫无子乎。", "菜乎薪乎。", "无诸御己。", "讫无人乎。"], "annotations": []}, {"title": "楚人诵子文歌", "paragraphs": ["子文之族。", "犯国法程。", "廷理释之。", "子文不听。", "恤顾怨萌。", "方正公平。"], "annotations": []}, {"title": "楚人谣", "paragraphs": ["楚虽三户。", "亡秦必楚。"], "annotations": []}, {"title": "楚狂接舆歌", "paragraphs": ["凤兮凤兮何德之衰，往者不可谏。", "来者犹可追。", "已而已而。", "今之从政者殆而。"], "annotations": []}, {"title": "楚童谣", "paragraphs": ["楚王渡江得萍实。", "大如斗，赤如日。", "剖而食之甜如蜜。"], "annotations": []}, {"title": "楚聘歌", "paragraphs": ["大道隐兮礼为基。", "贤人窜兮将待时。", "天下如一兮欲何之。"], "annotations": []}, {"title": "鼓琴歌", "paragraphs": ["美人荧荧兮颜若苕之荣。", "命乎命乎。", "逢天时而生。", "曾无我嬴。"], "annotations": []}, {"title": "嘏辞", "paragraphs": ["皇尸命工祝。", "承致多福无疆。", "于女孝孙。", "来女孝孙。", "使女受禄于天。", "宜稼于田。", "眉寿万年。", "勿替引之。"], "annotations": []}, {"title": "慷慨歌", "paragraphs": ["贪吏而可为而不可为。", "廉吏而可为而不可为。", "贪吏而不可为者。", "当时有污名。", "而可为者。", "子孙以家成。", "廉吏而可为者当时有清名。", "而不可为者。", "子孙困穷被褐而负薪。", "贪吏常苦富。", "廉吏常苦贫。", "独不见楚相孙叔敖。", "廉洁不受钱。"], "annotations": []}, {"title": "穗歌", "paragraphs": ["穗乎不得获。", "秋风至兮殚零落。", "风雨之弗杀也。", "太上之靡弊也。"], "annotations": []}, {"title": "蟪蛄歌", "paragraphs": ["违山十里。", "蟪蛄之声。", "犹尚在耳。"], "annotations": []}, {"title": "击壤歌", "paragraphs": ["日出而作。", "日入而息。", "凿井而饮。", "耕田而食。", "帝力于我何有哉。"], "annotations": []}, {"title": "白云谣", "paragraphs": ["白云在天。", "山䧙自出。", "道里悠远。", "山川间之。", "将子无死。", "尚能复来。"], "annotations": []}, {"title": "卿云歌", "paragraphs": ["卿云烂兮。", "𫄙缦缦兮。", "日月光华。", "旦复旦兮。", "明明上天。", "烂然星陈。", "日月光华。", "弘于一人。", "日月有常。", "星辰有行。", "四时从经。", "万姓允诚。", "于予论乐。", "配天之灵。", "迁于贤圣。", "莫不咸听。", "鼚乎鼓之。", "轩乎舞之。", "精华已竭。", "褰裳去之。"], "annotations": []}, {"title": "康衢谣", "paragraphs": ["立我烝民。", "莫匪尔极。", "不识不知。", "顺帝之则。"], "annotations": []}, {"title": "蜡辞", "paragraphs": ["土反其宅。", "水归其壑。", "昆虫勿作。", "草木归其泽。"], "annotations": []}, {"title": "尧戒", "paragraphs": ["战战栗栗，日谨一日。", "人莫踬于山，而踬于垤。"], "annotations": []}, {"title": "夏后铸鼎繇", "paragraphs": ["逢逢白云，一南一北，一西一东。", "九鼎既成，迁于三国。"], "annotations": []}, {"title": "商铭", "paragraphs": ["嗛嗛之德，不足就也，不可以矜，而祗取忧也。", "嗛嗛之食，不足狃也，不能为膏，而祗离咎也。"], "annotations": []}, {"title": "盥盘铭", "paragraphs": ["与其溺于人也，宁溺于渊。", "溺于渊犹可游也，溺于人不可救也。"], "annotations": []}, {"title": "带铭", "paragraphs": ["火灭修容，慎戒必恭，恭则寿。"], "annotations": []}, {"title": "杖铭", "paragraphs": ["恶乎危，于忿懥。", "恶乎失道，于嗜欲。", "恶乎相忘，于富贵。"], "annotations": []}, {"title": "衣铭", "paragraphs": ["桑蚕苦，女工难，得新捐故后必寒。"], "annotations": []}, {"title": "笔铭", "paragraphs": ["豪毛茂茂，陷水可脱，陷文不活。"], "annotations": []}, {"title": "矛铭", "paragraphs": ["造矛造矛，少间弗忍，终身之羞。", "余一人所闻。", "以戒后世子孙。"], "annotations": []}, {"title": "书车", "paragraphs": ["出畏之，入惧之。"], "annotations": []}, {"title": "书户", "paragraphs": ["行必履正，无怀侥幸。"], "annotations": []}, {"title": "书砚", "paragraphs": ["石墨相著而黑，邪心谗言，无得污白。"], "annotations": []}, {"title": "书锋", "paragraphs": ["忍之须臾，乃全汝躯。"], "annotations": []}, {"title": "书杖", "paragraphs": ["辅人无苟，扶人无咎。"], "annotations": []}, {"title": "书井", "paragraphs": ["原泉滑滑，连旱则绝。", "取事有常，赋敛有节。"], "annotations": []}, {"title": "禹玉牒辞", "paragraphs": ["祝融司方发其英，沐日浴月百宝生。"], "annotations": []}, {"title": "采薇歌", "paragraphs": ["登彼西山兮采其薇矣。", "以暴易暴兮不知其非矣。", "神农虞夏忽焉没兮。", "我适归矣。", "吁嗟徂兮命之衰矣。"], "annotations": []}, {"title": "周秦民歌", "paragraphs": ["讴乎其已乎。", "苞乎其往归田成子乎。"], "annotations": []}, {"title": "暇豫歌", "paragraphs": ["暇豫之吾吾不如鸟乌。", "人皆集于菀。", "己独集于枯。"], "annotations": []}, {"title": "龙蛇歌", "paragraphs": ["有龙矫矫。", "顷失其所。", "一蛇从之。", "周流天下。", "龙反其渊。", "安宁其处。", "一蛇耆干。", "独不得其所。"], "annotations": []}, {"title": "楚狂接舆歌", "paragraphs": ["凤兮凤兮何德之衰也。", "来世不可待。", "往事不可追也。", "天下有道。", "圣人成焉。", "天下无道。", "圣人生焉。", "方今之时。", "仅免刑焉。", "福轻乎羽。", "莫之知载。", "祸重乎地。", "莫之知避。", "已乎已乎。", "临人以德。", "殆乎殆乎。", "画地而趋。", "迷阳迷阳。", "无伤吾行。", "吾行却曲。", "无伤吾足。"], "annotations": []}, {"title": "孺子歌", "paragraphs": ["沧浪之水清兮可以濯我缨。", "沧浪之水浊兮可以濯我足。"], "annotations": []}, {"title": "秦始皇时民歌", "paragraphs": ["生男慎勿举。", "生女哺用脯。", "不见长城下。", "尸骸相支拄。"], "annotations": []}, {"title": "穆天子谣", "paragraphs": ["予归东土。", "和治诸夏。", "万民平均。", "吾顾见女。", "比及三年。", "将复而野。"], "annotations": []}, {"title": "西王母吟", "paragraphs": ["徂彼西土。", "爰居其野。", "虎豹为群。", "于鹊与处。", "嘉命不迁。", "我惟帝女。", "彼何世民。", "又将去予。", "吹笙鼓簧。", "中心翱翔。", "世民之子。", "惟天之望。"], "annotations": []}, {"title": "周宣王时童谣", "paragraphs": ["檿弧箕服。", "实亡周国。"], "annotations": []}, {"title": "鸲鹆谣", "paragraphs": ["鸲之鹆之。", "公出辱之。", "鸲鹆之羽。", "公在外野。", "往馈之马。", "鸲鹆跦跦。", "公在干侯。", "征褰与襦。", "鸲鹆之巢。", "远哉遥遥。", "裯父丧劳。", "宋父以骄。", "鸲鹆鸲鹆。", "往歌来哭。"], "annotations": []}, {"title": "鲁童谣", "paragraphs": ["天将大雨。", "商羊鼓舞。"], "annotations": []}, {"title": "晋儿谣", "paragraphs": ["恭太子更葬兮后十四年晋亦不昌。", "昌乃在其兄。"], "annotations": []}, {"title": "赵民谣", "paragraphs": ["赵为号。", "秦为笑。", "以为不信。", "视地之生毛。"], "annotations": []}, {"title": "攻狄谣", "paragraphs": ["大冠若箕。", "修剑拄颐。", "攻狄不能下。", "垒于梧丘。"], "annotations": []}, {"title": "有炎氏颂", "paragraphs": ["听之不闻其声。", "视之不见其形。", "充满天地。", "苞裹六极。"], "annotations": []}, {"title": "舆人诵", "paragraphs": ["佞之见佞。", "果丧其田。", "诈之见诈。", "果丧其赂。", "得国而狃。", "终逢其咎。", "丧田不惩。", "祸乱其兴。"], "annotations": []}, {"title": "舆人诵", "paragraphs": ["原田每每。", "舍其旧而新是谋。"], "annotations": []}, {"title": "朱儒诵", "paragraphs": ["臧之狐裘。", "败我于狐骀。", "我君小子。", "朱儒是使。", "朱儒朱儒。", "使我败于邾。"], "annotations": []}, {"title": "子产诵", "paragraphs": ["取我衣冠而褚之。", "取我田畴而伍之。", "孰杀子产。", "我其与之。", "我有子弟。", "子产诲之。", "我有田畴。", "子产殖之。", "子产而死。", "谁其嗣之。"], "annotations": []}, {"title": "孔子诵", "paragraphs": ["麛裘而鞞。", "投之无戾。", "鞞之麛裘。", "投之无邮。", "衮衣章甫。", "实获我所。", "章甫衮衣。", "惠我无私。"], "annotations": []}, {"title": "齐人颂", "paragraphs": ["天口骈。", "谈天衍。", "雕龙奭。", "炙毂过髡。"], "annotations": []}, {"title": "童谣", "paragraphs": ["吴王出游观震湖。", "龙威丈人名隐居。", "北上包山入灵墟。", "乃造洞庭窃禹书。", "天帝大文不可舒。", "此文长传六百初。", "今强取出丧国庐。"], "annotations": []}, {"title": "泗上谣", "paragraphs": ["称乐太早绝鼎系。"], "annotations": []}, {"title": "秦人谣", "paragraphs": ["天帝醉秦暴。", "金误陨石坠。"], "annotations": []}, {"title": "秦世谣", "paragraphs": ["秦始皇。", "何彊梁。", "开吾户。", "据吾床。", "饮吾酒。", "唾吾浆。", "飧吾饭。", "以为粮。", "张吾弓。", "射东墙。", "前至沙丘当灭亡。"], "annotations": []}, {"title": "童谣", "paragraphs": ["阿房阿房亡始皇。"], "annotations": []}, {"title": "成王冠辞", "paragraphs": ["使王近于民。", "远于佞。", "近于义。", "啬于时。", "惠于财。", "亲贤使能。"], "annotations": []}, {"title": "士冠辞", "paragraphs": ["令月吉日。", "始加元服。", "弃尔幼志。", "顺尔成德。", "寿考惟祺。", "介尔景福。", "吉月令辰。", "乃申尔服。", "敬尔威仪。", "淑慎尔德。", "眉寿万年。", "永受胡福。", "以岁之正。", "以月之令。", "咸加尔服。", "兄弟具在。", "以成厥德。", "黄耇无疆。", "受天之庆。", "甘醴惟厚。", "嘉荐令芳。", "拜受祭之。", "以定尔祥。", "承天之休。", "寿考不忘。", "旨酒既清。", "嘉荐亶时。", "始加元服。", "兄弟具来。", "孝友时格。", "永乃保之。", "旨酒既湑。", "荐荐伊脯。", "乃申尔服。", "礼仪有序。", "祭此嘉爵。", "承天之祜。", "旨酒令芳。", "笾豆有楚。", "咸加尔服。", "肴升折俎。", "承天之庆。", "受福无疆。", "礼仪既备。", "令月吉日。", "昭告尔字。", "爰字孔嘉。", "髦士攸宜。", "宜之于假。", "永受保之。"], "annotations": []}, {"title": "禳田辞", "paragraphs": ["瓯窭满篝。", "污邪满车。", "五谷蕃熟。", "穰穰满家。"], "annotations": []}, {"title": "投壶辞", "paragraphs": ["有酒如淮。", "有肉如坻。", "寡君中此。", "为诸侯师。", "有酒如渑。", "有肉如陵。", "寡君中此。", "与君代兴。"], "annotations": []}, {"title": "为士卒倡", "paragraphs": ["无可往矣。", "宗庙亡矣。", "魂魄丧矣。", "归何党矣。"], "annotations": []}, {"title": "诗", "paragraphs": ["上天弗恤。", "夏命其卒。"], "annotations": []}, {"title": "【石鼓诗十首】 其一 车工·吾车篇", "paragraphs": ["?车既工。", "?马既同。", "?马既好。", "?马既?。", "君子员邋。", "员邋员斿。", "麀鹿速速。", "君子之求。", "??角弓。", "弓玆㠯寺。", "?驱其特。", "其来趩趩。", "????。", "即䢩即时。", "麀鹿??。", "其来大次。", "?驱其朴。", "其来䢱䢱。", "射其?蜀。"], "annotations": []}, {"title": "【石鼓诗十首】 其二 汧殹篇", "paragraphs": ["汧殹沔沔。", "丞丞皮淖渊。", "?鲤处之。", "君子渔之。", "𬇕又小鱼。", "其斿??。", "帛鱼皪皪。", "其?氐鲜。", "黄帛其?。", "又鳑又?。", "其?孔庶。", "脔之??。", "??□□。", "其鱼隹可。", "隹𫚈隹鲤。", "可㠯?之。", "隹杨及柳。"], "annotations": []}, {"title": "【石鼓诗十首】 其三 田车篇", "paragraphs": ["田车孔安。", "鋚勒??。", "四介既简。", "左骖幡幡。", "右骖𩨃𩨃。", "?㠯?于原。", "?戎止□。", "宫车其写。", "秀弓寺射。", "麋豕孔庶。", "麀鹿雉兔。", "其?又?。", "其□?夜。", "四出各亚。", "□□旲□。", "执而勿射。", "多庶䟏䟏。", "君子?乐。"], "annotations": []}, {"title": "【石鼓诗十首】 其四 銮车篇", "paragraphs": ["□□銮车。", "?□真□。", "□弓孔硕。", "彤矢□□。", "四马其写。", "六叀骜□。", "徒?孔庶。", "□□宣搏。", "眚车??。", "□徒如章。", "原湿阴阳。", "趍趍□马。", "射之□□。", "?□如虎。", "兽鹿如□。", "□□多贤。", "陈禽□□。", "?蒦允异。"], "annotations": []}, {"title": "【石鼓诗十首】 其五 灵雨篇", "paragraphs": ["□□□癸霝雨□□。", "流□滂滂。", "盈?济济。", "君子既涉。", "涉马□流。", "汧殹洎洎。", "□□□。", "舫舟西逮。", "□□自□。", "徒?汤汤。", "隹舟㠯?。", "或阴或阳。", "极深㠯□。", "□于水一方。", "勿□□止。", "其奔。", "其敔□□。", "□□其事。"], "annotations": []}, {"title": "【石鼓诗十首】 其六 作原篇", "paragraphs": ["□□□猷。", "乍原乍□。", "□□□。", "导遄我?□。", "□□□除。", "帅皮阪□。", "□□□草。", "为世里。", "□□□微。", "???罟。", "□□□栗。", "柞棫其□。", "□□棕?。", "祇祇鸣□。", "□□□□。", "亚箬其华。", "□□□□。", "为所斿?。", "□□□□。", "□〃盩导。", "二日尌□。", "□□□□五日。"], "annotations": []}, {"title": "【石鼓诗十首】 其七 而师篇", "paragraphs": ["□□□□□□□□□□而师。", "弓矢孔庶。", "□□□□□□□。", "㠯左骖□。", "□□滔滔。", "是□□□。", "□不具旧□。", "□复□□具来。", "□□其写。", "小大具□。", "□□来乐。", "天子□来。", "嗣王始□。", "古我来□。"], "annotations": []}, {"title": "【石鼓诗十首】 其八 马荐篇", "paragraphs": ["□□□天□虹□皮□□□走。", "䮺䮺马荐。", "□□䒖䒖。", "??雉血。", "□心其一。", "□□□□□□□□□□□□□□之。"], "annotations": []}, {"title": "【石鼓诗十首】 其九 吾水篇", "paragraphs": ["?水既净。", "?导既平。", "?□既止。", "嘉尌则里。", "天子永宁。", "日隹丙申。", "昱昱□□。", "?其□导。", "□马既陈。", "敖□康康。", "□驾□□。", "左骖□□。", "右□??。", "□□□□。", "母不□□。", "四翰??。", "□□公谓大□。", "金及如□□。", "害不余□。"], "annotations": []}, {"title": "【石鼓诗十首】 其十 吴人篇", "paragraphs": ["吴人怜亟。", "朝夕敬□。", "?西?北。", "勿?勿代。", "□而出□。", "□献用□。", "□□□□。", "□□大祝。", "曾受其?。", "□□□寓。", "逢中?孔□。", "麀鹿□□。", "?其□□。", "□𫟆𫟆。", "大□□□□□□求又□□□□□□□是。"], "annotations": []}, {"title": "书后赋诗", "paragraphs": ["宝珍隋珠。", "不知佩兮。", "袆衣与丝。", "不知异兮。", "闾姝子奢。", "莫之媒兮。", "嫫母求之。", "又甚喜之兮。", "以瞽为明。", "以聋为聪。", "以是为非。", "以吉为凶。", "呜呼上天。", "曷惟其中。"], "annotations": []}, {"title": "支诗", "paragraphs": ["天之所支。", "不可坏也。", "其所坏亦不可支也。"], "annotations": []}, {"title": "狸首诗", "paragraphs": ["曾孙侯氏。", "四正具举。", "大夫君子。", "凡以庶士。", "大小莫处。", "御于君所。", "以燕以射。", "则燕则誉。"], "annotations": []}, {"title": "狸首诗", "paragraphs": ["质参既设。", "执旌既载。", "干侯既抗。", "中获既置。", "弓既平张。", "四侯且良。", "决拾有常。", "既顺乃让。", "乃揖乃让。", "乃𬯀其堂。", "乃节其行。", "既志乃张。", "射夫命射。", "射者之声。", "御车之旌。", "既获卒莫。"], "annotations": []}, {"title": "黄竹诗", "paragraphs": ["我徂黄竹。", "□□□□。", "□员閟寒。", "帝收九行。", "嗟我公侯。", "百辟冢卿。", "皇我万民。", "旦夕勿忘。", "我徂黄竹。", "□□□□。", "□员閟寒。", "帝收九行。", "嗟我公侯。", "百辟冢卿。", "皇我万民。", "旦夕勿穷。", "有皎者鹭。", "翩翩其飞。", "嗟我公侯。", "□勿则迁。", "居乐甚寡。", "不如迁土。", "礼乐其民。"], "annotations": []}, {"title": "祈招诗", "paragraphs": ["祈招之愔愔。", "式昭德音。", "思我王度。", "式如玉。", "式如金。", "形民之力。", "而无醉饱之心。"], "annotations": []}, {"title": "招诗", "paragraphs": ["畜君何尤。"], "annotations": []}, {"title": "无射诗", "paragraphs": ["国诚宁矣。", "远人来观。", "修义经矣。", "好乐无荒。"], "annotations": []}, {"title": "辔之柔矣诗", "paragraphs": ["马之刚矣。", "辔之柔矣。", "马亦不刚。", "辔亦不柔。", "志气麃麃。", "取与不疑。"], "annotations": []}, {"title": "骊驹诗", "paragraphs": ["骊驹在门。", "仆夫俱存。", "骊驹在路。", "仆夫整驾。"], "annotations": []}, {"title": "诗", "paragraphs": ["大隧之中。", "其乐也融融。", "大隧之外。", "其乐也泄泄。"], "annotations": []}, {"title": "《左传》引逸诗", "paragraphs": ["翘翘车乘。", "招我以弓。", "岂不欲往。", "畏我友朋。", "我无所监。", "夏后及商。", "用乱之故。", "民卒流亡。", "俟河之清。", "人寿几何。", "兆云询多。", "职竞作罗。", "虽有丝麻。", "无弃管蒯。", "虽有姬姜。", "无弃蕉萃。", "凡百君子。", "莫不代匮。", "周道挺挺。", "我心扃扃。", "讲事不令。", "集人来定。", "礼义不愆。", "何恤于人言。", "淑慎尔止。", "无载尔伪。"], "annotations": []}, {"title": "《论语》引逸诗", "paragraphs": ["巧笑倩兮。", "美目盼兮。", "素以为绚兮。", "棠棣之华。", "偏其反而。", "岂不尔思。", "室是远而。"], "annotations": []}, {"title": "礼记引逸诗", "paragraphs": ["昔吾有先正。", "共言明且清。", "国家以宁。", "都邑以成。", "庶民以生。", "谁能秉国成。", "不自为政。", "卒劳百姓。", "相彼盍旦。", "尚犹患之。"], "annotations": []}, {"title": "《管子》引逸诗", "paragraphs": ["鸿鹄将将。"], "annotations": []}, {"title": "《墨子》引周诗", "paragraphs": ["王道荡荡。", "不偏不党。", "王道平平。", "不党不偏。"], "annotations": []}, {"title": "《墨子》引逸诗", "paragraphs": ["必择所堪。", "必谨所堪。", "鱼水不务。", "陆将何及。"], "annotations": []}, {"title": "《荀子》引逸诗", "paragraphs": ["如霜雪之将将。", "如日月之光明。", "国有大命。", "不可以告人。", "妨其躬身。", "凤凰秋秋。", "其翼若干。", "其声若箫。", "有凤有凰。", "乐帝之心。", "长夜慢兮。", "永思骞兮。", "太古之不慢兮。", "礼义之不愆兮。", "何恤人之言兮。", "涓涓源水。", "不壅不塞。", "毂既破碎。", "乃大其辐。", "事以败矣。", "乃重太息。", "墨以为明。", "狐狸而苍。"], "annotations": []}, {"title": "《列子》引逸诗", "paragraphs": ["良弓之子。", "必先为箕。", "良冶之子。", "必先为裘。"], "annotations": []}, {"title": "《庄子》引逸诗", "paragraphs": ["青青之麦。", "生于陵陂。", "生不布施。", "死何含珠为。"], "annotations": []}, {"title": "《吕氏春秋》引逸诗", "paragraphs": ["将欲毁之。", "必重累之。", "将欲踣之。", "必高举之。", "君君子则正。", "以行其德。", "君贱人则宽。", "以尽其力。", "唯则定国。"], "annotations": []}, {"title": "战国策引逸诗", "paragraphs": ["行百里者。", "半于九十。", "大武远宅不涉。", "木实繁者披其枝。", "披其枝者伤其心。", "大其都者危其君。", "尊其臣者卑其主。", "树德莫如滋。", "除害莫如尽。"], "annotations": []}, {"title": "《史记》引逸诗", "paragraphs": ["得人者与。", "失人者崩。"], "annotations": []}, {"title": "《汉书》引逸诗", "paragraphs": ["四牡翼翼。", "以征不服。", "亲省边陲。", "用事所极。", "九变复贯。", "知言之选。"], "annotations": []}, {"title": "《说苑》引逸诗", "paragraphs": ["绵绵之葛。", "在于旷野。", "良工得之。", "以为𫄨纻。", "良工不得。", "枯死于野。"], "annotations": []}, {"title": "《周礼》注引逸诗", "paragraphs": ["敕尔瞽。", "率尔众工。", "奏尔悲诵。", "肃肃雍雍。", "无怠无凶。"], "annotations": []}, {"title": "《晋书》引逸诗", "paragraphs": ["羽觞随波。"], "annotations": []}, {"title": "集韵引逸诗", "paragraphs": ["天下攘攘。", "皆为利往。", "天下熙熙。", "皆为利来。"], "annotations": []}, {"title": "《管子》引古言", "paragraphs": ["墙有耳。", "伏寇在侧。"], "annotations": []}, {"title": "《论语》引南人言", "paragraphs": ["人而无恒。", "不可以作巫医。"], "annotations": []}, {"title": "孔子《家语》引里语", "paragraphs": ["相马以舆。", "相士以居。"], "annotations": []}, {"title": "礼记引谚", "paragraphs": ["人莫知其子之恶。", "莫知其苗之硕。"], "annotations": []}, {"title": "礼记引南人言", "paragraphs": ["人而无恒。", "不可以为卜筮。"], "annotations": []}, {"title": "孟子引夏谚", "paragraphs": ["吾王不游。", "吾何以休。", "吾王不豫。", "吾何以助。", "一游一豫。", "为诸侯度。"], "annotations": []}, {"title": "孟子引齐人言", "paragraphs": ["虽有智慧。", "不如乘势。", "虽有镃基。", "不如待时。"], "annotations": []}, {"title": "《左传》引周谚", "paragraphs": ["山有木工则度之。", "宾有礼主则择之。", "匹夫无罪。", "怀璧其罪。"], "annotations": []}, {"title": "《左传》引谚", "paragraphs": ["心苟无瑕。", "何恤乎无家。", "辅车相倚。", "唇亡齿寒。", "高下在心。", "川泽纳污。", "山薮藏疾。", "瑾瑜匿瑕。", "国君含垢。", "民之多幸。", "国之不幸。", "非宅是卜。", "惟邻是卜。", "狼子野心。", "老将知而耄及之。", "臣一主二。", "无过乱门。", "室于怒市于色。", "唯食忘忧。", "民保于信。"], "annotations": []}, {"title": "《左传》引古人言", "paragraphs": ["心则不竞。", "何惮于病。", "畏首畏尾。", "身其馀几。", "虽鞭之长。", "不及马腹。", "杀老牛莫之敢尸。", "挈瓶之知。", "守不假器。", "鹿死不择音。"], "annotations": []}, {"title": "《左传》引上国言", "paragraphs": ["不索何获。"], "annotations": []}, {"title": "《墨子》引古语", "paragraphs": ["唇亡则齿寒。", "谋而不得。", "则以往知来。", "君子不镜于水而镜于人。", "镜于水见面之容。", "镜于人则知吉与凶。"], "annotations": []}, {"title": "《庄子》引野语", "paragraphs": ["闻道百以为莫已若。", "众人重利。", "廉士重名。", "贤士尚志。", "圣人贵精。"], "annotations": 