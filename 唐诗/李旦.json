{"dynasty": "唐", "author": "李旦", "author_desc": "", "works": [{"title": "戏题画", "paragraphs": ["唤出眼，何用苦深藏。", "缩却鼻，何畏不闻香。"], "annotations": []}, {"title": "石淙", "paragraphs": ["奇峰嶾嶙箕山北，秀崿岧峣嵩镇南。", "地首地肺何曾拟，天目天台倍觉惭。", "树影蒙茏鄣叠岫，波深汹涌落悬潭。", "□愿紫宸居得一，永欣丹扆御通三。"], "annotations": []}, {"title": "戏题画", "paragraphs": ["唤出眼，何用苦深藏。", "缩却鼻，何畏不闻香。"], "annotations": []}]}