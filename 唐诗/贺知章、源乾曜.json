{"dynasty": "唐", "author": "贺知章、源乾曜", "author_desc": "", "works": [{"title": "郊庙歌辞 禅社首乐章 太和", "paragraphs": ["肃我成命，于昭黄祇。", "裘冕而祀，陟降在斯。", "五音克备，八音聿施。", "缉熙肆靖，厥心匪离。"], "annotations": []}, {"title": "郊庙歌辞 禅社首乐章 肃和", "paragraphs": ["黄祇是[祗]，我其夙夜。", "寅畏诚絜，匪遑宁舍。", "礼以琮玉，荐厥茅藉。", "念兹降康，胡宁克暇。"], "annotations": []}, {"title": "郊庙歌辞 禅社首乐章 雍和", "paragraphs": ["夙夜宥密，不敢宁宴。", "五齐既陈，八音在县。", "粢盛以洁，房俎斯荐。", "惟德惟馨，尚兹克徧。"], "annotations": []}, {"title": "郊庙歌辞 禅社首乐章 太和", "paragraphs": ["昭昭有唐，天俾万国。", "列祖应命，四宗顺则。", "申锡无疆，宗我同德。", "曾孙继序，享神配极。"], "annotations": []}, {"title": "郊庙歌辞 禅社首乐章 灵具醉", "paragraphs": ["灵具醉，杳熙熙。", "灵将往，眇禗禗。", "顾明德，吐正辞。", "烂遗光，流祯祺。"], "annotations": []}]}