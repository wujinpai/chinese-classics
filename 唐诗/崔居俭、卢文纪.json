{"dynasty": "唐", "author": "崔居俭、卢文纪", "author_desc": "", "works": [{"title": "郊庙歌辞 后唐宗庙乐舞辞 昭德舞", "paragraphs": ["懿彼明德，赫赫煌煌。", "名高阃域，功著旗常。", "道符休泰，运叶祺祥。", "庆传万祀，以播耿光。"], "annotations": []}, {"title": "郊庙歌辞 后唐宗庙乐舞辞 文明舞", "paragraphs": ["帝业光扬，皇图翕赫。", "圣德孔彰，神功不测。", "信及豚鱼，恩沾动植。", "懿范鸿名，传之万亿。"], "annotations": []}, {"title": "郊庙歌辞 后唐宗庙乐舞辞 应天舞", "paragraphs": ["晋国肇兴，雄图再固。", "黼黻帝道，金玉王度。", "皇天无亲，惟德是辅。", "载诞英明，永光圣祚。"], "annotations": []}, {"title": "郊庙歌辞 后唐宗庙乐舞辞 永平舞", "paragraphs": ["庆传瓒祚，位正瑶图。", "功宣四海，化被八区。", "静彰帝道，动合干符。", "千秋万祀，永荷昭苏。"], "annotations": []}, {"title": "郊庙歌辞 后唐宗庙乐舞辞 武成舞", "paragraphs": ["艰难王业，返正皇唐。", "先天再造，却日重光。", "汉绍世祖，夏资少康。", "功成德茂，率祀无疆。"], "annotations": []}, {"title": "郊庙歌辞 后唐宗庙乐舞辞 雍煕舞", "paragraphs": ["仁君御宇，寰海谧清。", "运符武德，道协文明。", "九成式敍，百度惟贞。", "金门积庆，玉叶传荣。"], "annotations": []}]}