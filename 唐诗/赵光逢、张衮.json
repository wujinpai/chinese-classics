{"dynasty": "唐", "author": "赵光逢、张衮", "author_desc": "", "works": [{"title": "郊庙歌辞 梁郊祀乐章 庆和 一", "paragraphs": ["就阳位，升圆丘。", "佩双玉，御大裘。", "膺天命，拥神休。", "万灵感，百禄遒。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆平", "paragraphs": ["天命降鉴，帝德惟馨。", "享祀不忒，礼容孔明。", "奠璧布币，荐神献精。", "神佑以答，敷锡永宁。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆肃", "paragraphs": ["笾豆簠簋，黍稷非馨。", "懿兹彝器，厥德惟明。", "金石匏革，以和以平。", "繇此无体，期乎永宁。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆熙", "paragraphs": ["哲后躬享，旨酒斯陈。", "王恭无斁，严祀维夤。", "皇祖以配，大孝以振。", "宜锡景福，永休下民。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆融", "paragraphs": ["道和气兮袭氤氲，宣皇规兮彰圣神。", "服遐裔兮敷质文，格苗扈兮息烟尘。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆休", "paragraphs": ["大业来四夷，仁风和万国。", "白日体无私，皇天辅有德。", "七旬罪已服，六月师方克。", "伟哉帝道隆，终始常作则。"], "annotations": []}, {"title": "郊庙歌辞 梁郊祀乐章 庆和", "paragraphs": ["烟燎升，礼容彻。", "诚感达，人神悦。", "灵贶彰，圣情结。", "玉座寂，金炉歇。"], "annotations": []}]}