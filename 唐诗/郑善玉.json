{"dynasty": "唐", "author": "郑善玉", "author_desc": "郑善玉，开元时人。诗一首。", "works": [{"title": "郊庙歌辞 仪坤庙乐章 雍和", "paragraphs": ["酌郁既灌，芗萧方𦶟。", "笾豆静器，簠簋芬𫗣。", "鱼腊荐美，牲牷表洁。", "是戢是将，载迎载列。"], "annotations": []}, {"title": "仪坤庙乐章", "paragraphs": ["酌郁既灌，取萧方𦶟。", "笾豆静器，簠簋芬𫗣。", "鱼腊荐美，牲牷表絜。", "是戢是将，载迎载列。"], "annotations": []}]}