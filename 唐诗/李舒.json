{"dynasty": "唐", "author": "李舒", "author_desc": "", "works": [{"title": "郊庙歌辞 德明兴圣庙乐章 迎神", "paragraphs": ["元尊九德，佐尧光宅。", "烈祖太宗，方周作伯。", "响怀霜露，乐变金石。", "白云清风，髣髴来格。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 登歌奠币", "paragraphs": ["四时有典，百事来祭。", "尊祖奉宗，严禋大帝。", "礼先苍璧，奠币黝制。", "于斯万年，熙成帝系。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 迎俎", "paragraphs": ["盛牲实俎，涓选休成。", "鼎煁阳燧，玉盥阴精。", "有𫗣嘉豆，既和大羹。", "侑以清乐，细齐人情。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 德明酌献", "paragraphs": ["清庙奕奕，和乐雍雍。", "器尊牺象，礼属宗公。", "白水方祼，黄流在中。", "谟明之德，万古清风。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 兴圣酌献", "paragraphs": ["閟宫静谧，合乐周张。", "泰尊始献，百末重觞。", "震澹存诚，庶几迪尝。", "遥源之祚，天汉灵长。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 亚献终献", "paragraphs": ["惟清惟肃，靡闻靡见。", "举备九成，俛终三献。", "庆彰曼寿，胙彻嘉荐。", "瘗玉埋牲，礼神斯徧。"], "annotations": []}, {"title": "郊庙歌辞 德明兴圣庙乐章 送神", "paragraphs": ["元精回复，灵贶繁滋。", "风洒兰路，云摇桂旗。", "高丘缅邈，凉部逶迟。", "瞻望靡及，缠绵永思。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 迎神", "paragraphs": ["皇矣天宗，德先王季。", "因心则友，克让以位。", "爰命有司，式遵前志。", "神其降灵，昭飨祀事。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 奠币", "paragraphs": ["惟帝时若，去而上仙。", "祀用商舞，乐备宫悬。", "白璧加荐，玄𫄸告虔。", "子孙拜后，承兹吉蠲。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 迎俎", "paragraphs": ["祀盛体荐，礼协粢盛。", "方周假庙，用鲁纯牲。", "捧彻祗敬，击拊和鸣。", "受厘归胙，既戒而平。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 酌献", "paragraphs": ["八音具举，三寿既盥。", "洁兹宗彝，瑟彼圭瓒。", "兰肴重错，椒醑飘散。", "降胙维城，永为藩翰。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 亚献终献", "paragraphs": ["秩礼有序，和音既同。", "九仪不忒，三揖将终。", "孝感藩后，相维辟公。", "四时之典，永永无穷。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 送神", "paragraphs": ["奠献已事，昏昕载分。", "风摇雨散，灵卫𬘡缊。", "龙驾帝服，上腾五云。", "泮宫复閟，寂寞无闻。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 亚献终献", "paragraphs": ["秩礼有序，和音既同。", "九仪不忒，三揖将终。", "孝感藩后，相维辟公。", "四时之典，永永无穷。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 迎俎", "paragraphs": ["祀盛体荐，礼协粢盛。", "方周假庙，用鲁纯牲。", "捧彻祗敬，击拊和鸣。", "受厘归胙，既戒而平。"], "annotations": []}, {"title": "郊庙歌辞 让皇帝庙乐章 迎神", "paragraphs": ["皇矣天宗，德先王季。", "因心则友，克让以位。", "爰命有司，式遵前志。", "神其降灵，昭飨祀事。"], "annotations": []},