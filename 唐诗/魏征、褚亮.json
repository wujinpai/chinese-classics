{"dynasty": "唐", "author": "魏征、褚亮", "author_desc": "", "works": [{"title": "郊庙歌辞 享太庙乐章 长发舞", "paragraphs": ["睿哲维唐，长发其祥。", "帝命斯祐，王业克昌。", "配天载德，就日重光。", "本支百代，申锡无疆。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大基舞", "paragraphs": ["猗与祖业，皇矣帝先。", "翦商德厚，封唐庆延。", "在姬犹稷，方晋喻宣。", "基我鼎运，于万斯年。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大成舞", "paragraphs": ["周称王季，晋美帝文。", "明明盛德，穆穆齐芬。", "藏用四履，屈道三分。", "铿锵钟石，载纪鸿勋。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大明舞", "paragraphs": ["五纪更运，三正递升。", "勋华既没，禹汤勃兴。", "神武命代，灵睠是膺。", "望云彰德，察纬告征。", "上纽天维，下安地轴。", "征师涿野，万国咸服。", "偃伯灵台，九官允穆。", "殊域委賮，怀生介福。", "大礼既饰，大乐已和。", "黑章扰囿，赤字浮河。", "功宣载籍，德被咏歌。", "克昌厥后，百禄是荷。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 雍和", "paragraphs": ["於穆清庙，聿修严祀。", "四县载陈，三献斯止。", "笾豆彻荐，人祇介祉。", "神维格思，锡祚不已。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 永和", "paragraphs": ["肃肃清祀，烝烝孝思。", "荐享昭备，虔恭在兹。", "雍歌彻俎，祝嘏陈辞。", "用光武志，永固鸿基。"], "annotations": []}]}