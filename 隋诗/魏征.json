{"dynasty": "隋末唐初", "author": "魏征", "author_desc": "", "works": [{"title": "五郊乐章 舒和", "paragraphs": ["千里温风飘降羽，十枝炎景媵朱干。", "陈觞荐俎歌三献，拊石𪭢金会七盘。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 舒和", "paragraphs": ["圣敬通神光七庙，灵心荐祚和万方。", "严禋克配鸿基远，明德惟馨凤历昌。"], "annotations": []}, {"title": "五郊乐章 赤帝徵音 雍和", "paragraphs": ["昭昭丹陆，帟帟炎方。", "礼陈牲币，乐备篪簧。", "琼羞溢俎，玉?浮觞。", "恭惟正直，歆此馨香。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大成舞", "paragraphs": ["周穆王季，晋美帝文。", "明明盛德，穆穆齐芬。", "藏用四履，屈道参分。", "铿锵钟石，载纪鸿勋。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大明舞", "paragraphs": ["五纪更运，三正递升。", "勋华既没，禹汤勃兴。", "神武命代，灵眷是膺。", "望云彰德，察纬告征。", "上纽天维，下安地轴。", "征师涿野，万国咸服。", "偃伯灵台，九官允穆。", "殊域委赆，怀生介福。", "大礼既饰，大乐已和。", "黑章扰囿，赤字浮河。", "功宣载籍，德被咏歌。", "克昌厥后，百禄是荷。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 大基舞", "paragraphs": ["猗与祖业，皇矣帝先。", "剪商德厚，封唐庆延。", "在姬犹稷，方晋逾宣。", "基我鼎运，于斯万年。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 长发舞", "paragraphs": ["浚哲惟唐，长发其祥。", "帝命斯祐，王业克昌。", "配天载德，就日重光。", "本枝百代，申锡无疆。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 永和", "paragraphs": ["肃肃清祀，烝烝孝思。", "荐享昭备，虔恭在兹。", "雍歌撤俎，祝嘏陈辞。", "用光武志，永固鸿基。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 永和", "paragraphs": ["于穆烈祖，弘此丕基。", "永言配命，子孙保之。", "百神既洽，万国在兹。", "是用孝享，神其格思。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 寿和", "paragraphs": ["八音斯奏，三献毕陈。", "宝祚惟永，晖光日新。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 肃和", "paragraphs": ["大哉至德，允兹明圣。", "格于上下，聿遵诚敬。", "嘉乐斯登，鸣球以咏。", "神其降止，式隆景命。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 雍和", "paragraphs": ["崇兹享祀，诚敬兼至。", "乐以感灵，礼以昭事。", "粢盛咸絜，牲牷孔备。", "永言孝思，庶几不匮。"], "annotations": []}, {"title": "郊庙歌辞 享太庙乐章 雍和", "paragraphs": ["于穆清庙，聿修严祀。", "四县载陈，三献斯止。", "笾豆撤荐，人祗介祉。", "神惟格思，锡祚不已。"], "annotations": []}]}