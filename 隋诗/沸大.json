{"dynasty": "隋", "author": "沸大", "author_desc": "", "works": [{"title": "媱泆曲", "paragraphs": ["煌煌郁金。", "生于野田。", "过时不采。", "宛见弃捐。", "曼尔丰炽。", "华色惟新。", "与我同欢。"], "annotations": []}, {"title": "委靡辞", "paragraphs": ["宿心嘉尔，故固良媒。", "问名谐帅，占相良时。", "惨惨惕惕，惧尔不来。", "既睹尔颜，我心怡怡。", "今不合欢，岂徒费哉。", "斯誓为定，淑女何疑。"], "annotations": []}]}