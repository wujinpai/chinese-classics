{"dynasty": "明", "author": "朱右", "author_desc": "", "works": [{"title": "遗安轩杂咏", "paragraphs": ["林屋小如舟，老鹤长似人。", "昂藏立清晓，起舞玄羽新。", "高标凛寒骨，羁孤向霜晨。", "从来青田姿，蹁跹离风尘。", "俯首谢轩车，不与鸡鹜驯。"], "annotations": []}, {"title": "遣兴", "paragraphs": ["幽径何逼侧，蔓草没行路。", "此生苦不辰，出门畏多露。", "迟回蒙山居，仿像商颜步。", "藉藉春花萎，冉冉芳年度。", "寄语素心人，朱颜恐非故。"], "annotations": []}, {"title": "次韵答白云悦禅师", "paragraphs": ["向来同览赤城霞，山寺吟行石径斜。", "来往风流成二老，文章交好属通家。", "平安屡问东桥竹，寄远曾将小院花。", "支遁肯酬南坞约，相期岁晚度年华。"], "annotations": []}, {"title": "次刘伯温都事感兴", "paragraphs": ["大将宣威起执戈，功曹况复有萧何。", "共鸣鞞鼓来酣战，正拟前军奏凯歌。", "天外愁云连汴合，雨余腥水入淮多。", "平居殊觉成寥赖，静夜惊闻涕泗沱。"], "annotations": []}, {"title": "春怀", "paragraphs": ["舵楼空阔望京华，芦荻江枫岸岸花。", "山色淡浓昏雾薄，水光浮没夕阳斜。", "故乡鸿雁书千里，远浦牛羊屋数家。", "边塞柳营多苜蓿，石田徒忆旧桑麻。"], "annotations": []}, {"title": "次韵悦兑元见寄二首 其一", "paragraphs": ["逢人近问净天镜，今我重忆张贞居。", "曾将山渌开清昼，兼索溪藤写素书。"], "annotations": []}, {"title": "次韵悦兑元见寄二首 其二", "paragraphs": ["于越山中谢傅家，旧时池馆似东嘉。", "继公幽隐经行处，檐卜新开一树花。"], "annotations": []}, {"title": "广琴操十首 其一 将归操", "paragraphs": ["河之深兮，谁将厉之。", "河之浅兮，谁将揭之。", "河洋洋兮，不我济之。", "竭泽以渔兮，蛟龙辟之。", "覆巢夭胎兮，凤凰去之。", "夫人有知兮，予实类之。", "九州博大兮，将予遂之。"], "annotations": []}, {"title": "广琴操十首 其二 猗兰操", "paragraphs": ["习习谷风，以阴以雨。", "岩穴幽阻，谁其晤语。", "猗兰之芳，煜煜其光。", "不我佩服，昊天孔明。", "子如好修，维我之求。", "子如不好，于我何邮。"], "annotations": []}, {"title": "广琴操十首 其三 龟山操", "paragraphs": ["维龟有山，造初鸿蒙。", "自龟之东，淮夷来从。", "膏泽既施，草木实多。", "周公上天，奈龟山何。"], "annotations": []}, {"title": "广琴操十首 其四 越裳操", "paragraphs": ["天之聪兮，瞆瞆其音。", "天之明兮，窅窅其深。", "天之仁兮，实临下民。", "文王在上兮，于穆不已。", "浩浩其天兮，时旸时雨。", "越裳来臣兮，万物斯睹。"], "annotations": []}, {"title": "广琴操十首 其五 拘幽操", "paragraphs": ["羑之阴兮，罘罘。", "羑之室兮，幽幽。", "嗟室之人兮，为死为囚。", "匪维伊愆兮，实我之邮。", "日月有明兮，容光勿留。"], "annotations": []}, {"title": "广琴操十首 其六 岐山操", "paragraphs": ["自邰有家，于夏之先。", "克承勿怠，瓜瓞绵绵。", "开我邠宇，衍我宗禋。", "嗟狄之人，敢乘以奸。", "彼岨矣岐，将遂于迁。", "既有我土，勿戕我民。"], "annotations": []}, {"title": "广琴操十首 其七 履霜操", "paragraphs": ["驱车驱车，车行无迟。", "儿在中野，父宁不悲。", "驱车驱车，车行无违。", "儿当有母，孰使儿饥。", "天生众民，罔不同仁。", "风雨霜露，实活我人。", "民生有知，以顺天赋。"], "annotations": []}, {"title": "广琴操十首 其八 雉朝飞操", "paragraphs": ["雉于