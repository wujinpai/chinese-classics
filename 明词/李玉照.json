{"dynasty": "明末清初", "author": "李玉照", "author_desc": "", "works": [{"title": "渔歌子", "paragraphs": ["秋思萦怀懒赋诗。", "黄昏深院月来迟。", "人静处，漏残时。", "一片幽情祗自知。"], "annotations": []}, {"title": "忆王孙", "paragraphs": ["幽闺深闭日如年。", "临镜无心整翠钿。", "赢得愁肠两处牵。", "思淹淹。", "裙带闲拈花柳边。"], "annotations": []}, {"title": "如梦令 夜坐", "paragraphs": ["梦入愁乡初醒。", "犹有残灯相映。", "铁马寂无声，金鸭沉烟已烬。", "清冷。", "清冷。", "谁念绣衾孤另。"], "annotations": []}, {"title": "醉公子 忆梦中美人", "paragraphs": ["无意拈花片。", "有恨抛针线。", "细想梦中人。", "芳姿记未真。", "默坐还相忆。", "珠泪和香滴。", "月色到窗纱。", "寻思暗抵牙。"], "annotations": []}]}