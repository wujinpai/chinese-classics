{"dynasty": "明末清初", "author": "纪映淮", "author_desc": "", "works": [{"title": "小重山 秋闺", "paragraphs": ["萧瑟幽闺更漏长，庭前丛桂发、暗飘香。", "月明露白渐生凉，轻风起、时拂郁金裳。", "远雁一行行，相看还伫立、怯空房。", "幽怀几许总难量，兰缸灺、花影欲窥窗。"], "annotations": []}, {"title": "南歌子 秋思", "paragraphs": ["翠菊娇秋色，金蓉衬晚霞。", "倦来无力倚红纱。", "恨杀孤鸿一点、叫天涯。"], "annotations": []}, {"title": "桃源忆故人 暮春", "paragraphs": ["楼前花逐东风舞。", "惟有杨花堪妒。", "一味入帘穿户。", "不管愁人顾。", "枝头杜宇声偏苦。", "叫得斜阳欲暮。", "门外残红无数。", "零落横塘路。"], "annotations": []}, {"title": "醉桃源 早春", "paragraphs": ["疏帘不卷早春寒。", "残梅倚石栏。", "碧天无际路漫漫。", "孤云独去闲。", "丝添鬓，意阑珊。", "频将双泪弹。", "中庭明月又团团。", "愁人不要看。"], "annotations": []}, {"title": "鹧鸪天 有感", "paragraphs": ["落尽红香绿满枝。", "韶光如驶去难追。", "春归过去鹃啼血，小阁帘垂乳燕窥。", "情脉脉，意孜孜。", "无言常自费寻思。", "连天草色和烟碧，何事东风着意吹。"], "annotations": []}, {"title": "小重山 端午", "paragraphs": ["闲窗独坐病馀身。", "惊闻画鼓闹，在河津。", "始知节届佩符辰。", "彩丝系，输与少年人。", "一岁一番新。", "年光催短鬓。", "暗伤神。", "感时怀古欲沾巾。", "湘江渺，何处吊灵均。"], "annotations": []}, {"title": "传言玉女 咏残梅", "paragraphs": ["疏梅枝上，昨夜又经春雪。", "依依窗外，恰对人寥寂。", "冷淡孤芳，一种幽情殊绝。", "休吹长笛，好留馀馝。", "瘦影横斜，正冰蟾好时节。", "乱点苍苔，无奈东风劣。", "梦断高楼，有恨无言可说。", "早听帘际，莺调新舌。"], "annotations": []}]}