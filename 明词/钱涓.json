{"dynasty": "明", "author": "钱涓", "author_desc": "", "works": [{"title": "秋波媚 芙蓉", "paragraphs": ["艳质谁教托蓼洲，寂寞更谁俦。", "半竿落日，几行征雁，一叶归舟。", "那堪风雨频相妒，红粉逐波流。", "深深绮阁，盈盈罗帐，多少清愁。"], "annotations": []}, {"title": "相见欢 山园", "paragraphs": ["阶前云补苍苔。", "衬花开。", "窈窕朱阑碧户、似天台。", "山一带。", "水一派。", "足徘徊。", "满目画耶诗也、费安排。"], "annotations": []}, {"title": "菩萨蛮 蜂蝶", "paragraphs": ["窥红惹绿身儿小。", "飞飞惯入芳林扰。", "伊也点鸦黄。", "个兮浅淡妆。", "树头春意闹。", "翻逐邻家悄。", "风度远花香。", "知他飞那厢。"], "annotations": []}, {"title": "清平乐 腊梅", "paragraphs": ["峭寒方甚。", "蕊破枝头嫩。", "独喜傲霜无瘦损。", "另是一家风韵。", "游蜂酿蜜来赊。", "翻疑葛染成花。", "日映隔帘金碎，暗香透入窗纱。"], "annotations": []}]}