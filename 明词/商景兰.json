{"dynasty": "明末清初", "author": "商景兰", "author_desc": "", "works": [{"title": "捣练子 夜坐", "paragraphs": ["长相思，久离别。", "为谁憔悴凭谁说。", "卷帘贪看月明多，斜风恰打银釭灭。"], "annotations": []}, {"title": "如梦令 寓园有感", "paragraphs": ["此地春光如绣。", "画槛名花依旧。", "独立悄无言，梅比腰支还瘦。", "僝僽。", "僝僽。", "林外鸟声拖逗。"], "annotations": []}, {"title": "醉太平 春恨", "paragraphs": ["水绿山青。", "花飞柳轻。", "卷帘无事调筝。", "写愁肠意萦。", "情牵意萦。", "梦杳难成。", "香飘一片魂惊。", "见窗前月明。"], "annotations": []}, {"title": "生查子 春日晚妆", "paragraphs": ["无意整云钿，镜里双鸾去。", "百舌最无知，惯作深闺语。", "梁燕恰双飞，春色归何处。", "妆罢拂罗裳，一阵梨花雨。"], "annotations": []}, {"title": "点绛唇 春日游寓园", "paragraphs": ["春色溶溶，两堤杨柳舒金线。", "韶光如电。", "顷刻飞花片。", "金谷依然，景在人难见。", "闲游遍。", "深深庭院。", "半是蟏蛸罥。"], "annotations": []}, {"title": "菩萨蛮 忆外，代人作", "paragraphs": ["腊花香动烟中影。", "纱窗半掩罗帏冷。", "孤雁宿沙汀。", "寒砧梦里声。", "梦到相思地。", "难诉相思意。", "夜雨渡芭蕉。", "怀人正此宵。"], "annotations": []}, {"title": "忆秦娥 怀远，代人作", "paragraphs": ["清秋节。", "金风陡起悲离别。", "悲离别。", "长天月影，常圆常缺。", "空阶萧瑟声声叶。", "霜花点点肠千结。", "肠千结。", "云外翔鸿，梦中化蝶。"], "annotations": []}, {"title": "眼儿媚 怀远，代人作", "paragraphs": ["将入黄昏枕倍寒。", "银汉指阑干。", "半轮淡月，一行鸣雁，云老霜残。", "凭著飘英风自扫，小院掩双镮。", "离情难锁，迢迢江水，何处关山。"], "annotations": []}, {"title": "浪淘沙 秋兴", "paragraphs": ["窗外雨声催。", "烛尽香微。", "衾寒不耐五更鸡。", "无限相思魂梦里，带缓腰围。", "隙月到罗帏。", "孤雁南归。", "玉炉宝篆拂轻衣。", "花气参差帘影动，叶落梅肥。"], "annotations": []}, {"title": "临江仙  坐河边新楼", "paragraphs": ["水映玉楼楼上影，微风飘送蝉鸣。", "淡云流月小窗明。", "夜阑江上桨，远寺暮钟声。", "人倚阑干如画里，凉波渺渺堪惊。", "不知春色为谁增。", "湖光摇荡处，突兀众山横。"], "annotations": []}, {"title": "钗头凤 春游", "paragraphs": ["东风厚。", "花如剖。", "满园芳气长堤柳。", "莺身弱。", "浮云薄。", "韶光易老，春容零落。", "莫。", "莫。", "莫。", "梅空瘦。", "情难究。", "菌兰未放香先透。", "真珠箔。", "秋千索。", "沉沉亭院，相思难托。", "错。", "错。", "错。"], "annotations": []}, {"title": "渔家傲 雪景", "paragraphs": ["雪霰纷纷流竹路。", "数声乌鹊窗前度。", "一带寒光凝腊树。", "时如故。", "楼台倾刻成纨素。", "茅店布帘横古渡。", "寺钟戍鼓催天暮。", "驴背小桥栖白鹭。", "真堪赋。", "何如柳絮风中句。"], "annotations": []}, {"title": "醉春风 闺怨", "paragraphs": ["论愁肠如醉。", "写愁颜如睡。", "银釭冉冉影随身，畏。", "畏。", "畏。", "半帘明月，一庭花气，时光容易。", "无数衾边泪。", "难向天涯会。", "夜寒故故启离情，碎。", "碎。", "碎。", "梦中细语，为谁分诉，何如不寐。"], "annotations": []}, {"title": "青玉案 即席赋赠友言别", "paragraphs": ["一帘萧飒梧桐雨。", "秋色与人归去。", "花底双樽留薄暮。", "云深千里，雁来寒度。", "客有愁无数。", "片帆明日东皋路。", "送别恨重重烟树。", "越水吴山知何处。", "舞移灯影，筝调弦柱。", "且尽杯中趣。"], "annotations": []}, {"title": "十六字令 怀远，代人作", "paragraphs": ["瓜。", "今岁须教早吐花。", "圆如月，郎马定归家。"], "annotations": []}, {"title": "忆秦娥 忆外，代人作", "paragraphs": ["寒夜冷。", "终日离愁如断梗。", "如断梗。", "日久春长，银瓶落井。", "落梧惊梦凭谁醒。", "窗前窗后花枝影。", "花枝影。", "玉漏催残，孤灯半隐。"], "annotations": []}, {"title": "长相思 暮归", "paragraphs": ["过桥西。", "花满堤。", "步印香泥小径归。", "烟笼万户低。", "月初辉。", "星渐稀。", "光到窗前知未知。", "何处夜乌啼。"], "annotations": []}, {"title": "长相思 赋惜花春起早", "paragraphs": ["月刚斜。", "日影些。", "一路香风绕碧纱。", "忙忙贴鬓花。", "冷莓■。", "遍地遮。", "满院春情委露华。", "枝头宿鸟喳。"], "annotations": []}, {"title": "春光好 代姊别妹", "paragraphs": ["枫树冷，菊花黄。", "伴行妆。", "画舫归途十里塘。", "为谁忙。", "烟水萍丝荇菜，沙汀㶉𫛶鸳鸯。", "多少离情此际有，待佳章。"], "annotations": []}, {"title": "浣溪沙 送女归，代人作", "paragraphs": ["唱罢骊驹神暗伤。", "阑干小月印虚堂。", "花枝影度隔帘香。", "人去空留千里梦，寒深午夜怯银床。", "独留灯烬照荒凉。"], "annotations": []}, {"title": "忆秦娥 怀远，代人作", "paragraphs": ["云将暮。", "寒砧声送愁无数。", "愁无数。", "孤鸿只影，极天难诉。", "片帆不返金陵渡。", "相思难道相思路。", "相思路。", "千里风尘，一帘霜露。"], "annotations": []}, {"title": "如梦令 怀远，代人作", "paragraphs": ["寂寞寒深孤枕。", "风度罗帏梦醒。", "梦醒却无情，此际离愁漫整。", "夜冷。", "夜冷。", "花动闲窗月影。"], "annotations": []}, {"title": "长相思 即事", "paragraphs": ["水绕溪。", "花满堤。", "鹦鹉声高烟柳迷。", "愁多恨鸟啼。", "香霏霏。", "泪凄凄。", "坐看西山虹影低。", "诗成雪乱飞。"], "annotations": []}, {"title": "长相思 即事", "paragraphs": ["花影圆。", "月正妍。", "隔林啼鸟夜声传。", "相看情倍牵。", "整翠钿。", "拂朱弦。", "熏尽罗帏未肯眠。", "庭前霜满天。"], "annotations": []}, {"title": "长相思 春景", "paragraphs": ["芳草齐。", "鹧鸪啼。", "满院花光傍竹篱。", "行行日已西。", "柳条长，宝马嘶。", "问尔王孙归未归。", "楼高望转迟。"], "annotations": []}, {"title": "捣练子 秋思", "paragraphs": ["风草草，露浓浓。", "筑起愁城几万重。", "黄叶满庭人未扫，一声哀雁五云中。"], "annotations": []}, {"title": "少年游 冬景", "paragraphs": ["梅头未绽，朔风如历，白雪暗飞香。", "轻寒到枕，愁肠顿起，小胆怯空房。", "满天云气，一炉烟烬，迢递此韶光。", "高唐路杳，楚台无梦，何处写鸳鸯。"], "annotations": []}, {"title": "上西楼 夜阑闻雨", "paragraphs": ["江城云暗星稀。", "鸟孤飞。", "帘外绿残红瘦、漏声催。", "正风雨。", "凄凉处。", "烛花微。", "警醒梦魂时节、卷罗帏。"], "annotations": []}, {"title": "点绛唇 暮景", "paragraphs": ["时候黄昏，兰房独坐愁多少。", "寒云缥缈。", "深把梅枝绕。", "海月初升，远寺钟声早。", "炉烟袅。", "离情未了。", "步即兰灺小。"], "annotations": []}, {"title": "探春令 暮归", "paragraphs": ["斜阳远树晚鸦栖，薄暮愁云闭。", "又朔风、吹入孤舟里。", "荡双桡月浮江碎，过沙汀三四。", "看渔灯、隐隐芦苇岸，一派腊深天气。"], "annotations": []}, {"title": "长相思 春游，代人作", "paragraphs": ["思悠悠。", "恨悠悠。", "懒整残妆独倚楼。", "寒光动玉钩。", "星也愁。", "月也愁。", "不耐孤衾拥碧秋。", "离怀未肯休。"], "annotations": []}, {"title": "思帝乡 闺怨", "paragraphs": ["鸳帐冷，烛光浮。", "帐冷光浮梦短，思悠悠。", "添得满腔憔悴，满身愁。", "纵到花间月底，意难留。"], "annotations": []}, {"title": "忆秦娥 雪景", "paragraphs": ["彤云恶。", "六花片片穿帘幕。", "穿帘幕。", "鸟栖深树，人登高阁。", "茫茫无际愁烟薄。", "玉龙盐虎添萧索。", "添萧索。", "一天飞影，半林松鹤。"], "annotations": []}, {"title": "忆秦娥 雪中别谷虚大师", "paragraphs": ["空留恋。", "杨花袅袅随风战。", "随风战。", "弥天道远，流光如箭。", "冰壶夜月凝光殿。", "朔风减碎鹅毛片。", "鹅毛片。", "飞翔莫定，何时相见。"], "annotations": []}, {"title": "忆王孙 雪夜即事", "paragraphs": ["凄风夜夜打空林。", "金锁烟寒上绣衾。", "春滞莺黄未敢鸣。", "倍多情。", "寄恨鹍丝三两声。"], "annotations": []}, {"title": "浣溪沙 初春夜坐", "paragraphs": ["玉漏频催夜气清。", "篆烟深锁绣帏轻。", "满庭明月照残更。", "雁柱十三空寄恨，关河百二总离情。", "春恨何事巧相侵。"], "annotations": []}, {"title": "醉花间 春恨", "paragraphs": ["愁离别。", "偏离别。", "别恨多周折。", "无计解离情，独倚天边月。", "窗外子规啼，正与春风杂。", "问鸟语花光，何时皆愁绝。"], "annotations": []}, {"title": "长相思 雪中作。寄宝姑娘", "paragraphs": ["梅蕊青。", "雪花萦。", "雪重梅寒万里平。", "微风窗纸声。", "问卿卿。", "定有情。", "篆冷香消却怎生。", "同心两地明。"], "annotations": []}, {"title": "诉衷情 雪中怀女僧谷虚", "paragraphs": ["无端小立琐窗前。", "飞絮影连天。", "蒲团雪深三尺，参透几多禅。", "花欲绽，鸟犹寒。", "孰相怜。", "歌翻白雪，笛弄梅花，两鬓霜添。"], "annotations": []}, {"title": "捣练子 春日舟中见月", "paragraphs": ["烟漠漠，路茫茫。", "桃李无言万树芳。", "百啭黄莺催日暮，白云深处透微光。"], "annotations": []}, {"title": "春光好 坐河边新楼", "paragraphs": ["山色秀，水纹清。", "落花轻。", "沙上鸳鸯泛绿汀。", "棹归声。", "小鸟如啼如话，春光乍雨乍晴。", "一派霞光催日暮，月东升。"], "annotations": []}, {"title": "菩萨蛮 坐河边新楼，代人作", "paragraphs": ["画楼槛外啼黄鸟。", "山光横断残阳渺。", "春色杳难留。", "衔杯花下愁。", "绣窗笼晓日。", "紫燕穿帘急。", "柳拂水痕清。", "渔歌渡远汀。"], "annotations": []}, {"title": "菩萨蛮 坐河边新楼，代人作", "paragraphs": ["春光难驻伤心色。", "远山暮影烟如织。", "花气傍高楼。", "游人在上头。", "闲倚阑干敞。", "湖水平如掌。", "浪影乱晴空。", "渔舟荡晚风。"], "annotations": []}, {"title": "海棠春 赠侄女吴子", "paragraphs": ["绿窗春透垂杨影。", "更多少、月明风冷。", "花枝黄鸟声，绣阁酣初醒。", "被底鸳鸯，阶前白璧。", "都是欢时美景。", "惭愧白头人，空叹时如锦。"], "annotations": []}, {"title": "更漏子 闺中四景词 春", "paragraphs": ["艳阳天，流水曲。", "处处莺啼柳绿。", "初睡足，晓妆迟。", "帘开燕子飞。", "桃如火，梅如豆。", "添得玉颜消瘦。", "眉淡淡，鬓星星。", "王孙草正青。"], "annotations": []}, {"title": "更漏子 闺中四景词 夏", "paragraphs": ["湘帘外，池水侧。", "双燕风前归急。", "移玉簟，弄双纨。", "黄梅雨正翻。", "薰风起，芙蓉乱。", "叶底鸳鸯寻伴。", "一队队，一双双。", "联翩宿野塘。"], "annotations": []}, {"title": "海棠春 闺中四景词 秋", "paragraphs": ["西风萧瑟梧桐老。", "闻处处、寒砧夜捣。", "罗袂拂霜轻，雾髻侵云袅。", "绿窗声送孤鸿早。", "纨扇上、离愁多少。", "月下桂香浮，限煞秋光好。"], "annotations": []}, {"title": "海棠春 闺中四景词 冬", "paragraphs": ["朔风剪出鹅毛片。", "柳絮与、梅花相见。", "木落万山空，正大江如练。", "红炉拨尽寒犹战。", "况夜夜、玉壶添箭。", "耐得岁寒心，又苦桃花面。"], "annotations": []}, {"title": "卜算子 初春游寓山看花", "paragraphs": ["春半绿茵齐，处处香风透。", "满目青山点翠苔，景色依然秀。", "尽道柳丝黄，不解梅花瘦。", "回首莺啼深树时，正是秋千候。"], "annotations": []}, {"title": "忆秦娥 初春剩国忆子", "paragraphs": ["莺声咽。", "柳梢烟雨梅梢月。", "梅梢月。", "谁家玉笛，十分凄切。", "迢迢子去伤离别。", "空亭寂寞愁心结。", "愁心结。", "梨花飞碎，香飘尘绝。"], "annotations": []}, {"title": "洞天春 初春同友坐剩国书屋", "paragraphs": ["黄鹂槛外声小。", "曲径残梅未扫。", "淑气含春遍芳草。", "正晴光缭绕。", "闲庭竟日悄悄。", "无奈佳人去早。", "蛱蝶轻飞，风飘花乱，新愁多少。"], "annotations": []}, {"title": "卜算子 春日寓山看花", "paragraphs": ["烟暖碧云楼，楼迥春山秀。", "风落残红水面飘，池内清波皱。", "柳外小莺啼，花鸟声相斗。", "唤起当年万种愁，泪湿青衫袖。"], "annotations": []}, {"title": "临江仙 题牡丹", "paragraphs": ["锦树一阑无气力，随风婀娜枝头。", "艳阳却被夕阳收。", "春光有恨，待欲控双钩。", "香入美人销不尽，依然别样娇羞。", "太真西子并风流。", "小窗倚遍，明月更相留。"], "annotations": []}, {"title": "烛影摇红 咏鵻堂怀旧", "paragraphs": ["春入华堂，玉阶草色重重暗。", "寒波一片映阑干，望处如银汉。", "风动花枝深浅。", "忽思量、时光如箭。", "歌声撩乱。", "环佩叮当，繁华未断。", "游赏池台，沧桑顷刻风云换。", "中宵笳角恼人肠，泣向庭闱远。", "何处堪留顾盼。", "更可怜、子规啼遍。", "满壁图书，一枝残蜡，几声长叹。"], "annotations": []}, {"title": "捣练子 留别", "paragraphs": ["人去也，情难舍。", "花枝吹散风潇洒。", "霜天宿鸟静无声，流苏锦帐含愁下。"], "annotations": []}]}