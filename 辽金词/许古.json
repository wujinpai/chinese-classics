{"dynasty": "金", "author": "许古", "author_desc": "", "works": [{"title": "行香子", "paragraphs": ["秋入鸣皋。", "爽气飘萧。", "挂衣冠、初脱尘劳。", "窗间岩岫，看尽昏朝。", "夜山低，晴山近，晓山高。", "细数闲来。", "几处村醪。", "醉模糊、信手挥毫。", "等闲陶写，问恁风骚。", "乐因循，能潦倒，也消摇。"], "annotations": []}, {"title": "眼儿媚", "paragraphs": ["浊醪𥬠得玉为浆。", "风韵带橙香。", "持杯笑道，鹅黄似酒，酒似鹅黄。", "世缘老矣不思量，沈醉又何妨。", "临风对月，山歌野调，尽我疏狂。"], "annotations": []}]}